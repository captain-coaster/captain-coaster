{#
  Reviews block — Coaster/show.
  - myReview set  → "Mon avis" highlighted first + 4 community + "Tous les avis →"
  - myReview null → CTA pleine largeur en bas (seulement si canWrite) + 5 community + "Tous les avis →"
  - canWrite: bool — true seulement si ridden
#}
{% set canWrite = canWrite|default(false) %}

<section class="rounded-2xl bg-surface-sunken overflow-hidden">

  {# Header #}
  <div class="px-5 pt-4 pb-3 flex items-center justify-between">
    <h2 class="text-base font-semibold text-content flex items-center gap-2">
      {{ ux_icon('tabler:quote', {'class': 'w-5 h-5 text-cc-blue-500', 'aria-hidden': 'true'}) }}
      Avis
      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-cc-blue-100 text-cc-blue-800 dark:bg-cc-blue-900/20 dark:text-cc-blue-400">183</span>
    </h2>
    <a href="#" class="text-sm text-cc-blue-600 dark:text-cc-blue-400 font-medium hover:underline">
      Tous les avis →
    </a>
  </div>

  {# Carrousel #}
  <div class="overflow-x-auto">
    <div class="flex gap-3 px-5 pb-4 pt-1 snap-x snap-mandatory">

      {# Mon avis — highlighted, first in carousel #}
      {% if myReview %}
        <article class="flex-none w-72 snap-start rounded-2xl bg-white dark:bg-neutral-700/50 p-3 ring-2 ring-cc-blue-400 dark:ring-cc-blue-500">
          <div class="flex items-center gap-2.5 mb-2">
            <div class="shrink-0 w-8 h-8 rounded-full bg-cc-blue-500 text-white flex items-center justify-center text-xs font-bold">M</div>
            <div class="min-w-0 flex-1">
              <div class="font-semibold text-sm text-content truncate flex items-center gap-1.5">
                {{ myReview.user.name }}
                <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[10px] font-bold bg-cc-blue-500 text-white">TOI</span>
              </div>
              <div class="text-xs text-content-muted">{{ myReview.updatedAt|date('d M Y') }}</div>
            </div>
            <div class="shrink-0 flex items-center gap-1">
              {{ ux_icon('tabler:star-filled', {'class': 'w-4 h-4 text-cc-warm-500', 'aria-hidden': 'true'}) }}
              <span class="text-sm font-bold text-content">{{ myReview.value }}</span>
            </div>
          </div>

          <p class="text-xs text-content-secondary leading-relaxed mb-2 line-clamp-4">{{ myReview.review }}</p>

          {% if myReview.pros|length > 0 %}
            <div class="flex flex-wrap gap-1 mb-2">
              {% for pro in myReview.pros %}
                <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded-full text-xs font-medium bg-green-100 dark:bg-green-900/20 text-green-700 dark:text-green-400">
                  {{ ux_icon('tabler:thumb-up', {'class': 'w-3 h-3', 'aria-hidden': 'true'}) }}
                  {{ pro }}
                </span>
              {% endfor %}
            </div>
          {% endif %}

          <div class="flex items-center justify-between text-xs text-neutral-400 mt-2">
            {# Only action: Modifier #}
            <a href="#" class="text-cc-blue-600 dark:text-cc-blue-400 font-medium hover:underline">Modifier</a>
            <span class="inline-flex items-center gap-1">
              <span>{{ myReview.upvotes }}</span>
              {{ ux_icon('tabler:heart', {'class': 'w-3 h-3', 'aria-hidden': 'true'}) }}
            </span>
          </div>
        </article>
      {% endif %}

      {# Community reviews #}
      {% set max = myReview ? 4 : 5 %}
      {% for review in reviews|slice(0, max) %}
        <article class="flex-none w-72 snap-start rounded-2xl bg-white dark:bg-neutral-700/50 p-3">
          <div class="flex items-center gap-2.5 mb-2">
            <div class="shrink-0 w-8 h-8 rounded-full bg-neutral-200 dark:bg-neutral-600 flex items-center justify-center text-xs font-medium text-neutral-700 dark:text-neutral-200">
              {{ review.user.name|first }}
            </div>
            <div class="min-w-0 flex-1">
              <div class="font-semibold text-sm text-content truncate">{{ review.user.name }}</div>
              <div class="text-xs text-content-muted">{{ review.updatedAt|date('d M Y') }}</div>
            </div>
            <div class="shrink-0 flex items-center gap-1">
              {{ ux_icon('tabler:star-filled', {'class': 'w-4 h-4 text-cc-warm-500', 'aria-hidden': 'true'}) }}
              <span class="text-sm font-bold text-content">{{ review.value }}</span>
            </div>
          </div>

          <p class="text-xs text-content-secondary leading-relaxed mb-2 line-clamp-4">{{ review.review }}</p>

          {% if review.pros|length > 0 or review.cons|length > 0 %}
            <div class="flex flex-wrap gap-1 mb-2">
              {% for pro in review.pros %}
                <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded-full text-xs font-medium bg-green-100 dark:bg-green-900/20 text-green-700 dark:text-green-400">
                  {{ ux_icon('tabler:thumb-up', {'class': 'w-3 h-3', 'aria-hidden': 'true'}) }}
                  {{ pro }}
                </span>
              {% endfor %}
              {% for con in review.cons %}
                <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded-full text-xs font-medium bg-red-100 dark:bg-red-900/20 text-red-700 dark:text-red-400">
                  {{ ux_icon('tabler:thumb-down', {'class': 'w-3 h-3', 'aria-hidden': 'true'}) }}
                  {{ con }}
                </span>
              {% endfor %}
            </div>
          {% endif %}

          <div class="flex items-center justify-end text-xs text-neutral-400">
            <span class="inline-flex items-center gap-1">
              <span>{{ review.upvotes }}</span>
              {{ ux_icon('tabler:heart', {'class': 'w-3 h-3', 'aria-hidden': 'true'}) }}
            </span>
          </div>
        </article>
      {% endfor %}

    </div>
  </div>

  {# CTA écrire un avis — seulement si pas d'avis perso ET ridden #}
  {% if not myReview and canWrite %}
    <div class="px-5 pb-4">
      <a href="#" class="block w-full text-center px-4 py-3 rounded-xl bg-cc-blue-50 dark:bg-cc-blue-900/20 border border-cc-blue-200 dark:border-cc-blue-800 text-cc-blue-700 dark:text-cc-blue-300 text-sm font-semibold hover:bg-cc-blue-100 dark:hover:bg-cc-blue-900/30 transition-colors">
        {{ ux_icon('tabler:pencil', {'class': 'w-4 h-4 inline mr-1', 'aria-hidden': 'true'}) }}
        Partage ton avis sur ce coaster
      </a>
    </div>
  {% endif %}

</section>
