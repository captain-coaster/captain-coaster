{#
  Mockup widget — pure UI, no controllers wired.

  Parameters:
    - state:   'anonymous' | 'unknown' | 'wishlist' | 'ridden' | 'rated'
    - rating:  array|null (fake data)
    - variant: 'full' (coaster/show) | 'compact' (park/mes coasters)
#}
{% set variant   = variant|default('full') %}
{% set isAnon    = state == 'anonymous' %}
{% set isRidden  = state in ['ridden', 'rated'] %}
{% set isRated   = state == 'rated' %}
{% set isWish    = state == 'wishlist' %}
{% set hasReride = isRidden and rating is not null and rating.rideCount is defined and rating.rideCount > 1 %}

{# ══════════════════════════════════════════════════════════════════════════ #}
{# FULL variant — Coaster/show                                               #}
{# ══════════════════════════════════════════════════════════════════════════ #}
{% if variant == 'full' %}

  {# ── 2 gros boutons ──────────────────────────────────────────────────── #}
  <div class="grid grid-cols-2 gap-3 px-5 pt-5 pb-4">

    {# Bouton gauche : Ridé #}
    {% if isAnon %}
      <a href="#"
         class="flex items-center justify-center gap-2 px-4 py-3.5 rounded-2xl border-2 border-line-strong text-content-subtle text-sm font-semibold opacity-60">
        {{ ux_icon('tabler:circle-check', {'class': 'w-5 h-5', 'aria-hidden': 'true'}) }}
        Ridden
      </a>
    {% elseif isRidden %}
      <button type="button"
              class="flex items-center justify-center gap-2 px-4 py-3.5 rounded-2xl border-2 border-green-500 bg-green-500 text-white text-sm font-semibold hover:bg-green-600 hover:border-green-600 transition-colors shadow-sm shadow-green-500/20">
        {{ ux_icon('tabler:circle-check-filled', {'class': 'w-5 h-5', 'aria-hidden': 'true'}) }}
        Ridden
      </button>
    {% else %}
      <button type="button"
              class="flex items-center justify-center gap-2 px-4 py-3.5 rounded-2xl border-2 border-line-input text-neutral-700 dark:text-neutral-200 text-sm font-semibold hover:border-green-400 hover:text-green-700 hover:bg-green-50 dark:hover:border-green-600 dark:hover:text-green-400 dark:hover:bg-green-900/20 transition-colors">
        {{ ux_icon('tabler:circle-check', {'class': 'w-5 h-5', 'aria-hidden': 'true'}) }}
        Ridden
      </button>
    {% endif %}

    {# Bouton droit : Wishlist (si pas ridden) | +1 ride (si ridden) #}
    {% if isAnon %}
      <a href="#"
         class="flex items-center justify-center gap-2 px-4 py-3.5 rounded-2xl border-2 border-line-strong text-content-subtle text-sm font-semibold opacity-60">
        {{ ux_icon('tabler:bookmark', {'class': 'w-5 h-5', 'aria-hidden': 'true'}) }}
        Wishlist
      </a>
    {% elseif isRidden %}
      <button type="button"
              class="flex items-center justify-center gap-2 px-4 py-3.5 rounded-2xl border-2 border-cc-warm-400 bg-cc-warm-400 text-white text-sm font-semibold hover:bg-cc-warm-500 hover:border-cc-warm-500 transition-colors shadow-sm shadow-cc-warm-400/20">
        {{ ux_icon('tabler:refresh', {'class': 'w-5 h-5', 'aria-hidden': 'true'}) }}
        +1 ride
      </button>
    {% elseif isWish %}
      <button type="button"
              class="flex items-center justify-center gap-2 px-4 py-3.5 rounded-2xl border-2 border-pink-500 bg-pink-500 text-white text-sm font-semibold hover:bg-pink-600 hover:border-pink-600 transition-colors shadow-sm shadow-pink-500/20">
        {{ ux_icon('tabler:bookmark-filled', {'class': 'w-5 h-5', 'aria-hidden': 'true'}) }}
        Wishlist
      </button>
    {% else %}
      <button type="button"
              class="flex items-center justify-center gap-2 px-4 py-3.5 rounded-2xl border-2 border-line-input text-neutral-700 dark:text-neutral-200 text-sm font-semibold hover:border-pink-400 hover:text-pink-700 hover:bg-pink-50 dark:hover:border-pink-600 dark:hover:text-pink-400 dark:hover:bg-pink-900/20 transition-colors">
        {{ ux_icon('tabler:bookmark', {'class': 'w-5 h-5', 'aria-hidden': 'true'}) }}
        Wishlist
      </button>
    {% endif %}

  </div>

  {# ── Dates — sous les boutons, si ridden ─────────────────────────────── #}
  {% if isRidden %}
    <div class="px-5 pb-4 space-y-1.5 border-t border-line-strong pt-3">

      {# Premier ride — date cliquable pour modifier #}
      <div class="flex items-center gap-2 text-xs text-content-muted">
        {{ ux_icon('tabler:calendar', {'class': 'w-3.5 h-3.5 text-cc-blue-400 shrink-0', 'aria-hidden': 'true'}) }}
        <span>Premier ride ·
          <button type="button" class="font-medium text-neutral-800 dark:text-neutral-100 underline decoration-dotted underline-offset-2 hover:text-cc-blue-600 dark:hover:text-cc-blue-400 transition-colors">
            {{ rating.firstRiddenAt ?? 'Aujourd\'hui' }}
          </button>
        </span>
        {# Clear date #}
        <button type="button" class="ml-auto p-0.5 rounded text-neutral-300 hover:text-red-400 transition-colors" title="Effacer la date">
          {{ ux_icon('tabler:x', {'class': 'w-3 h-3', 'aria-hidden': 'true'}) }}
        </button>
      </div>

      {# Re-rides — seulement si rideCount > 1 #}
      {% if hasReride %}
        <div class="flex items-center gap-2 text-xs text-content-muted">
          {{ ux_icon('tabler:refresh', {'class': 'w-3.5 h-3.5 text-cc-warm-400 shrink-0', 'aria-hidden': 'true'}) }}
          <span>
            <span class="font-medium text-neutral-800 dark:text-neutral-100">{{ rating.rideCount }} rides</span>
            · dernier le
            <button type="button" class="font-medium text-neutral-800 dark:text-neutral-100 underline decoration-dotted underline-offset-2 hover:text-cc-blue-600 dark:hover:text-cc-blue-400 transition-colors">
              {{ rating.lastRiddenAt ?? '8 mai 2026' }}
            </button>
          </span>
        </div>
      {% endif %}

    </div>
  {% endif %}

  {# ── Note — 5 étoiles + croix ────────────────────────────────────────── #}
  <div class="px-5 pb-5 border-t border-line-strong pt-4">
    <div class="flex items-center gap-2">
      {# Étoiles pleine largeur #}
      <div class="flex items-center gap-1 flex-1">
        {% for i in 1..5 %}
          {% set val = rating.value ?? null %}
          {% if val is null or val < i - 0.5 %}
            {{ ux_icon('tabler:star', {'class': 'w-10 h-10 sm:w-12 sm:h-12 text-neutral-300 dark:text-neutral-600', 'aria-hidden': 'true'}) }}
          {% elseif val < i %}
            {{ ux_icon('tabler:star-half-filled', {'class': 'w-10 h-10 sm:w-12 sm:h-12 text-cc-warm-400', 'aria-hidden': 'true'}) }}
          {% else %}
            {{ ux_icon('tabler:star-filled', {'class': 'w-10 h-10 sm:w-12 sm:h-12 text-cc-warm-400', 'aria-hidden': 'true'}) }}
          {% endif %}
        {% endfor %}
      </div>
      {# Croix suppression note — seulement si noté #}
      {% if isRated %}
        <button type="button"
                class="shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-neutral-400 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors"
                aria-label="Supprimer ma note"
                title="Supprimer ma note (le ride reste)">
          {{ ux_icon('tabler:x', {'class': 'w-4 h-4', 'aria-hidden': 'true'}) }}
        </button>
      {% endif %}
    </div>

    {# Hint contextuel #}
    {% if not isRated and not isAnon %}
      <p class="mt-2 text-xs text-content-subtle">
        {% if isRidden %}
          Tape sur une étoile pour noter.
        {% else %}
          Tape sur une étoile — ça marquera aussi ce coaster comme ridden.
        {% endif %}
      </p>
    {% endif %}

    {# Anonyme : lien login #}
    {% if isAnon %}
      <p class="mt-3 text-xs text-center text-content-muted">
        <a href="#" class="text-cc-blue-600 dark:text-cc-blue-400 font-medium hover:underline">Log in</a>
        or
        <a href="#" class="text-cc-blue-600 dark:text-cc-blue-400 font-medium hover:underline">create an account</a>
        to track your rides.
      </p>
    {% endif %}
  </div>

{# ══════════════════════════════════════════════════════════════════════════ #}
{# COMPACT variant — Park/show + Mes coasters                                #}
{# Layout : étoiles sur leur propre ligne, croix juste à droite             #}
{# ══════════════════════════════════════════════════════════════════════════ #}
{% else %}

  <div class="flex items-center gap-1 mt-1.5">
    {# Étoiles — plus grosses que l'ancienne version #}
    {% for i in 1..5 %}
      {% set val = rating.value ?? null %}
      {% if val is null or val < i - 0.5 %}
        {{ ux_icon('tabler:star', {'class': 'w-5 h-5 text-neutral-300 dark:text-neutral-600', 'aria-hidden': 'true'}) }}
      {% elseif val < i %}
        {{ ux_icon('tabler:star-half-filled', {'class': 'w-5 h-5 text-cc-warm-400', 'aria-hidden': 'true'}) }}
      {% else %}
        {{ ux_icon('tabler:star-filled', {'class': 'w-5 h-5 text-cc-warm-400', 'aria-hidden': 'true'}) }}
      {% endif %}
    {% endfor %}
    {# Croix juste après les étoiles — pas à l'extrême droite #}
    {% if isRated %}
      <button type="button"
              class="ml-1 p-0.5 rounded text-neutral-400 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors"
              title="Supprimer la note">
        {{ ux_icon('tabler:x', {'class': 'w-3.5 h-3.5', 'aria-hidden': 'true'}) }}
      </button>
    {% elseif isRidden %}
      <span class="ml-1 text-[10px] text-neutral-400">Tap pour noter</span>
    {% endif %}
  </div>

{% endif %}
