{#
  Single rating row — shared between Profile/ratings and User/list_ratings.

  Behaviour adapts automatically to the viewer:
    - Owner: interactive star widget + delete button.
    - Other users: read-only widget, no delete (handled by security voters).

  Parameters:
    - rating: RiddenCoaster entity (required)
#}

<div class="rating-row bg-surface rounded-xl border border-line hover:border-line-strong transition-colors"
     id="tr-coaster-{{ rating.coaster.id }}"
     data-rating-row>

  <div class="flex items-center gap-3 px-3 py-2.5">

    {# Thumbnail — fixed 48×36 #}
    <a href="{{ path('show_coaster', {'id': rating.coaster.id, 'slug': rating.coaster.slug}) }}"
       class="shrink-0" tabindex="-1" aria-hidden="true">
      {% if rating.coaster.mainImage is not null %}
        <img src="{{ pictures_cdn }}/280x210/{{ rating.coaster.mainImage.filename }}"
             class="w-12 h-9 rounded-lg object-cover"
             alt="{{ rating.coaster.name }}"
             loading="lazy">
      {% else %}
        <div class="w-12 h-9 rounded-lg bg-surface-muted flex items-center justify-center">
          {{ ux_icon('tabler:roller-skating', {'class': 'w-4 h-4 text-neutral-400', 'aria-hidden': 'true'}) }}
        </div>
      {% endif %}
    </a>

    {# Coaster info — flex-1, three lines max #}
    <div class="flex-1 min-w-0">
      <a href="{{ path('show_coaster', {'id': rating.coaster.id, 'slug': rating.coaster.slug}) }}"
         class="font-medium text-sm text-content hover:text-cc-blue-600 dark:hover:text-cc-blue-400 transition-colors leading-snug block truncate">
        {{ rating.coaster.name }}
      </a>
      <div class="flex items-center gap-1 mt-0.5">
        <span class="inline-block w-1.5 h-1.5 rounded-full shrink-0 bg-{{ rating.coaster.status.color ?? 'neutral' }}-400"
              title="{{ rating.coaster.status.name|trans([], 'database') }}"></span>
        <span class="text-xs text-content-muted truncate">{{ rating.coaster.park.name }}</span>
      </div>
      {% if rating.firstRiddenAt %}
        <div class="text-[10px] text-content-subtle mt-0.5 flex items-center gap-0.5">
          {{ ux_icon('tabler:calendar', {'class': 'w-3 h-3 shrink-0', 'aria-hidden': 'true'}) }}
          {{ rating.firstRiddenAt|date('d/m/Y') }}
        </div>
      {% endif %}
    </div>

    {# Right column: stars row + delete icon #}
    <div class="shrink-0 flex flex-col items-end gap-1.5">
      {# Stars widget — interactive for owner, read-only otherwise #}
      <twig:StarRating
        :value="rating.rating ?? null"
        :size="20"
        mode="standalone"
        :coasterId="rating.coaster.id"
        :ratingId="rating.id"
        :readonly="not is_granted('update', rating)"
      />

      {# Delete button — only for owner #}
      {% if is_granted('delete', rating) %}
        <div data-controller="csrf-protection rating-row"
             data-csrf-protection-token-value="{{ csrf_token('rating') }}"
             data-rating-row-csrf-protection-outlet=".csrf-protection"
             data-rating-row-rating-id-value="{{ rating.id }}"
             data-rating-row-locale-value="{{ app.request.locale }}"
             data-rating-row-mode-value="table"
             data-rating-row-confirm-text-value="{{ 'rating.confirm_delete'|trans }}">
          <button data-action="click->rating-row#delete"
                  data-rating-row-target="deleteButton"
                  class="p-1 rounded-md text-neutral-400 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors"
                  aria-label="{{ 'rating.delete'|trans }}">
            {{ ux_icon('tabler:trash', {'class': 'w-4 h-4', 'aria-hidden': 'true'}) }}
          </button>
        </div>
      {% endif %}
    </div>

  </div>
</div>
