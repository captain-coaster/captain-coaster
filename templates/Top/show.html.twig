{% extends "base.html.twig" %}

{% import "helper.html.twig" as helper %}

{% set title = top.name %}
{% set subTitle = top.user.displayName %}
{% set parentUrl = path('user_show', {'slug': top.user.slug}) %}
{% set subTitleUrl = parentUrl %}
{% block title %}{{ title }} • {{ subTitle }}{% endblock %}

{% block body %}
  <div class="cc-panel cc-panel--white cc-panel--flat">
    <div class="cc-panel__heading">
      <div class="grid grid-cols-12 gap-5">
        <div class="col-span-12 md:col-span-8">
          <ul class="list-inline m-0">
            <li>{{ ux_icon('lucide:layers', {'class': 'w-4 h-4 position-left'}) }} {{ top.topCoasters|length }}</li>
            <li>
              {{ ux_icon('lucide:user', {'class': 'w-4 h-4 position-left'}) }}
              <a href="{{ path('user_show', {'slug': top.user.slug}) }}">{{ top.user.displayName }}</a>
            </li>
            <li>
              {{ ux_icon('lucide:clock', {'class': 'w-4 h-4 position-left'}) }}
              {{ 'list.updated'|trans({}, 'top') }} {{ top.updatedAt|ago }}
            </li>
          </ul>
        </div>
        {% if is_granted('edit', top) or is_granted('edit-details', top) or is_granted('delete', top) %}
          <div class="col-span-12 md:col-span-4 text-right">
            {% if is_granted('edit', top) %}
              <a href="{{ path('top_edit', {'id': top.id}) }}" class="cc-button bg-primary-400 cc-button--sm" aria-label="{{ 'update'|trans({}, 'top') }}">
                {{ ux_icon('lucide:pencil', {'class': 'w-3.5 h-3.5'}) }}
              </a>
            {% endif %}
            {% if is_granted('edit-details', top) %}
              <a href="{{ path('top_edit_details', {'id': top.id}) }}" class="cc-button bg-primary-400 cc-button--sm" aria-label="{{ 'update_details'|trans({}, 'top') }}">
                {{ ux_icon('lucide:settings', {'class': 'w-3.5 h-3.5'}) }}
              </a>
            {% endif %}
            {% if is_granted('delete', top) %}
              <a href="{{ path('top_delete', {'id': top.id}) }}"
                 onclick="return confirm('{{ 'delete_confirmation'|trans({}, 'top') }}');"
                 class="cc-button bg-danger-400 cc-button--sm"
                 aria-label="{{ 'delete'|trans({}, 'top') }}">
                {{ ux_icon('lucide:trash-2', {'class': 'w-3.5 h-3.5'}) }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>

    <ul class="cc-media-list">
      {% for topCoaster in top.topCoasters %}
        {% set coaster = topCoaster.coaster %}
        <li class="cc-media cc-panel__body cc-media--stack-mobile">
          <div class="cc-media__start">
            <a href="{{ path('show_coaster', {'id': coaster.id, 'slug': coaster.slug}) }}">
              {% if coaster.mainImage is not null %}
                {# 4:3 shape at this width, unlike the square thumbnails elsewhere. #}
                {{ helper.picture(coaster.mainImage.filename, 96, 72, coaster.name, 'img-rounded', 'lazy', 'width:96px;') }}
              {% endif %}
            </a>
          </div>

          <div class="cc-media__body">
            <h2 class="cc-media__heading text-semibold">
              <a class="text-ink" href="{{ path('show_coaster', {'id': coaster.id, 'slug': coaster.slug}) }}">
                {{ topCoaster.position }}&nbsp;-&nbsp;{{ coaster.name }}
              </a>
            </h2>

            <ul class="list-inline list-inline-separate text-muted mb-2.5">
              {% if coaster.manufacturer %}
                <li>
                  <a class="text-muted" href="{{ path('ranking_index', {'filters[manufacturer]': coaster.manufacturer.id}) }}">
                    {{ coaster.manufacturer.name }}
                  </a>

                </li>
              {% endif %}
              <li>
                <a class="text-muted" href="{{ path('park_show', {'id': coaster.park.id, 'slug': coaster.park.slug}) }}">
                  {{ coaster.park.name }}, {{ coaster.park.country.name|trans([], 'database') }}
                </a>
              </li>
            </ul>
          </div>
        </li>
      {% endfor %}
    </ul>
  </div>

{% endblock %}
