{% extends 'base.html.twig' %}

{% if create == true %}
  {% set title = 'new.title'|trans({}, 'top') %}
  {% set submitLabel = 'new.form.submit'|trans({}, 'top') %}
{% else %}
  {% set title = 'edit_details.title'|trans({}, 'top') %}
  {% set submitLabel = 'edit_details.form.submit'|trans({}, 'top') %}
{% endif %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
  {{ form_start(form, {attr: {class: 'grid max-w-160 gap-6'}}) }}
    {{ form_errors(form) }}
    {{ form_row(form.name) }}
    {{ form_row(form.type) }}
    {{ form_rest(form) }}
    <div>
      <twig:Button block>{{ submitLabel }}</twig:Button>
    </div>
  {{ form_end(form) }}
{% endblock %}
