{% extends "layouts/base.html.twig" %}

{% set titleText = top.isCustom
  ? top.name
  : (top.isRanking ? 'type.ranking'|trans({}, 'top') : 'type.bucket'|trans({}, 'top')) %}
{% block title %}{{ titleText }}{% endblock %}

{% block body %}
  <twig:PageHeader
    title="{{ titleText }}"
    subtitle="{{ 'list.by'|trans({}, 'top') }} {{ top.user.displayName }}"
  />

  {# Meta + actions row — type pill, visibility / feeds-ranking caption, save status, Done. #}
  <div class="flex items-center flex-wrap gap-2 mb-5">
    <twig:TopTypeBadge :top="top" size="xs" short="true" />
    {% if top.isCustom %}
      <form method="post" action="{{ path('top_visibility', {'id': top.id}) }}" class="inline">
        <input type="hidden" name="_token" value="{{ csrf_token('top_visibility' ~ top.id) }}">
        <button type="submit"
                class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium transition-colors
                  {{ top.isPublic
                     ? 'bg-surface-muted text-content-tertiary hover:bg-neutral-200 dark:hover:bg-neutral-700'
                     : 'bg-cc-warm-100 text-cc-warm-700 dark:bg-cc-warm-900/30 dark:text-cc-warm-400 hover:bg-cc-warm-200 dark:hover:bg-cc-warm-900/50' }}"
                title="{{ 'editor.visibility.title'|trans({}, 'top') }}">
          {{ ux_icon(top.isPublic ? 'tabler:world' : 'tabler:lock', {'class': 'w-3 h-3', 'aria-hidden': 'true'}) }}
          {{ (top.isPublic ? 'editor.visibility.public' : 'editor.visibility.private')|trans({}, 'top') }}
        </button>
      </form>
    {% elseif top.isRanking %}
      <span class="text-[11px] text-content-muted inline-flex items-center gap-1"
            title="{{ 'show.feeds_rankings.tooltip'|trans({}, 'top') }}">
        {{ ux_icon('tabler:info-circle', {'class': 'w-3 h-3', 'aria-hidden': 'true'}) }}
        {{ 'show.feeds_rankings.label'|trans({}, 'top') }}
      </span>
    {% endif %}

    <span class="ml-auto"></span>

    <a href="{{ path('top_show', {'id': top.id}) }}"
       class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium rounded-lg bg-cc-blue-600 text-white hover:bg-cc-blue-700 transition-colors">
      {{ ux_icon('tabler:check', {'class': 'w-4 h-4', 'aria-hidden': 'true'}) }}
      {{ 'editor.done'|trans({}, 'top') }}
    </a>
  </div>

  {# Inline rename row — only for custom lists (their name is editable). #}
  {% if top.isCustom %}
    <form method="post" action="{{ path('top_rename', {'id': top.id}) }}"
          class="flex items-center gap-2 mb-4">
      <input type="hidden" name="_token" value="{{ csrf_token('top_rename' ~ top.id) }}">
      <div class="relative flex-1">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          {{ ux_icon('tabler:edit', {'class': 'w-4 h-4 text-neutral-400', 'aria-hidden': 'true'}) }}
        </div>
        <input type="text" name="name" value="{{ top.name }}" required maxlength="255"
               class="block w-full pl-9 pr-3 py-2.5 rounded-xl border border-line-strong bg-surface text-sm text-content placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-cc-blue-500/50 focus:border-cc-blue-500 transition-all"
               aria-label="{{ 'editor.rename'|trans({}, 'top') }}"
               placeholder="{{ 'editor.rename'|trans({}, 'top') }}">
      </div>
      <button type="submit"
              class="shrink-0 inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium rounded-lg bg-surface border border-line text-content hover:bg-surface-muted transition-colors">
        {{ ux_icon('tabler:device-floppy', {'class': 'w-4 h-4', 'aria-hidden': 'true'}) }}
        {{ 'editor.rename_save'|trans({}, 'top') }}
      </button>
    </form>
  {% endif %}

  {# TopListEditor — Live Component handles search + list + mutations #}
  {{ component('TopListEditor', {topId: top.id, locale: app.request.locale}) }}

  {# Delete (subtle, end of page — custom lists only). #}
  {% if is_granted('delete', top) %}
    <div class="mt-8 flex justify-center">
      <form method="post" action="{{ path('top_delete', {'id': top.id}) }}"
            onsubmit="return confirm('{{ 'delete_confirmation'|trans({}, 'top') }}');">
        <input type="hidden" name="_token" value="{{ csrf_token('top_delete' ~ top.id) }}">
        <button type="submit"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg transition-colors">
          {{ ux_icon('tabler:trash', {'class': 'w-3.5 h-3.5', 'aria-hidden': 'true'}) }}
          {{ 'delete'|trans({}, 'top') }}
        </button>
      </form>
    </div>
  {% endif %}

{% endblock %}
