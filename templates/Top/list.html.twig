{% extends "base.html.twig" %}


{% set title = 'list.title'|trans({}, 'top') %}
{% block title %}{{ title }}{% endblock %}

{% block body %}
  <div class="grid grid-cols-12 gap-5">
    {% for top in tops %}
      <div class="col-span-12 md:col-span-6 xl:col-span-4">
        <div class="cc-card">
          <div class="cc-card__caption">
            <div class="content-group-sm cc-media">
              <div class="cc-media__start">
                <twig:Avatar :user="top.user" decorative/>
              </div>
              <div class="cc-media__body">
                <h6 class="text-semibold m-0">
                  {% if top.main %}{{ ux_icon('lucide:check', {'class': 'w-4 h-4 text-size-mini position-left'}) }}{% endif %}
                  <a href="{{ path('top_show', {'id': top.id}) }}" class="text-default">
                    {{ top.name }}
                  </a>
                </h6>
                <small class="text-muted">
                  {{ 'list.by'|trans({}, 'top') }}
                  <a href="{{ path('user_show', {'slug': top.user.slug}) }}">
                    {{ top.user.displayName }}
                  </a>
                </small>
              </div>
            </div>
            <ul class="list-feed">
              {% for topCoaster in top.topCoasters|slice(0,3) %}
                <li>
                  {{ topCoaster.position }} -
                    <a href="{{ path('show_coaster', {'id': topCoaster.coaster.id, 'slug': topCoaster.coaster.slug}) }}"
                     class="text-default">
                    {{ topCoaster.coaster.name }}
                  </a>
                </li>
              {% endfor %}
            </ul>
            <div class="mt-[5px]">
              <a href="{{ path('top_show', {'id': top.id}) }}">
                {{ ux_icon('lucide:circle-arrow-right', {'class': 'w-4 h-4'}) }} {{ 'list.more'|trans({}, 'top') }}
              </a>
            </div>
            <ul class="list-inline mt-[5px]">
              <li>{{ ux_icon('lucide:layers', {'class': 'w-4 h-4 position-left'}) }} {{ top.topCoasters|length }}</li>
              <li>
                {{ ux_icon('lucide:clock', {'class': 'w-4 h-4 position-left'}) }} {{ 'list.updated'|trans({}, 'top') }} {{ top.updatedAt|ago }}
              </li>
            </ul>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
  {{ knp_pagination_render(tops) }}
{% endblock %}
