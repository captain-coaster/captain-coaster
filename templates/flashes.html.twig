{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label|default('info') }} alert-styled-left alert-arrow-left alert-bordered" data-controller="alert">
            <button type="button" class="close" data-action="click->alert#close"><span>×</span><span class="sr-only">Close</span></button>
            {{ message }}
        </div>
    {% endfor %}
{% endfor %}