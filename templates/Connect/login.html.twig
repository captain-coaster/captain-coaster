{% extends "layouts/base_auth.html.twig" %}

{% set pageTitle = 'page_title'|trans({}, 'login') %}
{% block title %}{{ pageTitle }}{% endblock %}

{# ── Background image ──────────────────────────────────────────────────────── #}
{% block auth_background %}
    {% if bgCoaster is not null and bgCoaster.mainImage is not null %}
        <img src="{{ pictures_cdn }}/1440x1440/{{ bgCoaster.mainImage.filename }}"
             class="absolute inset-0 w-full h-full object-cover"
             alt="{{ bgCoaster.name }}"
             loading="eager">
    {% else %}
        <div class="absolute inset-0 bg-gradient-to-br from-cc-blue-600 via-cc-blue-500 to-cc-warm-500"></div>
    {% endif %}
{% endblock %}

{# ── Attribution overlay (above scrim) ─────────────────────────────────────── #}
{% block auth_overlay %}
    {% if bgCoaster is not null %}
        <p class="absolute bottom-2 right-3 text-white/40 text-[10px] select-none">
            {{ bgCoaster.name }}{% if bgCoaster.park %} · {{ bgCoaster.park.name }}{% endif %}
        </p>
    {% endif %}
{% endblock %}

{# ── Card ──────────────────────────────────────────────────────────────────── #}
{% block body %}
<div data-controller="auth-steps"
     data-auth-steps-initial-step-value="{{ initialStep }}">

    {# Glass card #}
    <div class="bg-white/[0.11] backdrop-blur-2xl border border-white/[0.22] rounded-[18px] overflow-hidden">
        <div class="p-6">

            {# Security error (from firewall — e.g. Google OAuth failure).
               Keys like login.authentication_failed live in the security domain — keep that domain here. #}
            {% if error %}
                <div class="mb-4 p-3 rounded-xl bg-red-500/20 border border-red-400/30" role="alert">
                    <p class="text-sm text-red-200">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
                </div>
            {% endif %}

            {# Flash messages #}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-4 p-3 rounded-xl {% if label == 'success' %}bg-green-500/20 border border-green-400/30{% else %}bg-amber-500/20 border border-amber-400/30{% endif %}" role="alert">
                        <p class="text-sm {% if label == 'success' %}text-green-200{% else %}text-amber-200{% endif %}">{{ message|raw }}</p>
                    </div>
                {% endfor %}
            {% endfor %}

            {# Step indicator dots #}
            <div class="flex items-center gap-2 mb-5">
                <div data-auth-steps-target="dot1" class="h-2 transition-all duration-300"></div>
                <div data-auth-steps-target="dot2" class="h-2 transition-all duration-300"></div>
                <div data-auth-steps-target="dot3" class="h-2 transition-all duration-300"></div>
            </div>

            {# ── State 1: Email entry ──────────────────────────────────────── #}
            <div data-auth-steps-target="step1">
                <h2 class="text-lg font-bold text-white mb-1">{{ 'welcome.heading'|trans({}, 'login') }}</h2>
                <p class="text-sm text-white/65 mb-5">{{ 'welcome.subtext'|trans({}, 'login') }}</p>

                <form action="{{ path('login') }}" method="POST" class="space-y-4">
                    <input type="hidden" name="_step" value="email">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('login_action') }}">

                    <div>
                        <label for="email" class="block text-xs font-semibold text-white/75 mb-1.5">
                            {{ 'welcome.email_label'|trans({}, 'login') }}
                        </label>
                        <input type="email"
                               id="email"
                               name="email"
                               class="block w-full px-3.5 py-2.5 rounded-xl border border-white/26 bg-white/10 text-white placeholder:text-white/38 focus:outline-none focus:ring-2 focus:ring-cc-blue-400 focus:border-transparent transition-all text-sm"
                               placeholder="{{ 'welcome.email_placeholder'|trans({}, 'login') }}"
                               required
                               autocomplete="email">
                    </div>

                    <button type="submit"
                            class="w-full flex justify-center items-center gap-2 px-4 py-2.5 text-sm font-semibold rounded-xl text-white bg-cc-blue-600 hover:bg-cc-blue-700 focus:outline-none focus:ring-2 focus:ring-cc-blue-400 shadow-lg shadow-cc-blue-500/25 transition-all duration-200">
                        {{ 'welcome.cta'|trans({}, 'login') }}
                        {{ ux_icon('tabler:arrow-right', {'class': 'w-4 h-4', 'aria-hidden': 'true'}) }}
                    </button>
                </form>

                <div class="relative my-5">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-white/20"></div>
                    </div>
                    <div class="relative flex justify-center">
                        <span class="px-3 text-xs text-white/50 bg-transparent">{{ 'welcome.or'|trans({}, 'login') }}</span>
                    </div>
                </div>

                <a href="{{ path('connect_google_start') }}"
                   class="w-full flex items-center justify-center gap-2.5 px-4 py-2.5 text-sm font-medium rounded-xl border border-white/23 bg-white/8 text-white hover:bg-white/15 transition-all duration-200">
                    <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                    </svg>
                    {{ 'welcome.google'|trans({}, 'login') }}
                </a>

                <p class="mt-4 text-center text-[10px] text-white/42 leading-relaxed">
                    {{ 'welcome.terms'|trans({'terms_url': path('app_terms_conditions')}, 'login')|raw }}
                </p>
            </div>

            {# ── State 2: Name collection (new users) ─────────────────────── #}
            <div data-auth-steps-target="step2" hidden>
                <button type="button"
                        data-action="auth-steps#goBack"
                        class="flex items-center gap-1 text-white/60 hover:text-white text-xs mb-4 transition-colors">
                    {{ ux_icon('tabler:chevron-left', {'class': 'w-3.5 h-3.5', 'aria-hidden': 'true'}) }}
                    {{ 'register.back'|trans({}, 'login') }}
                </button>

                <div class="inline-flex items-center gap-1.5 bg-white/12 border border-white/22 rounded-full px-3 py-1 text-xs text-white mb-4">
                    {{ ux_icon('tabler:mail', {'class': 'w-3.5 h-3.5 opacity-60', 'aria-hidden': 'true'}) }}
                    <span class="email-chip-value opacity-80">{{ emailParam }}</span>
                    <span class="opacity-45">·</span>
                    <span class="opacity-45">{{ 'register.new_account_chip'|trans({}, 'login') }}</span>
                </div>

                <h2 class="text-lg font-bold text-white mb-1">{{ 'register.heading'|trans({}, 'login') }}</h2>
                <p class="text-sm text-white/65 mb-5">{{ 'register.subtext'|trans({}, 'login') }}</p>

                <form action="{{ path('login') }}" method="POST" class="space-y-4">
                    <input type="hidden" name="_step" value="register">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('login_action') }}">
                    <input type="hidden" name="email" value="{{ emailParam }}">

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label for="firstName" class="block text-xs font-semibold text-white/75 mb-1.5">
                                {{ 'register.first_name_label'|trans({}, 'login') }}
                            </label>
                            <input type="text"
                                   id="firstName"
                                   name="firstName"
                                   class="block w-full px-3.5 py-2.5 rounded-xl border border-white/26 bg-white/10 text-white placeholder:text-white/38 focus:outline-none focus:ring-2 focus:ring-green-400 focus:border-transparent transition-all text-sm"
                                   placeholder="Alex"
                                   required
                                   autocomplete="given-name">
                        </div>
                        <div>
                            <label for="lastName" class="block text-xs font-semibold text-white/75 mb-1.5">
                                {{ 'register.last_name_label'|trans({}, 'login') }}
                            </label>
                            <input type="text"
                                   id="lastName"
                                   name="lastName"
                                   class="block w-full px-3.5 py-2.5 rounded-xl border border-white/26 bg-white/10 text-white placeholder:text-white/38 focus:outline-none focus:ring-2 focus:ring-green-400 focus:border-transparent transition-all text-sm"
                                   placeholder="Smith"
                                   autocomplete="family-name">
                        </div>
                    </div>

                    <button type="submit"
                            class="w-full flex justify-center items-center gap-2 px-4 py-2.5 text-sm font-semibold rounded-xl text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-400 shadow-lg shadow-green-500/25 transition-all duration-200">
                        {{ 'register.cta'|trans({}, 'login') }}
                        {{ ux_icon('tabler:arrow-right', {'class': 'w-4 h-4', 'aria-hidden': 'true'}) }}
                    </button>
                </form>

                <p class="mt-4 text-center text-[10px] text-white/42 leading-relaxed">
                    {{ 'welcome.terms'|trans({'terms_url': path('app_terms_conditions')}, 'login')|raw }}
                </p>
            </div>

            {# ── State 3: Check inbox ──────────────────────────────────────── #}
            <div data-auth-steps-target="step3" hidden>
                <div class="text-center py-4">
                    <div class="flex justify-center mb-4">
                        {{ ux_icon('tabler:mail-opened', {'class': 'w-12 h-12 text-white/70', 'aria-hidden': 'true'}) }}
                    </div>
                    <h2 class="text-lg font-bold text-white mb-2">{{ 'sent.heading'|trans({}, 'login') }}</h2>
                    <p class="text-sm text-white/65 leading-relaxed mb-6">
                        {{ 'sent.body'|trans({'email': emailParam|e('html')}, 'login')|raw }}
                    </p>
                    <p class="text-xs text-white/42">
                        {{ 'sent.wrong_email'|trans({}, 'login') }}
                        <a href="{{ path('login') }}" class="text-white/70 underline underline-offset-2 hover:text-white transition-colors">
                            {{ 'sent.start_over'|trans({}, 'login') }}
                        </a>
                    </p>
                </div>
            </div>

        </div>{# end card inner #}
    </div>{# end glass card #}

</div>{# end data-controller #}
{% endblock %}
