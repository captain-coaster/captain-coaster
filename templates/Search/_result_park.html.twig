{# Park search result row #}
<a href="{{ path('redirect_park_show', {'slug': result.slug}) }}"
   class="group flex items-center gap-3 px-4 py-3 hover:bg-surface-muted transition-colors">

    {# Best coaster image, falling back to park icon #}
    <div class="shrink-0 w-10 h-10 rounded-full overflow-hidden bg-surface-muted flex items-center justify-center">
        {% if result.image %}
            <img src="{{ pictures_cdn }}/280x210/{{ result.image }}"
                 alt=""
                 class="w-full h-full object-cover"
                 loading="lazy">
        {% else %}
            {{ ux_icon('tabler:ferris-wheel', {'class': 'w-5 h-5 text-neutral-400 dark:text-neutral-500', 'aria-hidden': 'true'}) }}
        {% endif %}
    </div>

    {# Name + country #}
    <div class="flex-1 min-w-0">
        <div class="font-medium text-sm text-content truncate group-hover:text-cc-blue-600 transition-colors">
            {{ result.name }}
        </div>
        <div class="text-xs text-content-tertiary truncate">
            {% if result.subtitle starts with 'country.' %}
                {{ result.subtitle|trans({}, 'database') }}
            {% else %}
                {{ result.subtitle }}
            {% endif %}
        </div>
    </div>

    {# Coaster count #}
    {% if result.metadata.coasterCount > 0 %}
        <span class="shrink-0 text-xs text-content-muted">
            {{ 'search_index.coaster_count'|trans({'%count%': result.metadata.coasterCount}) }}
        </span>
    {% endif %}

    {{ ux_icon('tabler:chevron-right', {'class': 'w-4 h-4 text-neutral-300 dark:text-neutral-600 shrink-0', 'aria-hidden': 'true'}) }}
</a>
