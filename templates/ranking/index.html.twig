{% extends "base.html.twig" %}

{% trans_default_domain 'ranking' %}

{% set title = 'title'|trans %}
{% set shortTitle = 'title_short'|trans %}
{% set headerBand = true %}
{% set pageSurface = true %}
{# From lg the explainer link sits on the band, level with the title; below lg it closes the list (see the body). #}
{% set pageActions %}
  <twig:FilterToggle/>
  <a href="{{ path('ranking_learn_more') }}" class="inline-flex min-h-11 items-center gap-1.5 font-semibold text-on-brand underline-offset-4 hover:underline focus-visible:outline-highlight max-lg:hidden">
    {{ 'edition.how'|trans }}{{ ux_icon('lucide:arrow-right', {class: 'size-4', 'aria-hidden': 'true'}) }}
  </a>
{% endset %}
{% if ranking %}
  {% set isNew = date(ranking.publishedAt) > date('-7 days') %}
  {% set pageMeta %}
    {# The band's one context line: the month, the New pill during the first week, then the countdown after a dot.
       Below lg the line is short: the countdown is abridged, and steps aside while the pill shows. #}
    <span>{{ ranking.month|format_date(pattern: 'LLLL y')|capitalize }}</span>
    {% if isNew %}
      <span class="-skew-x-10 bg-highlight px-2 pt-1 pb-0.5 font-display text-caption leading-none font-extrabold text-on-highlight italic">{{ 'edition.new'|trans }}</span>
    {% endif %}
    <span class="flex gap-x-2 font-normal {{ isNew ? 'max-lg:hidden' }}">
      <span aria-hidden="true">·</span>
      <span class="lg:hidden">{{ 'edition.next_short'|trans({date: nextRanking|ago}) }}</span>
      <span class="max-lg:hidden">{{ 'edition.next'|trans({date: nextRanking|ago}) }}</span>
    </span>
  {% endset %}
{% endif %}
{% if top100 %}
  {% set meter %}<twig:Ranking:Top100Meter :operating="top100.nb_top100_operating" :legends="top100.nb_legends"/>{% endset %}
{% endif %}
{# canonicalFilters is null for a filtering that stays out of search engines (RankingController::canonicalFilters()). #}
{% if canonicalFilters is not null %}
  {% set canonical = {route: 'ranking_index', params: (canonicalFilters ? {filters: canonicalFilters} : {})|merge(coasters.currentPageNumber > 1 ? {page: coasters.currentPageNumber} : {})} %}
{% endif %}
{% block title %}{{ title }}{% endblock %}

{% block header %}
  <meta name="description" content="{{ 'description'|trans }}"/>
  {% if canonicalFilters is null %}
    <meta name="robots" content="noindex, follow">
  {% endif %}
{% endblock %}

{% block secondary_sidebar %}
  <twig:FilterPanel :form="filterForm" :lead="meter|default(null)" :config="{endpoint: path('ranking_search_async'), container_id: 'ranking-result', update_url: true, initial_load: 'false'}"/>
{% endblock %}

{% block body %}
  <div>
    {% if not ranking %}
      <p class="m-0 py-6 text-center text-muted">{{ 'info.not_computed'|trans }}</p>
    {% endif %}
    {# Below md the rider's meter is the one block between the band and the cover; from md it leads the side column. #}
    {% if meter is defined %}
      <div class="py-4 md:hidden">{{ meter }}</div>
    {% endif %}
    {# Container for results.html.twig: the cover and the ledger lay out on its width #}
    <div id="ranking-result" class="@container/results">
      {% include 'ranking/results.html.twig' %}
    </div>
    {# Below lg the explainer closes the list, as a row of its own #}
    <a href="{{ path('ranking_learn_more') }}" class="-mx-gutter mt-6 flex min-h-14 items-center justify-between gap-3 border-y border-line px-gutter font-semibold text-ink -outline-offset-3 hover:bg-subtle sm:mx-0 sm:px-3 lg:hidden">
      {{ 'edition.how'|trans }}{{ ux_icon('lucide:chevron-right', {class: 'size-5 text-muted', 'aria-hidden': 'true'}) }}
    </a>
  </div>
{% endblock %}
