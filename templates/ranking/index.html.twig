{% extends "base.html.twig" %}

{% trans_default_domain 'ranking' %}

{% set title = 'title'|trans %}
{% set pageActions %}<twig:FilterToggle/>{% endset %}
{% if ranking %}
  {% set pageMeta %}
    {# Month line (+ New pill during the first week), then the countdown and the explainer link, spaced rather than separated. #}
    <p class="m-0 mt-1 flex flex-wrap items-center gap-x-2 text-lead font-semibold text-muted-strong">
      {{ ranking.month|format_date(pattern: 'LLLL y')|capitalize }}
      {% if date(ranking.publishedAt) > date('-7 days') %}
        <span class="rounded-pill bg-highlight px-2 text-caption font-semibold text-on-highlight">{{ 'edition.new'|trans }}</span>
      {% endif %}
    </p>
    <p class="m-0 mt-1 flex flex-wrap gap-x-4 text-caption text-muted">
      <span>{{ 'edition.next'|trans({date: nextRanking|ago}) }}</span>
      <a href="{{ path('ranking_learn_more') }}" class="text-action underline-offset-4 hover:underline">{{ 'edition.how'|trans }}</a>
    </p>
  {% endset %}
{% endif %}
{# canonicalFilters is null for a filtering that stays out of search engines (RankingController::canonicalFilters()). #}
{% if canonicalFilters is not null %}
  {% set canonical = {route: 'ranking_index', params: (canonicalFilters ? {filters: canonicalFilters} : {})|merge(coasters.currentPageNumber > 1 ? {page: coasters.currentPageNumber} : {})} %}
{% endif %}
{% block title %}{{ title }}{% endblock %}

{% block header %}
  <meta name="description" content="{{ 'description'|trans }}"/>
  {% if canonicalFilters is null %}
    <meta name="robots" content="noindex, follow">
  {% endif %}
{% endblock %}

{% block secondary_sidebar %}
  {% include 'Includes/filter_sidebar.html.twig' with {
    'filters': filters|default({}),
    'filtersForm': filtersForm,
    'filterConfig': {
      'endpoint': path('ranking_search_async'),
      'container_id': 'ranking-result',
      'update_url': true,
      'initial_load': 'false',
      'excluded_filters': ['score', 'kiddie', 'sortByDistance']
    }
  } only %}
{% endblock %}

{% block body %}
  <div>
    {% if not ranking %}
      <p class="rounded-card border border-line bg-surface p-6 text-center text-muted">{{ 'info.not_computed'|trans }}</p>
    {% endif %}
    {% if top100 %}
      <twig:Ranking:Top100Meter :operating="top100.nb_top100_operating" :legends="top100.nb_legends" class="mb-3"/>
    {% endif %}
    {# Container for results.html.twig: from 56rem the podium steps aside and the ledger holds everyone #}
    <div id="ranking-result" class="@container/results">
      {% include 'ranking/results.html.twig' %}
    </div>
  </div>
{% endblock %}
