{% extends "base.html.twig" %}

{% trans_default_domain 'ranking' %}

{% set title = 'title'|trans %}
{% set shortTitle = 'title_short'|trans %}
{% set headerBand = true %}
{% set pageSurface = true %}
{# From lg the explainer link sits on the band, level with the title; below lg it is the row that opens the page (see the body). #}
{% set pageActions %}
  <twig:FilterToggle/>
  <a href="{{ path('ranking_learn_more') }}" class="inline-flex min-h-11 items-center gap-1.5 font-semibold text-on-brand underline-offset-4 hover:underline focus-visible:outline-highlight max-lg:hidden">
    {{ 'edition.how'|trans }}{{ ux_icon('lucide:arrow-right', {class: 'size-4', 'aria-hidden': 'true'}) }}
  </a>
{% endset %}
{# The New pill during the ranking's first week, the countdown to the next one after that: never both. #}
{% set isNew = ranking and date(ranking.publishedAt) > date('-7 days') %}
{% if ranking %}
  {% set pageMeta %}
    {# The band's one context line: the month, then the New pill or, from lg, the countdown after a dot.
       Below lg the countdown is in the row that opens the page (see the body). #}
    <span>{{ ranking.month|format_date(pattern: 'LLLL y')|capitalize }}</span>
    {% if isNew %}
      <span class="-skew-x-10 bg-highlight px-2 pt-1 pb-0.5 livery-type text-caption leading-none text-on-highlight">{{ 'edition.new'|trans }}</span>
    {% else %}
      <span class="flex gap-x-2 font-normal max-lg:hidden">
        <span aria-hidden="true">·</span>
        <span>{{ 'edition.next'|trans({date: nextRanking|ago}) }}</span>
      </span>
    {% endif %}
  {% endset %}
{% endif %}
{# canonicalFilters is null for a filtering that stays out of search engines (RankingController::canonicalFilters()). #}
{% if canonicalFilters is not null %}
  {% set canonical = {route: 'ranking_index', params: (canonicalFilters ? {filters: canonicalFilters} : {})|merge(coasters.currentPageNumber > 1 ? {page: coasters.currentPageNumber} : {})} %}
{% endif %}
{% block title %}{{ title }}{% endblock %}

{% block header %}
  <meta name="description" content="{{ 'description'|trans }}"/>
  {% if canonicalFilters is null %}
    <meta name="robots" content="noindex, follow">
  {% endif %}
{% endblock %}

{% block side_column %}
  <twig:FilterPanel :form="filterForm" :config="{endpoint: path('ranking_search_async'), container_id: 'ranking-result', update_url: true, initial_load: 'false'}"/>
{% endblock %}

{% block body %}
  <div>
    {% if not ranking %}
      <p class="m-0 py-6 text-center text-muted">{{ 'info.not_computed'|trans }}</p>
    {% endif %}
    {# Below lg the explainer and the countdown open the page as one row; from lg both are on the band #}
    <a href="{{ path('ranking_learn_more') }}" class="-mx-gutter flex min-h-14 items-center justify-between gap-3 border-b border-line px-gutter py-2 text-ink -outline-offset-3 hover:bg-subtle sm:mx-0 sm:px-0 md:-mt-2 lg:hidden">
      <span>
        <span class="block font-semibold">{{ 'edition.how'|trans }}</span>
        {% if ranking and not isNew %}<span class="block text-caption text-muted">{{ 'edition.next'|trans({date: nextRanking|ago}) }}</span>{% endif %}
      </span>
      {{ ux_icon('lucide:chevron-right', {class: 'size-5 shrink-0 text-muted', 'aria-hidden': 'true'}) }}
    </a>
    {# The signed-in rider's meter, above the cover #}
    {% if top100 %}
      <twig:Ranking:Top100Meter :operating="top100.nb_top100_operating" class="py-4 lg:pt-0"/>
    {% endif %}
    {# Container for results.html.twig: the cover and the ledger lay out on its width #}
    <div id="ranking-result" class="@container/results">
      {% include 'ranking/results.html.twig' %}
    </div>
  </div>
{% endblock %}
