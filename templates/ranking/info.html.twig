<div class="cc-panel cc-cc-panel--flat">
  <div class="cc-panel__heading has-visible-elements">
    <h6 class="cc-panel__title">{{ 'coaster_ranking.info.title'|trans({'%rankingMonth%': ranking.computedAt|format_datetime('long', 'none')}) }}</h6>
    <div class="heading-elements visible-elements" style="display: flex; gap: 1rem; flex-wrap: wrap;">
      {% set nextRankingDate = 'now'|date_modify('first day of next month midnight 1 minute') %}
      {% if nextRankingDate|date('U') - 'now'|date('U') > 7200 %}
        <span class="heading-text text-muted" style="white-space: nowrap;">
          {{ ux_icon('heroicons:clock', {'class': 'w-4 h-4 text-warning position-left'}) }}
          {{ 'coaster_ranking.info.next'|trans({'%date%': nextRankingDate|ago}) }}
        </span>
      {% endif %}
      <span class="heading-text text-muted" style="white-space: nowrap;">
        {{ ux_icon('heroicons:plus', {'class': 'w-4 h-4 text-warning position-left'}) }}
        <a class="text-muted" href="{{ path('ranking_learn_more') }}">{{ 'coaster_ranking.info.learn_more'|trans() }}</a>
      </span>
    </div>
  </div>
  <div class="cc-panel__body grid grid-cols-12 gap-5 text-center">
    <div class="col-span-3">
      <div class="content-group">
        <h6 class="text-semibold no-margin">
          {{ ux_icon('heroicons:chat-bubble-left', {'class': 'w-4 h-4 position-left text-cc-slate'}) }}<br/>{{ ranking.rankedCoasterNumber }}&nbsp;
          {% if ranking.rankedCoasterNumber - previousRanking.rankedCoasterNumber > 0 %}
            <span class="cc-badge bg-cc-blue-400">+{{ ranking.rankedCoasterNumber - previousRanking.rankedCoasterNumber }}</span>
          {% endif %}
        </h6>
        <span class="visible-xs text-muted text-size-small">{{ 'coaster_ranking.info.coasters_ranked.short'|trans }}</span>
        <span class="hidden-xs text-muted text-size-small">{{ 'coaster_ranking.info.coasters_ranked.long'|trans }}</span>
      </div>
    </div>
    <div class="col-span-3">
      <div class="content-group">
        <h6 class="text-semibold no-margin">
          {{ ux_icon('heroicons:star', {'class': 'w-4 h-4 position-left text-cc-slate'}) }}<br/>{{ ranking.ratingNumber|shortNum }}&nbsp;
          {% if ranking.ratingNumber - previousRanking.ratingNumber > 1000 %}
            <span class="cc-badge bg-cc-blue-400">+{{ (ranking.ratingNumber - previousRanking.ratingNumber)|shortNum }}</span>
          {% endif %}
        </h6>
        <span class="text-muted text-size-small">{{ 'coaster_ranking.info.ratings'|trans }}</span>
      </div>
    </div>
    <div class="col-span-3">
      <div class="content-group">
        <h6 class="text-semibold no-margin">
          {{ ux_icon('heroicons:user-group', {'class': 'w-4 h-4 position-left text-cc-slate'}) }}<br/>{{ ranking.userNumber }}&nbsp;
          {% if ranking.userNumber - previousRanking.userNumber > 0 %}
            <span class="cc-badge bg-cc-blue-400">+{{ ranking.userNumber - previousRanking.userNumber }}</span>
          {% endif %}
        </h6>
        <span class="text-muted text-size-small">{{ 'coaster_ranking.info.users'|trans }}</span>
      </div>
    </div>
    <div class="col-span-3">
      <div class="content-group">
        <h6 class="text-semibold no-margin">
          {{ ux_icon('heroicons:arrows-right-left', {'class': 'w-4 h-4 position-left text-cc-slate'}) }}<br/>{{ ranking.comparisonNumber|shortNum }}&nbsp;
          {% if ranking.comparisonNumber - previousRanking.comparisonNumber > 1000 %}
            <span class="cc-badge bg-cc-blue-400">+{{ (ranking.comparisonNumber - previousRanking.comparisonNumber)|shortNum }}</span>
          {% endif %}
        </h6>
        <span class="visible-xs text-muted text-size-small">{{ 'coaster_ranking.info.comparisons.short'|trans }}</span>
        <span class="hidden-xs text-muted text-size-small">{{ 'coaster_ranking.info.comparisons.long'|trans }}</span>
      </div>
    </div>
  </div>
</div>
