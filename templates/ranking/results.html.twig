{% import "helper.html.twig" as helper %}

<ul class="cc-media-list content-group">
    {% for coaster in coasters %}
        <li class="cc-media cc-panel cc-panel__body cc-media--stack-mobile">
            <div class="cc-media__start">
                <a href="{{ path('show_coaster', {'id': coaster.id, 'slug': coaster.slug}) }}">
                    {% if coaster.mainImage is not null %}
                        {# Displayed at width:96px -- 192x192 is a 2x-retina request, not the display size itself. #}
                        {{ helper.picture(coaster.mainImage.filename, 192, 192, coaster.name, 'img-rounded', 'lazy', 'width:96px;') }}
                    {% endif %}
                </a>
            </div>
            <div class="cc-media__body">
                <h2 class="cc-media__heading mb-2.5">
                    <a style="color:#333;" href="{{ path('show_coaster', {'id': coaster.id, 'slug': coaster.slug}) }}">
                        {% if not filtered %}
                            {{ coaster.rank }}&nbsp;-&nbsp;{{ coaster.name }}
                        {% else %}
                            {{ firstRank + loop.index0 }}&nbsp;-&nbsp;{{ coaster.name }} (#{{ coaster.rank }})
                        {% endif %}
                    </a>
                    {{ helper.variation(coaster) }}
                </h2>
                <ul class="list-inline list-inline-separate text-muted mb-[5px]">
                    <li>
                        <a class="text-muted" href="{{ path('park_show', {'id': coaster.park.id, 'slug': coaster.park.slug}) }}">
                            {{ coaster.park.name }}
                        </a>
                    </li>
                    <li>{{ coaster.park.country.name|trans([], 'database') }}</li>
                </ul>
                <ul class="list-inline list-inline-separate text-muted mb-[5px]">
                    {% if coaster.manufacturer %}
                        <li>{{ coaster.manufacturer.name }}</li>{% endif %}
                </ul>
            </div>
            <div class="cc-media__end text-center">
                <h3 style="color: {{ helper.ratingColor(coaster.score) }};" class="m-0 text-semibold text-nowrap">
                    {{ coaster.score|format_number({'min_fraction_digit': 1, 'max_fraction_digit': 1}) }}%
                </h3>
                <span class="text-muted mb-2.5 mt-2.5 text-nowrap">
            {{ 'coaster_ranking.duel_number'|trans({'count': coaster.validDuels}) }}
          </span>
            </div>
        </li>
    {% else %}
        <li class="cc-media cc-panel cc-panel__body cc-media--stack-mobile">
            <h5>{{ 'coaster_ranking.no_results'|trans }}</h5>
        </li>
    {% endfor %}
</ul>
{{ knp_pagination_render(coasters) }}
