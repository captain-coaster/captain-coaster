{% if reviews|length > 0 %}
  <div class="panel-body">
    <ul class="media-list media-list-bordered">
      {% for review in reviews %}
        <li>
          <div class="media-heading">
            <h6 class="text-semibold">
              <a href="{{ path('show_coaster', {'id': review.coaster.id, 'slug': review.coaster.slug}) }}">
                {{ review.coaster.name }}
              </a>
              -
              <a href="{{ path('park_show', {'id': review.coaster.park.id, 'slug': review.coaster.park.slug}) }}">
                {{ review.coaster.park.name }}
              </a>
            </h6>
          </div>
          {% include 'Includes/_review_item.html.twig' with {'review': review, 'preferredReviewLanguages': preferredReviewLanguages} %}
        </li>
      {% endfor %}
    </ul>
  </div>
  {% if hasMore %}
    <div class="panel-footer text-center" data-review-list-target="trigger">
      <a href="{{ path('review_list', {'count': nextCount}) }}"
         class="btn btn-link"
         data-action="click->review-list#loadMore">
        {{ 'review_list.load_more'|trans }}
      </a>
    </div>
  {% endif %}
{% else %}
  <div class="panel-body text-center text-muted">
    {{ ux_icon('heroicons:chat-bubble-left-right', {'class': 'w-8 h-8'}) }}
    <p class="mt-10">{{ 'review_list.no_review'|trans }}</p>
  </div>
{% endif %}
