{% extends "layouts/base.html.twig" %}

{% set title = 'review_list.title'|trans %}
{% block title %}{{ title }}{% endblock %}

{% block body %}
  <twig:PageHeader
    title="{{ title }}"
    subtitle="{{ 'review.share'|trans }}"
    icon="tabler:message-circle"
  />

  {% if reviews.getTotalItemCount() > 0 %}
    {# Reviews Feed #}
    <div class="space-y-4">
      {% for review in reviews %}
        <twig:ReviewCard
          :review="review"
          variant="full"
          :displayReviewsInAllLanguages="true"
          :showCoaster="true"
          :showActions="true"
          :maxReviewLength="300"
        />
      {% endfor %}
    </div>

    <div class="mt-6">
      {{ knp_pagination_render(reviews) }}
    </div>
  {% else %}
    <twig:EmptyState icon="tabler:message-circle-off" :title="'review_list.no_review'|trans" :description="'review.share'|trans" />
  {% endif %}
{% endblock %}
