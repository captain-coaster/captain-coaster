{% extends "base.html.twig" %}

{% set title = 'review_list.title'|trans %}
{% block title %}{{ title }}{% endblock %}

{% block body %}
  <div class="grid grid-cols-12 gap-5">
    <div class="cc-panel cc-cc-panel--flat col-span-full" data-controller="review-list">
      <div class="cc-panel__heading">
        <h6 class="cc-panel__title text-semibold">
          {{ ux_icon('heroicons:chat-bubble-left', {'class': 'w-4 h-4 position-left'}) }}
          {{ 'review_list.title'|trans }}
        </h6>
      </div>

      <div data-review-list-target="container">
        {% include 'Review/_review_body.html.twig' %}
      </div>
    </div>
  </div>
{% endblock %}
