{% extends "base.html.twig" %}

{% set title = 'review_list.title'|trans %}
{% block title %}{{ title }}{% endblock %}

{% block body %}
  <div class="row">
    <div class="panel panel-flat" data-controller="review-list">
      <div class="panel-heading">
        <h6 class="panel-title text-semibold">
          {{ ux_icon('heroicons:chat-bubble-left', {'class': 'w-4 h-4 position-left'}) }}
          {{ 'review_list.title'|trans }}
        </h6>
      </div>

      <div data-review-list-target="container">
        {% include 'Review/_review_body.html.twig' %}
      </div>
    </div>
  </div>
{% endblock %}
