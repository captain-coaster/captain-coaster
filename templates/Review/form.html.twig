{% extends "base.html.twig" %}
{% import 'helper.html.twig' as helper %}
{% set title = 'review.form.title'|trans({'%name%': coaster.name}) %}
{% set subTitle = '' %}
{% set parentUrl = path('show_coaster', {'id': coaster.id, 'slug': coaster.slug}) %}
{% block title %}{{ title }}{% endblock %}

{% block body %}
  {# Fields keep one readable column (40rem); from lg the extra width holds the coaster card. #}
  <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,40rem)_18rem] lg:gap-16">
    {{ form_start(form, {attr: {class: 'grid gap-6'}}) }}
      {{ form_errors(form) }}
      {{ form_row(form.value) }}
      {{ form_row(form.pros) }}
      {{ form_row(form.cons) }}
      {{ form_row(form.review) }}
      {{ form_row(form.riddenAt) }}
      {{ form_rest(form) }}
      <div class="flex flex-col gap-2 md:flex-row md:items-center">
        <twig:Button block>{{ 'review.send'|trans }}</twig:Button>
        <twig:Button variant="text" href="{{ parentUrl }}">{{ 'review.cancel'|trans }}</twig:Button>
      </div>
    {{ form_end(form) }}

    {# Phones already have the coaster name in the page title. #}
    <aside class="sticky top-24 hidden overflow-hidden rounded-card border border-line bg-surface lg:block">
      <span class="relative block aspect-4/3 bg-subtle">
        {% if coaster.mainImage %}
          {{ helper.picture(coaster.mainImage, 288, 216, '', 'absolute inset-0 size-full object-cover') }}
        {% else %}
          {{ ux_icon('lucide:roller-coaster', {class: 'absolute inset-0 m-auto size-8 text-muted', 'aria-hidden': 'true'}) }}
        {% endif %}
      </span>
      <span class="grid gap-0.5 p-4">
        <span class="font-display text-lead leading-tight font-semibold">{{ coaster.name }}</span>
        <span class="text-caption text-muted-strong">{{ coaster.park.name }}, {{ coaster.park.country.name|trans({}, 'database') }}</span>
      </span>
    </aside>
  </div>
{% endblock %}
