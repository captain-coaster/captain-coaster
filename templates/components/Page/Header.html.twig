{#
  Page title: back button, title and the page's actions on one row. On the
  canvas by default; with `band`, on the brand band (livery stripes at its foot,
  fixed height). Below lg a compact brand bar with the same three
  fades in at the top once that row scrolls away (page_header_controller.js);
  it takes no room until then.
  Props:
    title, subtitle, secondary  h1, a context line under it (park, author, country), a muted line (former names)
    shortTitle   replaces the title below lg, on the band and in the compact bar, where it has one line (Twig var `shortTitle`)
    subtitleUrl  makes the context line a link (coaster → park, Top → author)
    parent       detail pages only: shows the back button, and is its target when not arriving from another site page (back_controller.js)
    actions      rendered HTML for the page's actions (Twig var `pageActions`)
    meta         rendered HTML under the title (Twig var `pageMeta`, e.g. the ranking month); on the band it is inline content of the one context line
    band         the brand band (Twig var `headerBand`; DESIGN.md, the clean ↔ fun budget). Without it, a brand bar
                 below lg and the title on the page from lg
    legacy       a page still on legacy panels keeps its title on the canvas at every size (Twig var `pageCanvas`)
#}
{% props title, shortTitle = null, subtitle = null, subtitleUrl = null, secondary = null, parent = null, actions = null, meta = null, band = false, legacy = false %}
{% set back %}
  <twig:RoundButton icon="lucide:arrow-left" label="{{ 'nav.back'|trans }}" href="{{ parent }}"
                    data-controller="back" data-action="back#go"/>
{% endset %}
<div data-controller="page-header" {{ attributes.defaults({class: "contents"}) }}>
  <div data-page-header-target="bar" data-brand
       class="invisible fixed inset-x-0 top-0 z-30 box-content flex h-14 items-center gap-3 bg-brand px-3 pt-[env(safe-area-inset-top)] text-on-brand opacity-0 transition-[opacity,visibility] duration-180 ease-out after:absolute after:inset-x-0 after:bottom-0 after:h-px after:bg-white/14 data-scrolled:visible data-scrolled:opacity-100 motion-reduce:transition-none lg:hidden">
    {% if parent %}{{ back }}{% endif %}
    <p class="m-0 min-w-0 flex-1 truncate livery-type text-2xl leading-none {{ parent ? '' : 'ps-2' }}" aria-hidden="true">{{ shortTitle ?? title }}</p>
    {% if actions %}
      <div class="flex shrink-0 items-center gap-2">{{ actions|raw }}</div>
    {% endif %}
  </div>

  {% if band %}
    {# A div, not a <header>: Nav:Header is the page's one banner landmark. #}
    <div data-page-header-target="row" data-brand
            class="relative box-content h-band-page overflow-hidden lg:h-band-page-wide bg-brand pt-[env(safe-area-inset-top)] text-on-brand">
      <div class="relative z-10 mx-auto max-w-content px-gutter pt-5 lg:pt-7">
        <div class="flex items-center gap-3">
          {% if parent %}
            <div class="shrink-0 lg:hidden">{{ back }}</div>
          {% endif %}
          {# min-h-11: the row keeps its height when the page has no action. #}
          <h1 class="m-0 flex min-h-11 min-w-0 flex-1 items-center livery-type"><span class="truncate pe-1">{% if shortTitle %}<span class="lg:hidden">{{ shortTitle }}</span><span class="max-lg:hidden">{{ title }}</span>{% else %}{{ title }}{% endif %}</span></h1>
          {% if actions %}
            <div class="flex shrink-0 items-center gap-2">{{ actions|raw }}</div>
          {% endif %}
        </div>
        {% if subtitle or meta %}
          <p class="m-0 flex items-center gap-x-2 overflow-hidden text-body font-semibold whitespace-nowrap text-on-brand-muted lg:mt-1 lg:text-lead">
            {% if subtitle %}
              {%- if subtitleUrl -%}
                <a href="{{ subtitleUrl }}" class="truncate text-inherit underline-offset-4 hover:text-on-brand hover:underline focus-visible:outline-highlight">{{ subtitle }}</a>
              {%- else -%}
                <span class="truncate">{{ subtitle }}</span>
              {%- endif -%}
            {% endif %}
            {{ meta|raw }}
          </p>
        {% endif %}
      </div>
      <twig:LiveryStripes/>
    </div>
  {% else %}
    {% if not legacy %}
      {# Below lg the title sits on a brand bar. It is a row of its own: `data-brand` restyles the buttons inside it,
         which the same buttons on the page from lg must not get. #}
      <div data-page-header-target="row" data-brand
           class="box-content flex min-h-14 items-center gap-3 bg-brand px-3 pt-[env(safe-area-inset-top)] text-on-brand lg:hidden">
        {% if parent %}{{ back }}{% endif %}
        <div class="min-w-0 flex-1 py-2.5 {{ parent ? '' : 'ps-1' }}">
          <h1 class="m-0 pe-1 text-balance">{{ shortTitle ?? title }}</h1>
          {% if subtitle %}
            <p class="m-0 mt-1 text-caption font-semibold text-on-brand-muted">
              {%- if subtitleUrl -%}
                <a href="{{ subtitleUrl }}" class="text-inherit underline-offset-4 hover:text-on-brand hover:underline focus-visible:outline-highlight">{{ subtitle }}</a>
              {%- else -%}
                {{ subtitle }}
              {%- endif -%}
            </p>
          {% endif %}
        </div>
        {% if actions %}
          <div class="flex shrink-0 items-center gap-2">{{ actions|raw }}</div>
        {% endif %}
      </div>
    {% endif %}
    {# The title on the page: from lg, and at every size on a page still on legacy panels. #}
    <div {% if legacy %}data-page-header-target="row"{% endif %}
         class="mx-auto flex w-full max-w-content items-start gap-3 px-gutter pt-[calc(var(--spacing)*3+env(safe-area-inset-top))] pb-6 lg:items-end lg:gap-4 lg:pt-10 lg:pb-8 {{ legacy ? '' : 'max-lg:hidden' }}">
      {% if parent %}
        <div class="shrink-0 lg:hidden">{{ back }}</div>
      {% endif %}
      <div class="min-w-0 flex-1 max-lg:pt-1">
        <h1 class="m-0 text-balance">{{ title }}</h1>
        {% if subtitle %}
          <p class="m-0 mt-1 text-lead font-semibold text-muted-strong">
            {%- if subtitleUrl -%}
              <a href="{{ subtitleUrl }}" class="text-inherit underline-offset-4 hover:text-action hover:underline">{{ subtitle }}</a>
            {%- else -%}
              {{ subtitle }}
            {%- endif -%}
          </p>
        {% endif %}
        {% if secondary %}
          <p class="m-0 mt-1 text-caption text-muted">{{ secondary }}</p>
        {% endif %}
        {{ meta|raw }}
      </div>
      {% if actions %}
        <div class="flex shrink-0 items-center gap-2">{{ actions|raw }}</div>
      {% endif %}
    </div>
  {% endif %}
</div>
