{#
  RankingRow — full-width leaderboard row for the coaster ranking.

  Props:
    - coaster (required): Coaster entity (must have a rank)
    - ridden: bool — current user has ridden this coaster (drives the highlight)

  Usage:
    <twig:RankingRow :coaster="coaster" :ridden="coaster.id in riddenIds" />
#}
{% props coaster, ridden = false %}

<a href="{{ path('show_coaster', {'id': coaster.id, 'slug': coaster.slug}) }}"
   class="group flex items-center gap-3 sm:gap-4 bg-surface rounded-2xl p-3 sm:p-4 transition-all border
     {{ ridden
       ? 'border-green-300 dark:border-green-700/50 hover:border-green-400 dark:hover:border-green-600'
       : 'border-line hover:border-line-strong' }}">

  {# Rank + change indicator — left column #}
  <div class="shrink-0 w-12 sm:w-14 flex flex-col items-center">
    <twig:RankBadge :rank="coaster.rank" size="lg" />
    <div class="mt-1.5 h-5 flex items-center">
      {% if coaster.previousRank is empty %}
        {# NEW entry — icon only, label too long to fit across locales #}
        <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-cc-blue-100 dark:bg-cc-blue-900/40 text-cc-blue-600 dark:text-cc-blue-300"
              title="{{ 'coaster_ranking.new'|trans }}">
          {{ ux_icon('tabler:sparkles', {'class': 'w-3.5 h-3.5', 'aria-hidden': 'true'}) }}
        </span>
      {% elseif coaster.previousRank > coaster.rank %}
        <span class="inline-flex items-center gap-0.5 text-xs font-bold text-green-600 dark:text-green-400 tabular-nums"
              title="{{ 'coaster_ranking.new'|trans }}">
          {{ ux_icon('tabler:caret-up-filled', {'class': 'w-3.5 h-3.5', 'aria-hidden': 'true'}) }}{{ (coaster.rank - coaster.previousRank)|abs }}
        </span>
      {% elseif coaster.previousRank < coaster.rank %}
        <span class="inline-flex items-center gap-0.5 text-xs font-bold text-red-500 dark:text-red-400 tabular-nums">
          {{ ux_icon('tabler:caret-down-filled', {'class': 'w-3.5 h-3.5', 'aria-hidden': 'true'}) }}{{ (coaster.rank - coaster.previousRank)|abs }}
        </span>
      {% else %}
        <span class="block w-2.5 h-0.5 bg-neutral-300 dark:bg-neutral-600 rounded-full"></span>
      {% endif %}
    </div>
  </div>

  {# Image #}
  <div class="shrink-0 relative w-16 h-16 sm:w-20 sm:h-20 rounded-xl overflow-hidden">
    {% if coaster.mainImage is not null %}
      <img src="{{ pictures_cdn }}/280x210/{{ coaster.mainImage.filename }}"
           class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
           alt="{{ coaster.name }}"
           loading="lazy">
    {% else %}
      <div class="w-full h-full bg-surface-muted flex items-center justify-center">
        <span class="text-neutral-300 dark:text-neutral-600 text-xl font-bold">{{ coaster.name|slice(0, 1)|upper }}</span>
      </div>
    {% endif %}
  </div>

  {# Content — name, park, country #}
  <div class="flex-1 min-w-0">
    <h2 class="font-semibold text-sm sm:text-base text-content group-hover:text-cc-blue-600 dark:group-hover:text-cc-blue-400 transition-colors truncate">
      {{ coaster.name }}
      {% if ridden %}<span class="sr-only">— {{ 'coaster_ranking.ridden'|trans }}</span>{% endif %}
    </h2>
    <p class="text-xs sm:text-sm text-content-muted mt-0.5 truncate">
      {{ coaster.park.name }}
    </p>
    <p class="text-xs text-content-subtle mt-0.5 flex items-center gap-1">
      {{ ux_icon('tabler:map-pin', {'class': 'w-3 h-3 shrink-0', 'aria-hidden': 'true'}) }}
      <span class="truncate">{{ coaster.park.country.name|trans([], 'database') }}</span>
      {% if coaster.status is not null and coaster.status.name != constant('App\\Entity\\Status::OPERATING') %}
        {# Subtle marker — this coaster can't be ridden (closed / demolished) #}
        <span class="inline-flex items-center gap-1 ml-1 shrink-0 text-content-muted">
          <span class="w-1.5 h-1.5 rounded-full bg-{{ coaster.status.color ?? 'neutral' }}-400" aria-hidden="true"></span>
          {{ coaster.status.name|trans([], 'database') }}
        </span>
      {% endif %}
    </p>
  </div>
</a>
