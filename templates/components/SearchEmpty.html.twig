{#
  A search without result: what was searched, a hint, then what to do next (report the missing coaster or park,
  advanced search) as the search dialog's rows. Rendered by the results page, and inside a <template> that
  search_controller.js clones, filling the query, for the quick search.
  Props:
    query  the search; null inside the <template>
#}
{% props query = null %}
{% set entry = 'flex min-h-14 items-center gap-3 rounded-control px-2 py-1.5 text-ink no-underline hover:bg-subtle hover:text-ink' %}
<div {{ attributes.defaults({class: 'grid gap-3 text-ink'}) }}>
  <div class="grid gap-1 px-2 pt-2">
    <p class="m-0 font-semibold wrap-anywhere">
      {%- if query is null -%}
        {{ 'search_index.no_result_for'|trans({query: '<span data-search-empty-query></span>'})|raw }}
      {%- else -%}
        {{ 'search_index.no_result_for'|trans({query: query}) }}
      {%- endif -%}
    </p>
    <p class="m-0 text-caption text-muted">{{ 'search_index.no_result_hint'|trans }}</p>
  </div>
  <ul class="m-0 grid list-none gap-0.5 p-0">
    <li>
      <a href="{{ path('contact_index', {topic: 'missing', q: query}) }}" class="{{ entry }}" data-search-empty-report>
        {{ ux_icon('lucide:circle-plus', {class: 'size-6 shrink-0 text-muted', 'aria-hidden': 'true'}) }}
        <span class="min-w-0 flex-1">{{ 'search_index.report_missing'|trans }}</span>
        {{ ux_icon('lucide:chevron-right', {class: 'size-5 shrink-0 text-muted', 'aria-hidden': 'true'}) }}
      </a>
    </li>
    <li>
      <a href="{{ path('coaster_search_index') }}" class="{{ entry }}">
        {{ ux_icon('lucide:sliders-horizontal', {class: 'size-6 shrink-0 text-muted', 'aria-hidden': 'true'}) }}
        <span class="flex-1">{{ 'nav.advanced_search'|trans }}</span>
        {{ ux_icon('lucide:chevron-right', {class: 'size-5 shrink-0 text-muted', 'aria-hidden': 'true'}) }}
      </a>
    </li>
  </ul>
</div>
