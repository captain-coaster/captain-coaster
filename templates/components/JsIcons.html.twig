{#
  Icons for markup built in JS, read through js/icons.js. Type markers are
  sized like server-rendered search rows; the others stay at 1em and follow
  the font size of where they're inserted.
#}
<template id="js-icons">
  {% for type in ['coaster', 'park', 'user'] %}
    <span data-icon="{{ type }}"><twig:SearchTypeIcon type="{{ type }}"/></span>
  {% endfor %}
  {% set icons = {
    search: 'lucide:search',
    'arrow-right': 'lucide:arrow-right',
    check: 'lucide:check',
    success: 'lucide:circle-check',
    info: 'lucide:info',
    warning: 'lucide:triangle-alert',
    error: 'lucide:circle-x',
    close: 'lucide:x',
  } %}
  {% for name, icon in icons %}
    <span data-icon="{{ name }}">{{ ux_icon(icon, {class: 'shrink-0', 'aria-hidden': 'true'}) }}</span>
  {% endfor %}
  <span data-icon="loading">{{ ux_icon('lucide:loader-circle', {class: 'shrink-0 motion-safe:animate-spin', 'aria-hidden': 'true'}) }}</span>
</template>
