{#
  TopTypeBadge — small pill identifying a list's type.
  Props:
    - top (required): Top entity
    - size: 'xs' (very compact, short label) | 'sm' (default) | 'md'
    - short: true to use the short type label (e.g. "Top" vs "Top Coasters")
#}
{% props top, size = 'sm', short = false %}

{% set sizeClass = size == 'md'
  ? 'px-2.5 py-1 text-sm gap-1.5'
  : (size == 'xs'
      ? 'px-2 py-0.5 text-[10px] gap-1'
      : 'px-2 py-0.5 text-xs gap-1') %}
{% set iconClass = size == 'md' ? 'w-4 h-4' : (size == 'xs' ? 'w-3 h-3' : 'w-3.5 h-3.5') %}

{% if top.isRanking %}
  {% set icon = 'tabler:trophy' %}
  {% set label = (short ? 'type_short.ranking' : 'type.ranking')|trans({}, 'top') %}
  {% set tone = 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400' %}
{% elseif top.isBucket %}
  {% set icon = 'tabler:bucket' %}
  {% set label = (short ? 'type_short.bucket' : 'type.bucket')|trans({}, 'top') %}
  {% set tone = 'bg-cc-warm-100 text-cc-warm-700 dark:bg-cc-warm-900/30 dark:text-cc-warm-400' %}
{% else %}
  {% set icon = 'tabler:list' %}
  {% set label = (short ? 'type_short.custom' : 'type.custom')|trans({}, 'top') %}
  {% set tone = 'bg-cc-blue-100 text-cc-blue-700 dark:bg-cc-blue-900/30 dark:text-cc-blue-400' %}
{% endif %}

<span class="inline-flex items-center font-medium rounded-full {{ sizeClass }} {{ tone }}">
  {{ ux_icon(icon, {'class': iconClass, 'aria-hidden': 'true'}) }}
  {{ label }}
</span>
