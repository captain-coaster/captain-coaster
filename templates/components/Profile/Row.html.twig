{#
  A row of the profile's access list, in the livery: the icon in sunshine on a navy disc, the label, a count as an
  italic numeral or an unread badge, a chevron. Edge to edge below lg.
  Props:
    href, icon, label
    count  figure at the right (ratings, photos)
    badge  unread count on sunshine (notifications); shown from 1
#}
{% props href, icon, label, count = null, badge = 0 %}
<li>
  <a href="{{ href }}" {{ attributes.defaults({class: 'group flex min-h-14 items-center gap-3 border-b border-line px-gutter py-2 text-ink -outline-offset-3 hover:bg-subtle hover:text-ink lg:px-0 lg:hover:bg-transparent'}) }}>
    <span class="grid size-9 shrink-0 place-items-center rounded-full bg-brand text-highlight">
      {{ ux_icon(icon, {class: 'size-5', 'aria-hidden': 'true'}) }}
    </span>
    <span class="min-w-0 flex-1 font-semibold group-hover:underline">{{ label }}</span>
    {% if badge > 0 %}
      <span class="grid h-5.5 min-w-5.5 place-items-center rounded-pill bg-highlight px-1.5 text-caption leading-none font-bold text-on-highlight tabular-nums ring-[1.5px] ring-on-highlight ring-inset">{{ badge > 99 ? '99+' : badge }}</span>
    {% elseif count is not null %}
      <span class="pe-0.5 livery-type text-xl leading-none tabular-nums">{{ count|format_number }}</span>
    {% endif %}
    {{ ux_icon('lucide:chevron-right', {class: 'size-5 shrink-0 text-muted transition-transform duration-120 group-hover:translate-x-0.5 motion-reduce:transition-none', 'aria-hidden': 'true'}) }}
  </a>
</li>
