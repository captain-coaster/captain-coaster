{#
  A way into a member's content: a round navy button with its label under it. The icon is on-brand-muted, like the
  tab bar's idle tabs. No count: the page's figures already give it.
  Props:
    href, icon, label
#}
{% props href, icon, label %}
<li class="min-w-0">
  <a href="{{ href }}" {{ attributes.defaults({class: 'group flex flex-col items-center gap-1.5 py-1 text-caption font-semibold text-ink hover:text-ink'}) }}>
    <span class="grid size-12 shrink-0 place-items-center rounded-full bg-brand text-on-brand-muted group-hover:text-on-brand">
      {{ ux_icon(icon, {class: 'size-6', 'aria-hidden': 'true'}) }}
    </span>
    <span class="max-w-full truncate group-hover:underline">{{ label }}</span>
  </a>
</li>
