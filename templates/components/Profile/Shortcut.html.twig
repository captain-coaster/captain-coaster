{#
  A way into a member's content, as a tab of the shortcut bar: the tab bar's language (Nav:Tab), an outline icon over
  its label in on-brand-muted on the navy bar, white on hover. No count: the page's figures already give it.
  Props:
    href, icon, label
#}
{% props href, icon, label %}
<li class="min-w-0">
  <a href="{{ href }}" {{ attributes.defaults({class: 'flex h-full min-w-0 flex-col items-center justify-center gap-0.5 rounded-xl px-0.5 text-on-brand-muted -outline-offset-3 hover:bg-white/8 hover:text-on-brand focus-visible:outline-highlight'}) }}>
    {{ ux_icon(icon, {class: 'size-6', 'aria-hidden': 'true'}) }}
    <span class="max-w-full truncate text-label font-semibold">{{ label }}</span>
  </a>
</li>
