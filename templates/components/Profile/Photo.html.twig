{#
  A member's photo as a tile, in the favourites' language: the photo, its coaster and park on an ink scrim, the likes
  it received at its top right. Links to the coaster.
  Props:
    image    Image
    compact  true beside another photo: half the screen below lg, so a smaller name and tighter insets
#}
{% trans_default_domain 'profile' %}
{% import 'helper.html.twig' as helper %}
{% props image, compact = false %}
{% set coaster = image.coaster %}
<a href="{{ path('show_coaster', {id: coaster.id, slug: coaster.slug}) }}"
   {{ attributes.defaults({class: 'group relative block aspect-4/3 overflow-hidden bg-subtle text-white -outline-offset-3 hover:text-white'}) }}>
  {{ helper.picture(image, 640, 480, '', 'absolute inset-0 size-full object-cover') }}
  <span class="absolute inset-0 bg-linear-to-b from-scrim/0 from-45% to-scrim/85"></span>
  <span class="absolute top-2.5 right-2.5 flex items-center gap-1.5 rounded-pill bg-scrim/70 px-2.5 py-1 text-caption leading-none font-semibold tabular-nums">
    {{ ux_icon('lucide:heart', {class: 'size-3.5', 'aria-hidden': 'true'}) }}
    <span aria-hidden="true">{{ image.likeCounter|format_number }}</span>
    <span class="sr-only">{{ 'liked.likes'|trans({count: image.likeCounter}) }}</span>
  </span>
  <span class="absolute bottom-3 text-caption leading-tight lg:inset-x-4 {{ compact ? 'inset-x-2.5 max-lg:bottom-2.5' : 'inset-x-gutter' }}">
    <span class="block pe-1 livery-type leading-none group-hover:underline {{ compact ? 'text-lg lg:text-2xl' : 'text-2xl' }}">{{ coaster.name }}</span>
    <span class="mt-0.5 block">{{ coaster.park.name }}</span>
  </span>
</a>
