{#
  Drawn marker for a search result's type (coaster, park, rider).
  Props:
    type  coaster | park | user
#}
{% props type %}
{% set icons = {coaster: 'lucide:roller-coaster', park: 'lucide:ferris-wheel', user: 'lucide:user'} %}
{{ ux_icon(icons[type] ?? 'lucide:search', {class: attributes.render('class')|default('size-6 shrink-0 text-muted'), 'aria-hidden': 'true'}) }}
