{#
  Drawn marker for a search result's type (coaster, park, rider). Lucide has
  the coaster and ferris wheel Heroicons lacks; its 2px stroke is brought to
  Heroicons' 1.5.
  Props:
    type  coaster | park | user
#}
{% props type %}
{% set icons = {coaster: 'lucide:roller-coaster', park: 'lucide:ferris-wheel', user: 'heroicons:user'} %}
{{ ux_icon(icons[type] ?? 'heroicons:magnifying-glass', {class: attributes.render('class')|default('size-6 shrink-0 text-muted [stroke-width:1.5]'), 'aria-hidden': 'true'}) }}
