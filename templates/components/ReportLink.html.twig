{#
  A row inviting a rider to report something through the contact page: a muted question over the action,
  the whole row being the link. It closes the list it is about (a coaster's specs) or stands alone.
  Props:
    href      the contact page, with its topic and context
    question  the muted line ("Wrong or missing info?")
    label     the action ("Report an error")
    icon
#}
{% props href, question, label, icon = 'lucide:message-square-warning' %}
<a href="{{ href }}" {{ attributes.defaults({class: 'group flex min-h-row-2 items-center gap-3 bg-surface px-4 py-2.5 text-ink no-underline -outline-offset-3 hover:bg-subtle hover:text-ink'}) }}>
  {{ ux_icon(icon, {class: 'size-5 shrink-0 text-muted-strong', 'aria-hidden': 'true'}) }}
  <span class="grid min-w-0 flex-1">
    <span class="text-caption text-muted-strong">{{ question }}</span>
    <span class="font-semibold text-action group-hover:underline">{{ label }}</span>
  </span>
  {{ ux_icon('lucide:chevron-right', {class: 'size-5 shrink-0 text-muted', 'aria-hidden': 'true'}) }}
</a>
