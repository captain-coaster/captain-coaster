{#
  A cover tile (#1 to #3): the member photo with the position, the name with its ridden mark, the park and the movement
  (world rank when filtered) on a scrim at its foot. #1 is the page's loud moment: a sunshine numeral stroked in ink.
  Below a 36rem results width only #1 shows, edge to edge, and #2/#3 are ledger rows (results.html.twig); from 36rem
  #1 takes two of three columns and both rows, #2/#3 stack beside it.
  Props:
    coaster   Coaster
    position  number shown (world rank, or position in a filtered list)
    month     current ranking date (Ranking:Movement)
    ridden    signed-in rider has ridden it
    filtered  filtered list: the world rank replaces the movement
    tall      #1 spans both rows of the wide cover (three coasters)
#}
{% import 'helper.html.twig' as helper %}
{% props coaster, position, month, ridden = false, filtered = false, tall = true %}
{% set first = position == 1 %}
{% set imgClass = 'absolute inset-0 size-full object-cover' %}
<li {{ attributes.defaults({class: first ? (tall ? '@xl/results:row-span-2' : '') : 'hidden @xl/results:block'}) }}>
  {# data-cover: marks set on the photo turn white (Ranking:Movement, WorldRank, RiddenMark) #}
  <a href="{{ path('show_coaster', {id: coaster.id, slug: coaster.slug}) }}" data-cover
     class="group relative block h-full overflow-hidden bg-subtle text-white -outline-offset-3 @xl/results:rounded-sm {{ first ? 'aspect-16/10 @xl/results:aspect-auto' }}">
    {% if coaster.mainImage %}
      {% if first %}
        {# 16:10 across the screen below 36rem; beside #2/#3 its box is about 4:3 #}
        {% set f = coaster.mainImage %}
        <picture>
          <source media="(min-width: 56rem)" type="image/avif" srcset="{{ picture_url(f, 640, 480, 'avif') }} 1x, {{ picture_url(f, 1280, 960, 'avif') }} 2x">
          <source media="(min-width: 56rem)" srcset="{{ picture_url(f, 640, 480, 'jpg') }} 1x, {{ picture_url(f, 1280, 960, 'jpg') }} 2x">
          <source type="image/avif" srcset="{{ picture_url(f, 400, 250, 'avif') }} 1x, {{ picture_url(f, 800, 500, 'avif') }} 2x">
          <img src="{{ picture_url(f, 400, 250, 'jpg') }}" srcset="{{ picture_url(f, 400, 250, 'jpg') }} 1x, {{ picture_url(f, 800, 500, 'jpg') }} 2x"
               alt="" class="{{ imgClass }}" fetchpriority="high">
        </picture>
      {% else %}
        {# Lazy: these tiles are hidden below 36rem, where an eager photo would still be fetched #}
        {{ helper.picture(coaster.mainImage, 360, 270, '', imgClass) }}
      {% endif %}
    {% else %}
      {{ ux_icon('lucide:roller-coaster', {class: 'absolute inset-0 m-auto size-10 text-muted', 'aria-hidden': 'true'}) }}
    {% endif %}
    {# The text starts right of the numeral, which overlaps the scrim #}
    <span class="absolute inset-x-0 bottom-0 block bg-linear-to-b from-transparent via-ink/60 to-ink/90 pr-4 pb-3 {{ first ? 'pt-10 pl-24 @xl/results:pl-32' : 'pt-16 pl-18' }}">
      <twig:Ranking:Name :coaster="coaster" :ridden="ridden"
                         class="font-display font-extrabold italic group-hover:underline {{ first ? 'text-2xl @xl/results:text-title' : 'text-2xl' }} leading-none"/>
      <span class="mt-1 flex items-center gap-x-2 text-caption">
        <span class="truncate">{{ coaster.park.name }}{% if first and coaster.manufacturer %} – {{ coaster.manufacturer.name }}{% endif %}</span>
        {% if filtered %}
          <twig:Ranking:WorldRank :coaster="coaster" class="shrink-0"/>
        {% else %}
          <twig:Ranking:Movement :coaster="coaster" :month="month" class="shrink-0"/>
        {% endif %}
      </span>
    </span>
    <span class="absolute bottom-2 font-display leading-numeral font-extrabold italic tabular-nums {{ first ? 'left-3 text-podium-first text-highlight text-stroke-ink @xl/results:left-4 @xl/results:text-podium-first-wide' : 'left-3 text-podium' }}">{{ position }}</span>
  </a>
</li>
