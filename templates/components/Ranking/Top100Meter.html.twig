{#
  Signed-in rider's progress on the world top 100 operating coasters.
  The bar is <twig:Meter>, with notches at 25/50/75 for the milestones.
  Props:
    operating  ridden coasters among the top 100 operating
#}
{% trans_default_domain 'ranking' %}
{% props operating %}
<section {{ attributes }}>
  <div class="flex items-end justify-between gap-4">
    <div class="min-w-0">
      <h2 class="m-0 font-sans not-italic text-body font-semibold">{{ 'top100.title'|trans }}</h2>
      <p class="m-0 text-caption text-muted">{{ 'top100.caption'|trans }}</p>
    </div>
    <p class="m-0 shrink-0 pe-1 livery-type leading-none whitespace-nowrap">
      <span class="text-title tabular-nums">{{ operating }}</span><span class="text-lead text-muted"> / 100</span>
    </p>
  </div>
  <twig:Meter :value="operating" :max="100" label="{{ 'top100.title'|trans }}" :notches="[25, 50, 75]" class="mt-2"/>
</section>
