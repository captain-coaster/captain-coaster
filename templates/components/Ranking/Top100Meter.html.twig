{#
  Signed-in rider's progress on the world top 100 operating coasters.
  The bar is the livery's meter: at the angle, sunshine fill, ink outline. Notches at 25/50/75 mark the milestones.
  Props:
    operating  ridden coasters among the top 100 operating
#}
{% trans_default_domain 'ranking' %}
{% props operating %}
<section {{ attributes }}>
  <div class="flex items-end justify-between gap-4">
    <div class="min-w-0">
      <h2 class="m-0 font-sans text-body font-semibold">{{ 'top100.title'|trans }}</h2>
      <p class="m-0 text-caption text-muted">{{ 'top100.caption'|trans }}</p>
    </div>
    <p class="m-0 shrink-0 pe-1 font-display leading-none font-extrabold whitespace-nowrap italic">
      <span class="text-title tabular-nums">{{ operating }}</span><span class="text-lead text-muted"> / 100</span>
    </p>
  </div>
  {# mx-0.5: the slanted corners stay inside the column #}
  <div class="relative mx-0.5 mt-2 h-3 -skew-x-10 overflow-hidden rounded-xs border-2 border-on-highlight bg-canvas" role="progressbar"
       aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ operating }}" aria-label="{{ 'top100.title'|trans }}">
    {% if operating > 0 %}
      <div class="h-full w-(--progress) border-r-2 border-on-highlight bg-highlight" style="--progress: {{ min(operating, 100) }}%"></div>
    {% endif %}
    {% for notch in [25, 50, 75] %}
      <span class="absolute inset-y-0 w-px bg-on-highlight/30 {{ {25: 'left-1/4', 50: 'left-1/2', 75: 'left-3/4'}[notch] }}" aria-hidden="true"></span>
    {% endfor %}
  </div>
</section>
