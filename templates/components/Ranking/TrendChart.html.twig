{#
  Growth of the ranking's monthly totals (App\Twig\Components\Ranking\TrendChart): a metric switch and one line chart per metric
  (the checked radio shows its chart). A trend, not a data table: no per-month readout.
  Props:
    history  RankingRepository::findTotalsHistory()
#}
{% trans_default_domain 'ranking' %}
{% set labels = {
  ratingNumber: 'info.ratings',
  userNumber: 'info.users',
  rankedCoasterNumber: 'info.coasters_ranked.long',
  comparisonNumber: 'info.comparisons.long',
} %}
{% set short = labels|merge({
  rankedCoasterNumber: 'info.coasters_ranked.short',
  comparisonNumber: 'info.comparisons.short',
}) %}
{# Literal class strings, so Tailwind generates them. #}
{% set shown = {
  ratingNumber: 'group-has-[[value=ratingNumber]:checked]/trend:block',
  userNumber: 'group-has-[[value=userNumber]:checked]/trend:block',
  rankedCoasterNumber: 'group-has-[[value=rankedCoasterNumber]:checked]/trend:block',
  comparisonNumber: 'group-has-[[value=comparisonNumber]:checked]/trend:block',
} %}
{% set series = this.series %}
{# Unique per instance, so two charts on a page keep separate radio groups #}
{% set name = 'trend-metric-' ~ random() %}
<div {{ attributes.defaults({class: 'group/trend'}) }}>
  {# One row, like the units toggle; scrolls sideways if a locale's labels don't fit. #}
  <fieldset class="m-0 flex gap-1 overflow-x-auto rounded-pill bg-subtle p-1 [scrollbar-width:none]">
    <legend class="sr-only">{{ 'trend.metric'|trans }}</legend>
    {% for metric in series|keys %}
      <label class="relative m-0 flex min-h-11 flex-1 shrink-0 cursor-pointer items-center justify-center rounded-pill px-3 text-caption font-semibold whitespace-nowrap text-muted-strong has-checked:bg-surface has-checked:text-ink has-checked:shadow-raised has-focus-visible:outline-3 has-focus-visible:-outline-offset-3 has-focus-visible:outline-focus">
        <input type="radio" name="{{ name }}" value="{{ metric }}" class="sr-only" {{ loop.first ? 'checked' }}>
        {{ short[metric]|trans }}
      </label>
    {% endfor %}
  </fieldset>

  {% for metric, data in series %}
    <figure class="m-0 mt-4 hidden {{ shown[metric] }}">
      <figcaption class="sr-only">{{ labels[metric]|trans }}</figcaption>
      <div class="flex gap-2">
        {# Y axis: max, half, 0 #}
        <div class="relative w-10 shrink-0 text-caption text-muted tabular-nums" aria-hidden="true">
          {% for tick in data.ticks %}
            <span class="absolute right-0 -translate-y-1/2 {{ loop.first ? 'top-0' : (loop.last ? 'top-full' : 'top-1/2') }}">{{ tick }}</span>
          {% endfor %}
        </div>
        <div class="relative h-48 min-w-0 flex-1 sm:h-64"
             role="img" aria-label="{{ labels[metric]|trans }}: {{ data.values|first|format_number }} → {{ data.values|last|format_number }}">
          <svg viewBox="0 0 1000 300" preserveAspectRatio="none" class="absolute inset-0 size-full overflow-visible" aria-hidden="true">
            {% for y in [0, 150, 300] %}
              <line x1="0" x2="1000" y1="{{ y }}" y2="{{ y }}" class="stroke-line" stroke-width="1" vector-effect="non-scaling-stroke"/>
            {% endfor %}
            <polyline points="{{ data.points }}" fill="none" class="stroke-action" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
          </svg>
        </div>
      </div>
      <div class="relative ms-12 mt-2 h-5 text-caption text-muted" aria-hidden="true">
        {% for year in this.years %}
          <span class="absolute left-(--x) -translate-x-1/2" style="--x: {{ year.x }}%">{{ year.year }}</span>
        {% endfor %}
      </div>
    </figure>
  {% endfor %}
</div>
