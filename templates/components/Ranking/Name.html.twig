{#
  Coaster name with the ridden mark after it, glued to the last word (and centered on it) so it never wraps alone.
  Props:
    coaster  Coaster
    ridden   signed-in rider has ridden it
    clamp    cut at two lines (narrow podium cards); chart rows show the full name, or the mark would be cut with it
#}
{% props coaster, ridden = false, clamp = true %}
{% set words = coaster.name|split(' ') %}
<span {{ attributes.defaults({class: (clamp ? 'line-clamp-2 ' : 'block ') ~ 'font-semibold'}) }}>
  {%- if ridden -%}
    {# flex-wrap only kicks in when a single word is wider than the box (narrow podium cards) #}
    {{ words|slice(0, -1)|join(' ') }} <span class="inline-flex max-w-full flex-wrap items-center gap-x-1"><span class="min-w-0 break-words">{{ words|last }}</span><twig:Ranking:RiddenMark :coaster="coaster"/></span>
  {%- else -%}
    {{ coaster.name }}
  {%- endif -%}
</span>
