{#
  One chart row (#4 and down; #2/#3 while the cover shows #1 alone): position with its movement (or, in a filtered list, the world rank) underneath, 8:7 thumbnail (a touch taller than 4:3, level with three lines of text),
  name with its ridden mark, park, manufacturer. The row sits on the ledger's grid through subgrid (results.html.twig), which declares the
  columns; once the ledger is 48rem wide the manufacturer, the country and the score are columns under its headings.
  Props:
    coaster   Coaster
    position  number shown (the world rank, or the position in a filtered list)
    month     current ranking date (Ranking:Movement)
    ridden    signed-in rider has ridden it
    filtered  filtered list: the world rank replaces the movement
#}
{% trans_default_domain 'ranking' %}
{% props coaster, position, month, ridden = false, filtered = false %}
{% set column = 'hidden min-w-0 truncate @3xl/ledger:block' %}
<li {{ attributes.defaults({class: 'col-span-full grid grid-cols-subgrid'}) }}>
  {# Below sm the ledger runs edge to edge (results.html.twig), so the row takes the page gutter as its padding #}
  <a href="{{ path('show_coaster', {id: coaster.id, slug: coaster.slug}) }}" class="col-span-full grid min-h-18 grid-cols-subgrid items-center px-gutter py-2.5 text-ink -outline-offset-3 hover:bg-subtle sm:px-3">
    {# At least 48px, so one- and two-digit pages keep a steady column; wider ranks widen it for every row #}
    <span class="flex min-w-12 flex-col items-center gap-1">
      <span class="pe-0.5 livery-type text-heading leading-none text-mark tabular-nums">{{ position }}</span>
      {% if filtered %}
        <twig:Ranking:WorldRank :coaster="coaster"/>
      {% else %}
        <twig:Ranking:Movement :coaster="coaster" :month="month" class="font-sans"/>
      {% endif %}
    </span>
    <twig:Thumb :image="coaster.mainImage"/>
    <span class="min-w-0">
      <twig:Ranking:Name :coaster="coaster" :ridden="ridden" :clamp="false" class="leading-tight"/>
      <twig:Ranking:Place :coaster="coaster" class="mt-0.5"/>
    </span>
    <span class="{{ column }} text-muted-strong">{{ coaster.manufacturer.name ?? '' }}</span>
    <span class="{{ column }} text-muted-strong">{{ coaster.park.country|vocab_label }}</span>
    <span class="{{ column }} pe-0.5 text-end livery-type text-xl leading-none tabular-nums">
      {% if coaster.score is not null %}
        <span class="sr-only">{{ 'columns.score'|trans }}</span>
        {{ (coaster.score / 100)|format_number({min_fraction_digit: 1, max_fraction_digit: 1}, style: 'percent') }}
      {% endif %}
    </span>
  </a>
</li>
