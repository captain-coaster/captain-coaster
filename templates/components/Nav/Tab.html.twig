{#
  One tab of Nav:TabBar: a link, or a button when it opens something (pass
  data-action/aria-* through attributes, and no href).
  Props:
    label, icon, href
    user    shows this user's avatar instead of the icon
    active  current section
    badge   unread count on the icon, 0 hides it
#}
{% props label, icon = null, href = null, user = null, active = false, badge = 0 %}
{% set tag = href ? 'a' : 'button' %}
<{{ tag }}
  {% if href %}href="{{ href }}"{% else %}type="button"{% endif %}
  {% if active %}aria-current="page"{% endif %}
  {{ attributes.defaults({class: 'relative flex h-full min-w-0 flex-col items-center justify-center gap-0.5 rounded-card px-0.5 text-on-brand-muted -outline-offset-3 hover:text-on-brand focus-visible:outline-highlight aria-[current=page]:text-highlight aria-[current=page]:after:absolute aria-[current=page]:after:bottom-0.5 aria-[current=page]:after:h-0.75 aria-[current=page]:after:w-6 aria-[current=page]:after:-skew-x-20 aria-[current=page]:after:bg-highlight'}) }}>
  <span class="relative grid size-6 place-items-center">
    {% if user %}
      <twig:Avatar :user="user" size="2xs" decorative/>
    {% else %}
      {{ ux_icon(icon, {class: 'size-6', 'aria-hidden': 'true'}) }}
    {% endif %}
    {% if badge > 0 %}
      <span class="absolute -top-1.5 -right-2.5 grid h-5 min-w-5 place-items-center rounded-pill border-2 border-brand bg-highlight px-1 text-label leading-none font-semibold text-on-highlight">
        {{ badge > 99 ? '99+' : badge }}<span class="sr-only"> {{ 'notif.title'|trans({}, 'notification') }}</span>
      </span>
    {% endif %}
  </span>
  {# Never truncated or wrapped: text-label keeps the longest one ("Classement") on one line at 360px; narrower
     screens (and 200% zoom) get the icons alone, like the bar while scrolling. #}
  <span class="max-w-full text-center text-label font-semibold whitespace-nowrap group-data-compact/bar:sr-only max-xs:sr-only">{{ label }}</span>
</{{ tag }}>
