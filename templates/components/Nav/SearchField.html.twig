{#
  Quick search over coasters, parks and riders (search_controller.js), used
  in the desktop header and in the mobile search dialog.
  Props:
    id  unique input id
#}
{% props id %}
<form action="{{ path('search_index') }}" method="get" role="search" {{ attributes.defaults({class: 'w-full'}) }}>
  <div class="group relative"
       data-controller="search"
       data-search-search-url-value="{{ path('api_search') }}"
       data-search-results-url-value="{{ path('search_index') }}">
    <label for="{{ id }}" class="sr-only">{{ 'app.search.label'|trans }}</label>
    {{ ux_icon('heroicons:magnifying-glass', {class: 'pointer-events-none absolute top-1/2 left-3 size-5 -translate-y-1/2 text-muted', 'aria-hidden': 'true'}) }}
    <input id="{{ id }}"
           name="query"
           type="search"
           enterkeyhint="search"
           class="h-11 w-full appearance-none rounded-control border border-control-line bg-surface pr-11 pl-10 text-body text-ink placeholder:text-muted focus:border-action focus:outline-2 focus:outline-offset-0 focus:outline-action [&::-webkit-search-cancel-button]:hidden"
           placeholder="{{ 'app.header.search'|trans }}"
           data-search-target="input"
           data-action="input->search#handleInput keydown->search#handleKeydown focus->search#handleFocus"
           autocomplete="off"
           role="combobox"
           aria-expanded="false"
           aria-autocomplete="list"
           aria-haspopup="listbox">
    <button type="button"
            class="absolute top-1/2 right-1 hidden size-9 -translate-y-1/2 place-items-center rounded-full text-muted hover:bg-subtle hover:text-ink group-data-has-content:grid"
            data-action="click->search#clearSearch"
            aria-label="{{ 'app.search.clear'|trans }}">
      {{ ux_icon('heroicons:x-mark', {class: 'size-5'}) }}
    </button>
    {# Rows are rendered by search_controller.js and still styled by search.css. #}
    <div class="absolute inset-x-0 top-full z-50 mt-1 hidden overflow-hidden rounded-card border border-line bg-surface shadow-overlay [&.show]:block"
         data-search-target="dropdown"
         role="listbox"
         aria-label="{{ 'app.search.suggestions'|trans }}">
      <div data-search-target="results"></div>
    </div>
  </div>
</form>
