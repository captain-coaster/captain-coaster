{#
  Brand bar. Mobile: head mark and name, plus notifications or sign-in;
  scrolls away (Nav:TabBar is the navigation). Desktop: sticky, with the
  main links, quick search and account.
  Props:
    section  active section, see Nav:TabBar
#}
{% props section = null %}
{% set signed_in = is_granted('IS_AUTHENTICATED_REMEMBERED') %}
{% set unread = signed_in ? unread_notification_count() : 0 %}
{% set link = 'inline-flex h-10 items-center rounded-pill px-4 font-semibold text-muted-strong hover:bg-subtle hover:text-ink aria-[current=page]:bg-selected aria-[current=page]:text-action' %}
<header {{ attributes.defaults({class: 'border-b border-line bg-surface md:sticky md:top-0 md:z-40'}) }}>
  <div class="mx-auto flex h-14 max-w-content items-center gap-3 px-gutter md:h-16 md:gap-6">
    <twig:Nav:Brand/>

    <nav aria-label="{{ 'nav.label'|trans }}" class="hidden md:block">
      <ul class="m-0 flex list-none gap-1 p-0">
        <li><a href="{{ path('default_index') }}" class="{{ link }}" {% if section == 'home' %}aria-current="page"{% endif %}>{{ 'nav.home'|trans }}</a></li>
        <li><a href="{{ path('ranking_index') }}" class="{{ link }}" {% if section == 'ranking' %}aria-current="page"{% endif %}>{{ 'nav.ranking'|trans }}</a></li>
        <li><a href="{{ path('map_index') }}" class="{{ link }}" {% if section == 'map' %}aria-current="page"{% endif %}>{{ 'nav.map'|trans }}</a></li>
      </ul>
    </nav>

    <twig:Nav:SearchField id="search-header" class="hidden max-w-md flex-1 md:block"/>

    <div class="ml-auto flex shrink-0 items-center gap-1">
      {% if signed_in %}
        {# Mobile: notifications (the account lives in the Profile tab). #}
        <a href="{{ path('notification_index') }}"
           class="relative -mr-2 grid size-11 place-items-center rounded-full text-muted-strong hover:bg-subtle hover:text-ink md:hidden"
           aria-label="{{ 'notif.title'|trans({}, 'notification') }}{% if unread > 0 %} ({{ unread }}){% endif %}">
          {{ ux_icon('heroicons:bell', {class: 'size-6', 'aria-hidden': 'true'}) }}
          {% if unread > 0 %}
            <span class="absolute top-1 right-0.5 grid h-5 min-w-5 place-items-center rounded-pill bg-highlight px-1 text-caption leading-none font-semibold text-on-highlight" aria-hidden="true">{{ unread > 99 ? '99+' : unread }}</span>
          {% endif %}
        </a>
        <button type="button"
                popovertarget="account-menu"
                class="relative -m-1 hidden rounded-full p-1 hover:bg-subtle md:grid"
                aria-label="{{ 'nav.account'|trans }}{% if unread > 0 %}, {{ 'notif.title'|trans({}, 'notification') }} ({{ unread }}){% endif %}">
          <twig:Avatar :user="app.user" size="sm" decorative/>
          {% if unread > 0 %}
            <span class="absolute -top-0.5 -right-0.5 grid h-5 min-w-5 place-items-center rounded-pill bg-highlight px-1 text-caption leading-none font-semibold text-on-highlight" aria-hidden="true">{{ unread > 99 ? '99+' : unread }}</span>
          {% endif %}
        </button>
      {% else %}
        <a href="{{ path('login') }}" class="-mr-2 inline-flex h-11 items-center rounded-control px-3 font-semibold text-action hover:bg-subtle md:mr-0 md:bg-action md:px-5 md:text-on-action md:hover:bg-action-hover">{{ 'nav.sign_in'|trans }}</a>
      {% endif %}
    </div>
  </div>
</header>
