{#
  Desktop navigation (lg and up; Nav:TabBar below): logo, main links, quick
  search, and the avatar leading to Profile.
  Props:
    section  active section, see Nav:TabBar
#}
{% props section = null %}
{% set signed_in = is_granted('IS_AUTHENTICATED_REMEMBERED') %}
{% set unread = signed_in ? unread_notification_count() : 0 %}
{% set link = 'relative inline-flex h-16 items-center px-3 font-semibold text-on-brand-muted hover:text-on-brand focus-visible:outline-highlight aria-[current=page]:text-on-brand aria-[current=page]:after:absolute aria-[current=page]:after:inset-x-3 aria-[current=page]:after:bottom-2 aria-[current=page]:after:h-1 aria-[current=page]:after:-skew-x-20 aria-[current=page]:after:bg-highlight' %}
<header {{ attributes.defaults({class: 'sticky top-0 z-40 hidden border-b border-white/14 bg-brand text-on-brand lg:block', 'data-brand': true}) }}>
  <div class="mx-auto flex h-16 max-w-content items-center gap-6 px-gutter">
    <twig:Nav:Brand/>

    <nav aria-label="{{ 'nav.label'|trans }}">
      <ul class="m-0 flex list-none p-0">
        <li><a href="{{ path('default_index') }}" class="{{ link }}" {% if section == 'home' %}aria-current="page"{% endif %}>{{ 'nav.home'|trans }}</a></li>
        <li><a href="{{ path('ranking_index') }}" class="{{ link }}" {% if section == 'ranking' %}aria-current="page"{% endif %}>{{ 'nav.ranking'|trans }}</a></li>
        <li><a href="{{ path('map_index') }}" class="{{ link }}" {% if section == 'map' %}aria-current="page"{% endif %}>{{ 'nav.map'|trans }}</a></li>
      </ul>
    </nav>

    <twig:Nav:SearchField id="search-header" shortcut brand class="max-w-md flex-1"/>

    <div class="ml-auto shrink-0">
      {% if signed_in %}
        <a href="{{ path('profile') }}"
           class="relative -m-1 grid rounded-full p-1 hover:bg-white/14 focus-visible:outline-highlight aria-[current=page]:bg-white/14"
           {% if section == 'profile' %}aria-current="page"{% endif %}
           aria-label="{{ 'nav.profile'|trans }}{% if unread > 0 %}, {{ 'notif.title'|trans({}, 'notification') }} ({{ unread }}){% endif %}">
          <twig:Avatar :user="app.user" size="sm" class="ring-2 ring-white" decorative/>
          {% if unread > 0 %}
            <span class="absolute -top-0.5 -right-0.5 grid h-5 min-w-5 place-items-center rounded-pill border-2 border-brand bg-highlight px-1 text-label leading-none font-semibold text-on-highlight" aria-hidden="true">{{ unread > 99 ? '99+' : unread }}</span>
          {% endif %}
        </a>
      {% else %}
        {# A quiet pill, like the search field on brand #}
        <a href="{{ path('login') }}" class="inline-flex h-11 items-center gap-2 rounded-pill bg-white/12 pr-4.5 pl-3.5 font-semibold text-on-brand hover:bg-white/20 hover:text-on-brand focus-visible:outline-highlight">
          {{ ux_icon('lucide:user', {class: 'size-5', 'aria-hidden': 'true'}) }}
          {{ 'nav.sign_in'|trans }}
        </a>
      {% endif %}
    </div>
  </div>
</header>
