{#
  Language and units. Language is a native select (navigate_controller.js
  follows the chosen URL); units a two-option toggle of links. Both reload
  the current page with setLocale / setUnits.
  Props:
    variant  rows: settings rows on the Profile page | stack: labelled controls (footer)
#}
{% props variant = 'stack' %}
{# Error pages are rendered from a sub-request with _route/_route_params stripped, so both need a fallback. #}
{% set route = app.request.attributes.get('_route')|default('default_index') %}
{% set params = (app.request.attributes.get('_route_params')|default({})|merge(app.request.query.all))|filter((value, key) => key not in ['setLocale', 'setUnits']) %}
{% set imperial = units.isImperial() %}
{% set uid = random() %}
{% set rows = variant == 'rows' %}
{% set field = rows ? 'flex min-h-14 items-center justify-between gap-4 px-4' : 'grid gap-1.5' %}
{% set label = rows ? 'text-ink' : 'text-caption font-semibold text-muted' %}
{% set option = 'inline-flex h-9 items-center rounded-pill px-3 text-caption font-semibold text-muted-strong hover:text-ink aria-[current=true]:bg-surface aria-[current=true]:text-ink aria-[current=true]:shadow-raised' %}
<div {{ attributes.defaults({class: rows ? 'grid divide-y divide-subtle overflow-hidden rounded-card bg-surface' : 'grid content-start gap-5'}) }}>
  <div class="{{ field }}">
    <label for="pref-language-{{ uid }}" class="{{ label }}">{{ 'nav.language'|trans }}</label>
    <div class="relative {{ rows ? '' : 'justify-self-start' }}">
      <select id="pref-language-{{ uid }}"
              data-controller="navigate" data-action="navigate#go"
              class="h-10 appearance-none rounded-control border border-control-line bg-surface pr-9 pl-3 text-body text-ink hover:border-ink focus:outline-3 focus:outline-offset-3 focus:outline-focus">
        {% for locale in locales %}
          <option value="{{ path(route, params|merge({_locale: locale, setLocale: 1})) }}" lang="{{ locale }}" {% if locale == app.request.locale %}selected{% endif %}>{{ locale|trans }}</option>
        {% endfor %}
      </select>
      {{ ux_icon('heroicons:chevron-down', {class: 'pointer-events-none absolute top-1/2 right-3 size-4 -translate-y-1/2 text-muted', 'aria-hidden': 'true'}) }}
    </div>
  </div>
  <div class="{{ field }}">
    <p class="m-0 {{ label }}" id="pref-units-{{ uid }}">{{ 'nav.units'|trans }}</p>
    <ul class="m-0 flex list-none gap-1 justify-self-start rounded-pill bg-subtle p-1" aria-labelledby="pref-units-{{ uid }}">
      <li><a href="{{ path(route, params|merge({setUnits: 'metric'})) }}" class="{{ option }}" aria-current="{{ imperial ? 'false' : 'true' }}" aria-label="{{ 'profile.settings.preferences.units.metric'|trans }}">km/h · m</a></li>
      <li><a href="{{ path(route, params|merge({setUnits: 'imperial'})) }}" class="{{ option }}" aria-current="{{ imperial ? 'true' : 'false' }}" aria-label="{{ 'profile.settings.preferences.units.imperial'|trans }}">mph · ft</a></li>
    </ul>
  </div>
</div>
