{#
  Language and units, side by side on the brand surface (footer). Language
  is a native select (navigate_controller.js follows the chosen URL); units
  a two-option toggle of links. Both reload the current page with
  setLocale / setUnits.
#}
{# Error pages are rendered from a sub-request with _route/_route_params stripped, so both need a fallback. #}
{% set route = app.request.attributes.get('_route')|default('default_index') %}
{% set params = (app.request.attributes.get('_route_params')|default({})|merge(app.request.query.all))|filter((value, key) => key not in ['setLocale', 'setUnits']) %}
{% set imperial = units.isImperial() %}
{# A 36px pill in the 44px track; its hit area fills the track's height. #}
{% set option = 'relative inline-flex h-9 items-center rounded-pill px-3 text-caption font-semibold text-on-brand-muted after:absolute after:inset-x-0 after:-inset-y-1 hover:text-on-brand focus-visible:outline-highlight aria-[current=true]:bg-surface aria-[current=true]:text-ink aria-[current=true]:shadow-raised aria-[current=true]:hover:text-ink' %}
<div {{ attributes.defaults({class: 'flex flex-wrap items-center gap-3'}) }}>
  <div>
    <label for="pref-language" class="sr-only">{{ 'nav.language'|trans }}</label>
    <div class="relative flex h-11 items-center gap-2 rounded-pill bg-white/12 pr-3 pl-3.5 font-semibold text-on-brand hover:bg-white/20 has-[select:focus-visible]:outline-3 has-[select:focus-visible]:outline-offset-3 has-[select:focus-visible]:outline-highlight">
      {{ ux_icon('lucide:languages', {class: 'size-5 text-on-brand-muted', 'aria-hidden': 'true'}) }}
      <span>{{ app.request.locale|trans }}</span>
      {{ ux_icon('lucide:chevron-down', {class: 'size-4 text-on-brand-muted', 'aria-hidden': 'true'}) }}
      {# The native select sits invisibly over its visible value, so the platform picker opens on tap.
         Its own colors: the picker's options inherit them, not the brand surface's white text. #}
      <select id="pref-language"
              data-controller="navigate" data-action="navigate#go"
              class="absolute inset-0 size-full cursor-pointer appearance-none bg-surface text-body text-ink opacity-0">
        {% for locale in locales %}
          <option value="{{ path(route, params|merge({_locale: locale, setLocale: 1})) }}" lang="{{ locale }}" {% if locale == app.request.locale %}selected{% endif %}>{{ locale|trans }}</option>
        {% endfor %}
      </select>
    </div>
  </div>
  <div>
    <p class="sr-only" id="pref-units">{{ 'nav.units'|trans }}</p>
    <ul class="m-0 flex list-none gap-1 rounded-pill bg-white/12 p-1" aria-labelledby="pref-units">
      <li><a href="{{ path(route, params|merge({setUnits: 'metric'})) }}" rel="nofollow" class="{{ option }}" aria-current="{{ imperial ? 'false' : 'true' }}" aria-label="{{ 'units.metric'|trans }}">km/h · m</a></li>
      <li><a href="{{ path(route, params|merge({setUnits: 'imperial'})) }}" rel="nofollow" class="{{ option }}" aria-current="{{ imperial ? 'true' : 'false' }}" aria-label="{{ 'units.imperial'|trans }}">mph · ft</a></li>
    </ul>
  </div>
</div>
