{# Opens the filter panel below md (Includes/filter_sidebar.html.twig); from md up the panel is always shown. A Page:Header action. #}
<button type="button"
        data-action="sidebar#toggleMobileSecondary"
        aria-expanded="false"
        aria-label="{{ 'nav.filters'|trans }}"
        {{ attributes.defaults({class: 'grid size-11 shrink-0 place-items-center rounded-full bg-surface/75 text-ink shadow-raised backdrop-blur-xl hover:bg-surface aria-expanded:bg-selected aria-expanded:text-action md:hidden'}) }}>
  {{ ux_icon('heroicons:adjustments-horizontal', {class: 'size-5', 'aria-hidden': 'true'}) }}
</button>
