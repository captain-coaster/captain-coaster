{# Opens the filter bottom sheet below md (<twig:FilterPanel>); from md up the panel is always shown. A Page:Header action.
   A sunshine dot with an ink edge marks it while a filter is on: a checked switch or a select off its empty choice (CSS only). #}
<twig:RoundButton icon="lucide:funnel"
                  label="{{ 'nav.filters'|trans }}"
                  data-action="filter-sheet#open"
                  aria-haspopup="dialog"
                  aria-controls="filter-sheet"
                  class="{{ ("relative after:absolute after:top-0 after:right-0 after:hidden after:size-3.5 after:rounded-full after:border-2 after:border-on-highlight after:bg-highlight in-[body:has(#form-filter_:checked:not([value='']))]:after:block md:hidden " ~ attributes.render('class'))|tailwind_merge }}"
                  {{ ...attributes.without('class') }}/>
