{#
  Park Progress Bar — visualises the user's progress through a park's
  *operating* coasters (closed/relocated coasters can't be ridden, so we
  exclude them — otherwise 100% completion would be unreachable).

  Single full-width segmented bar, 3 segments:
    · Rated      (dark green)  — ridden AND rated
    · Not rated  (light green) — ridden but not yet rated → encourages rating
    · Not ridden (grey track)  — operating coasters left to discover

  A bonus line below the legend shows legacy (non-operating) coasters ridden.

  Props:
    - stats (required): array{rated: int, ridden: int, notRated: int, notRidden: int, operatingTotal: int, legacyRidden: int}

  Usage:
    <twig:ParkProgressBar :stats="parkStats" />
#}
{% props stats %}

{% set rated = stats.rated %}
{% set ridden = stats.ridden %}
{% set notRated = stats.notRated %}
{% set notRidden = stats.notRidden %}
{% set operatingTotal = stats.operatingTotal %}
{% set legacyRidden = stats.legacyRidden ?? 0 %}

{% set total = operatingTotal > 0 ? operatingTotal : 1 %}
{% set ratedPct = rated / total * 100 %}
{% set notRatedPct = notRated / total * 100 %}
{% set completionPct = (ridden / total * 100)|round %}

<section class="bg-surface rounded-2xl border border-line p-4 mb-6">

  {# ── Header ────────────────────────────────────────────────────────── #}
  <div class="flex items-center justify-between mb-3">
    <h2 class="text-sm font-semibold text-content inline-flex items-center gap-1.5">
      {{ ux_icon('tabler:target-arrow', {'class': 'w-4 h-4 text-cc-blue-500', 'aria-hidden': 'true'}) }}
      {{ 'park.progress.title'|trans }}
    </h2>
    <div class="text-sm font-bold text-content tabular-nums">
      {{ ridden }}<span class="text-content-muted font-normal">/{{ operatingTotal }}</span>
      <span class="ml-1 text-xs font-medium text-content-muted">({{ completionPct }}%)</span>
    </div>
  </div>

  {# ── The progress bar ──────────────────────────────────────────────── #}
  <div class="flex h-3 rounded-full overflow-hidden bg-surface-strong" role="img"
       aria-label="{{ 'park.progress.aria'|trans({
         'rated': rated,
         'ridden': ridden,
         'total': operatingTotal,
       }) }}">
    {% if ratedPct > 0 %}
      <div class="bg-green-600 dark:bg-green-500 transition-all"
           style="width: {{ ratedPct }}%"
           title="{{ 'park.stats.rated'|trans }} — {{ rated }}"></div>
    {% endif %}
    {% if notRatedPct > 0 %}
      <div class="bg-green-300 dark:bg-green-400/70 transition-all"
           style="width: {{ notRatedPct }}%"
           title="{{ 'park.stats.not_rated'|trans }} — {{ notRated }}"></div>
    {% endif %}
  </div>

  {# ── Legend (3 cells) ──────────────────────────────────────────────── #}
  <div class="grid grid-cols-3 gap-x-3 gap-y-1.5 mt-3">
    <div class="flex items-center gap-1.5 min-w-0">
      <span class="shrink-0 w-2.5 h-2.5 rounded-full bg-green-600 dark:bg-green-500" aria-hidden="true"></span>
      <span class="text-xs font-semibold text-content tabular-nums">{{ rated }}</span>
      <span class="text-xs text-content-muted truncate">{{ 'park.stats.rated'|trans }}</span>
    </div>
    <div class="flex items-center gap-1.5 min-w-0">
      <span class="shrink-0 w-2.5 h-2.5 rounded-full bg-green-300 dark:bg-green-400/70" aria-hidden="true"></span>
      <span class="text-xs font-semibold text-content tabular-nums">{{ notRated }}</span>
      <span class="text-xs text-content-muted truncate">{{ 'park.stats.not_rated'|trans }}</span>
    </div>
    <div class="flex items-center gap-1.5 min-w-0">
      <span class="shrink-0 w-2.5 h-2.5 rounded-full bg-surface-strong ring-1 ring-line-input" aria-hidden="true"></span>
      <span class="text-xs font-semibold text-content tabular-nums">{{ notRidden }}</span>
      <span class="text-xs text-content-muted truncate">{{ 'park.stats.not_ridden'|trans }}</span>
    </div>
  </div>

  {# ── Smart encouragement message — only for actionable states ─────── #}
  {% if operatingTotal > 0 and ridden == operatingTotal and notRated == 0 %}
    <p class="mt-3 text-xs font-medium text-green-700 dark:text-green-400 inline-flex items-center gap-1.5">
      {{ ux_icon('tabler:trophy', {'class': 'w-4 h-4', 'aria-hidden': 'true'}) }}
      {{ 'park.progress.complete'|trans }}
    </p>
  {% elseif notRated > 0 %}
    <p class="mt-3 text-xs text-content-secondary inline-flex items-center gap-1.5">
      {{ ux_icon('tabler:star', {'class': 'w-4 h-4 text-cc-warm-500 shrink-0', 'aria-hidden': 'true'}) }}
      {{ 'park.progress.encourage_rate'|trans({'count': notRated}) }}
    </p>
  {% endif %}

  {# ── Legacy bonus ──────────────────────────────────────────────────── #}
  {% if legacyRidden > 0 %}
    <p class="mt-2 text-xs text-cc-warm-600 dark:text-cc-warm-400 inline-flex items-center gap-1.5">
      {{ ux_icon('tabler:history', {'class': 'w-3.5 h-3.5 shrink-0', 'aria-hidden': 'true'}) }}
      {{ 'park.progress.legacy_ridden'|trans({'count': legacyRidden}) }}
    </p>
  {% endif %}
</section>
