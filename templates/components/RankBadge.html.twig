{#
  RankBadge — podium-style rank circle (gold #1 / silver #2 / bronze #3 / neutral rest).

  Props:
    - rank (required): int — 1-based rank; ties are allowed (two badges can share a rank)
    - size: 'xs' | 'sm' | 'md' | 'lg' (default 'md')
    - overlay: bool — true when the badge sits on top of an image (uses a translucent
      backdrop-blur rest tier); false (default) for plain card/list contexts
    - hash: bool — prefix the number with "#" (default true)

  Usage:
    <twig:RankBadge :rank="coaster.rank" size="lg" overlay="true" />
#}
{% props rank, size = 'md', overlay = false, hash = true %}

{% set sizeClass = size == 'xs'
  ? 'w-5 h-5 text-[10px]'
  : (size == 'sm'
      ? 'w-7 h-7 text-xs'
      : (size == 'lg'
          ? 'w-9 h-9 sm:w-11 sm:h-11 text-sm sm:text-base'
          : 'w-8 h-8 sm:w-9 sm:h-9 text-xs sm:text-sm')) %}

{% set tierClass = rank == 1
  ? 'bg-cc-warm-500 text-white'
  : (rank == 2
      ? 'bg-neutral-300 text-neutral-800'
      : (rank == 3
          ? 'bg-amber-700 text-white'
          : (overlay
              ? 'bg-neutral-700/70 text-white backdrop-blur-sm'
              : 'bg-surface-muted text-content-tertiary'))) %}

<span class="inline-flex items-center justify-center shrink-0 rounded-full font-bold tabular-nums {{ sizeClass }} {{ tierClass }}">{{ hash ? '#' : '' }}{{ rank }}</span>
