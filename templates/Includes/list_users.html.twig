{% import "helper.html.twig" as helper %}

<ul class="cc-media-list grid grid-cols-12 gap-5">
    {% for user in users %}
        <li class="col-span-12 md:col-span-6 xl:col-span-4">
            <div class="cc-panel__body{% if border %} cc-panel{% endif %}">
                <div class="cc-media">
                    <div class="cc-media__start">
                        <twig:Avatar :user="user.0" decorative/>
                    </div>
                    <div class="cc-media__body">
                        <h6 class="cc-media__heading">
                            <a href="{{ path('user_show', {'slug': user.0.slug}) }}">
                                {{ user.0.displayName }}
                            </a>
                        </h6>
                        <p class="text-muted">
                            {{ 'user_list.member_from'|trans }} {{ helper.displayDate(user.0.createdAt) }}
                        </p>

                        <h5 class="text-semibold m-0">
                            <a href="{{ path('user_ratings', {'id': user.0.id}) }}">
                                {{ 'user_list.rating'|trans({'count': user.total_ratings}) }}
                            </a>
                        </h5>
                    </div>
                </div>
            </div>
        </li>
    {% endfor %}
</ul>
