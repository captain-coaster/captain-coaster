{# Below md a bottom sheet opened by <twig:FilterToggle> (filter_sheet_controller.js); from md the dialog box
   is dropped (display: contents) and the panel is the sticky side column. Filters apply on change, so the sheet's
   footer button only closes it. The fields are FilterType's (FilterService::createFormView()). #}
{% set groups = {
  show: ['status', 'notridden', 'new', 'kiddie', 'sortByDistance'],
  coaster: ['score', 'manufacturer', 'model', 'materialType', 'seatingType', 'openingDate'],
  location: ['continent', 'country'],
} %}
<dialog id="filter-sheet"
        aria-labelledby="filter-sheet-title"
        data-filter-sheet-target="dialog"
        data-action="click->filter-sheet#backdropClose"
        class="m-0 mt-auto max-h-[85dvh] w-full max-w-none translate-y-full flex-col max-md:flex overflow-hidden rounded-t-card bg-surface p-0 text-ink shadow-overlay transition-[translate,display,overlay] transition-discrete duration-250 ease-out max-md:not-open:hidden open:translate-y-0 starting:open:translate-y-full motion-reduce:transition-none backdrop:bg-ink/40 md:contents">
  <div class="flex shrink-0 items-center border-b border-line px-5 py-4 md:hidden">
    <h2 id="filter-sheet-title" tabindex="-1" autofocus class="m-0 text-lead outline-none">{{ 'filters.title'|trans }}</h2>
  </div>
  <div class="min-h-0 flex-auto overflow-y-auto overscroll-contain md:contents">
    {# From md: a 260px column, sticky under Page:Header's compact bar (below lg) or Nav:Header, running the full viewport height. #}
    <div class="w-full bg-surface text-ink md:sticky md:top-bar md:h-[calc(100dvh-var(--spacing-bar))] md:flex-[0_0_260px] md:self-start md:overflow-y-auto md:overscroll-contain md:border-r md:border-line lg:top-header lg:h-[calc(100dvh-var(--spacing-header))]"
         {% if filterConfig is defined %}
           data-controller="filter"
           {% for key, value in filterConfig %}
             {% if key == 'map_outlet' %}
               data-filter-map-outlet="{{ value }}"
             {% elseif key in ['endpoint', 'container_id', 'update_url', 'debounce_delay', 'initial_load'] %}
               data-filter-{{ key|replace({'_': '-'}) }}-value="{{ value }}"
             {% endif %}
           {% endfor %}
         {% endif %}>
      {{ form_start(filterForm, {attr: {id: 'form-filter', class: 'grid gap-8 p-5'}}) }}
        <p class="m-0 text-lead font-semibold max-md:hidden">{{ 'filters.title'|trans }}</p>
        <input type="hidden" name="page" value="1">

        {% if filterForm.name is defined %}
          {{ form_row(filterForm.name) }}
        {% endif %}

        {% for group, names in groups %}
          {% set fields = names|filter(name => filterForm[name] is defined) %}
          {% if fields|length > 0 %}
            <fieldset class="m-0 grid min-w-0 border-0 p-0 {{ group == 'show' ? 'gap-0' : 'gap-3' }}">
              <legend class="p-0 font-semibold {{ group == 'show' ? 'mb-1' : 'mb-3' }}">{{ ('filters.groups.' ~ group)|trans }}</legend>
              {% for name in fields %}
                {{ form_row(filterForm[name]) }}
              {% endfor %}
            </fieldset>
          {% endif %}
        {% endfor %}

        <div>
          <twig:Button variant="text" href="{{ app.request.pathInfo }}">{{ 'filters.clear'|trans }}</twig:Button>
        </div>
      {{ form_end(filterForm) }}
    </div>
  </div>
  <form method="dialog" class="shrink-0 border-t border-line px-5 pt-3 pb-[calc(var(--spacing)*3+env(safe-area-inset-bottom))] md:hidden">
    <button class="h-12 w-full rounded-control bg-action font-semibold text-on-action hover:bg-action-hover">{{ 'filters.show_results'|trans }}</button>
  </form>
</dialog>
