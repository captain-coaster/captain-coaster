<header class="mb-6 border-b border-line bg-surface{% if hideTitle|default(false) == true %} max-md:sr-only{% endif %}">
  <div class="mx-auto max-w-content px-gutter py-6 md:py-8">
    <h1 class="m-0">{{ title }}{% if subTitle %} • {{ subTitle }}{% endif %}</h1>
    {% if secondaryTitle %}
      <h2 class="m-0 mt-1 font-sans text-body font-normal text-muted">{{ secondaryTitle }}</h2>
    {% endif %}
  </div>
</header>
