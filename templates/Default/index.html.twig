{% extends "base.html.twig" %}

{% import "helper.html.twig" as helper %}

{% set openedSidebar = true %}
{% set hideTitle = true %}

{% set title = 'index.title'|trans %}
{% block title %}{{ 'index.header.title'|trans }}{% endblock %}

{% block header %}
  <meta name="description" content="{{ 'index.description'|trans }}"/>
  <meta property="og:title" content="{{ 'app.name'|trans }}"/>
  <meta property="og:type" content="website"/>
  <meta property="og:url" content="{{ app.request.uri }}"/>
  <meta property="og:image" content="{{ absolute_url(asset('images/logo_big.png')) }}"/>
{% endblock %}

{% block body %}
  <!-- info alert -->
  {% if not is_granted('IS_AUTHENTICATED_REMEMBERED') %}
    <div class="cc-alert cc-alert--info cc-alert--styled-left cc-alert--arrow-left cc-alert--component" data-controller="alert">
      <button type="button" class="cc-close" data-action="click->alert#close"><span>&times;</span><span
            class="sr-only">Close</span>
      </button>
      <h6 class="cc-alert--heading text-semibold">
        {{ 'index.header.title'|trans }}
      </h6>
      {{ 'index.header.info'|trans({'%link_path%': path('login')})|raw }}
    </div>
  {% endif %}
  <!-- /info alert -->
  <div class="cc-panel cc-panel__body">
    <div class="grid grid-cols-12 gap-5 text-center">
      <div class="col-span-3">
        <p>{{ ux_icon('heroicons:star', {'class': 'w-5 h-5 display-inline-block text-success'}) }}</p>
        <h5 class="text-semibold m-0">
          {{ stats.nb_ratings|format_number }}
          {% if stats.nb_new_ratings > 0 %}
            <span class="cc-badge bg-warning-400">+{{ stats.nb_new_ratings }}</span>
          {% endif %}
        </h5>
        <span class="text-muted text-size-small">{{ 'index.stats.ratings'|trans }}</span>
      </div>
      <div class="col-span-3">
        <p>{{ ux_icon('heroicons:megaphone', {'class': 'w-5 h-5 display-inline-block text-success'}) }}</p>
        <h5 class="text-semibold m-0">
          <a href="{{ path('review_list') }}">{{ stats.nb_reviews|format_number }}</a>
        </h5>
        <span class="text-muted text-size-small">{{ 'index.stats.reviews'|trans }}</span>
      </div>
      <div class="col-span-3">
        <p>{{ ux_icon('heroicons:user-group', {'class': 'w-5 h-5 display-inline-block text-warning'}) }}</p>
        <h5 class="text-semibold m-0">
          <a href="{{ path('user_list') }}">{{ stats.nb_users|format_number }}</a>
        </h5>
        <span class="text-muted text-size-small">{{ 'index.stats.users'|trans }}</span>
      </div>
      <div class="col-span-3">
        <p>{{ ux_icon('heroicons:camera', {'class': 'w-5 h-5 display-inline-block text-info'}) }}</p>
        <h5 class="text-semibold m-0">{{ stats.nb_images|format_number }}</h5>
        <span class="text-muted text-size-small">{{ 'index.stats.images'|trans }}</span>
      </div>
    </div>
  </div>
  <div class="grid grid-cols-12 gap-5 items-start">
    <div class="col-span-12 tablet:col-span-6">
      {% if hero %}
        {% set heroCoaster = hero.coaster ?? hero.image.coaster %}
        {% set heroImage = hero.image ?? heroCoaster.mainImage %}
        {# Same year-only convention as helper.html.twig's displayDate(): a day/month of Jan 1st
           means only the year is actually known, not a real date -- showing "January 1" would
           claim a precision the data doesn't have. #}
        {% set heroOpeningDisplay = heroCoaster.openingDate
          ? (heroCoaster.openingDate|date('dm') == '0101' ? heroCoaster.openingDate|date('Y') : heroCoaster.openingDate|format_datetime('long', 'none'))
          : null %}
        {# One badge line carries the category *and* its most useful fact (date, or the plain
           status when there's none yet) instead of a separate, half-redundant line below --
           "Under construction / Opening xxx" duplicated the same idea twice. #}
        {% set heroBadgeClass = 'absolute top-3 left-3 inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11.5px] font-bold text-white shadow-[0_2px_6px_rgba(0,0,0,0.25)]' %}
        <a href="{{ path('show_coaster', {'id': heroCoaster.id, 'slug': heroCoaster.slug}) }}" class="group block relative mb-5 overflow-hidden rounded-xl">
          <div class="relative aspect-[16/10] overflow-hidden">
            <img src="{{ pictures_cdn }}/1440x1440/{{ heroImage.filename }}" alt="{{ heroCoaster.name }}"
                 class="block h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]">
            {# Concentrated on the bottom third so the photo itself stays visible. #}
            <div class="absolute inset-0 bg-[linear-gradient(to_top,rgba(0,0,0,0.85)_0%,rgba(0,0,0,0)_45%)]"></div>
          </div>
          {% if hero.type == 'upcoming' %}
            {# Real status (construction or announced) drives both label and color -- see colors.css's [data-status] rules. #}
            <span class="{{ heroBadgeClass }} bg-[var(--status-color)]" data-status="{{ heroCoaster.status.name }}">
              {{ ux_icon(heroCoaster.status.name == 'status.announced' ? 'heroicons:megaphone' : 'heroicons:wrench-screwdriver', {'class': 'w-3.5 h-3.5'}) }}
              {% if heroOpeningDisplay %}
                {{ 'index.hero.opens_on'|trans({'date': heroOpeningDisplay}) }}
              {% else %}
                {{ heroCoaster.status.name|trans([], 'database') }}
              {% endif %}
            </span>
          {% elseif hero.type == 'new' %}
            <span class="{{ heroBadgeClass }} bg-success">
              {{ ux_icon('heroicons:sparkles', {'class': 'w-3.5 h-3.5'}) }}
              {{ 'index.hero.opened_on'|trans({'date': heroOpeningDisplay}) }}
            </span>
          {% elseif hero.type == 'trending' %}
            <span class="{{ heroBadgeClass }} bg-info">
              {{ ux_icon('heroicons:fire', {'class': 'w-3.5 h-3.5'}) }}
              {{ 'index.hero.badge.trending'|trans }}
            </span>
          {% elseif hero.type == 'photo' %}
            <span class="{{ heroBadgeClass }} bg-cc-teal-400">
              {{ ux_icon('heroicons:heart', {'class': 'w-3.5 h-3.5'}) }}
              {{ 'index.hero.badge.photo'|trans }}
            </span>
          {% endif %}
          <div class="absolute inset-x-0 bottom-0 p-4 pt-3.5 text-white">
            <p class="line-clamp-2 text-xl leading-tight font-bold [text-shadow:0_1px_3px_rgba(0,0,0,0.35)]">{{ heroCoaster.name }}</p>
            <div class="mt-0.5 flex items-baseline gap-2">
              <span class="min-w-0 flex-1 truncate text-[12.5px] text-white/80">{{ heroCoaster.park.name }}</span>
              {% if heroImage.credit %}
                <span class="max-w-[45%] flex-none truncate text-[10px] text-white/60">{{ 'image.credit'|trans({'name': heroImage.credit}) }}</span>
              {% endif %}
            </div>
          </div>
        </a>
      {% endif %}
      <!-- latest ratings -->
      <div class="cc-panel cc-panel--flat border-top-cc-teal">
        <div class="cc-panel__heading">
          <h6 class="cc-panel__title">{{ 'rating.last'|trans }}</h6>
        </div>
        <div class="cc-panel__body">
          <ul class="list-feed">
            {% for ratingItem in ratingFeed %}
              <li>
                <a class="text-bold" href="{{ path('user_show', {'slug': ratingItem.user.slug}) }}">
                  {{ ratingItem.user.displayName }}
                </a>
                {{ 'rating.action'|trans({'%value%': ratingItem.value}) }}
                  <a href="{{ path('show_coaster', {'id': ratingItem.coaster.id, 'slug': ratingItem.coaster.slug}) }}">
                  {{ ratingItem.coaster.name }}
                </a>
                <div class="text-muted">
                  {{ ratingItem.updatedAt|ago }}
                </div>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
      <!-- /latests ratings -->
    </div>
    <div class="col-span-12 tablet:col-span-6">
      <!-- latest reviews -->
      <div class="cc-panel cc-panel--flat">
        <div class="cc-panel__heading">
          <h6 class="cc-panel__title text-semibold">
            {{ ux_icon('heroicons:chat-bubble-left', {'class': 'w-4 h-4 position-left'}) }}
            {{ 'review.last'|trans }}
          </h6>
          <div class="heading-elements">
            <a href="{{ path('review_list') }}" class="heading-text">
              {{ ux_icon('heroicons:arrow-right', {'class': 'w-4 h-4 position-right'}) }}
              {{ 'review.all'|trans }}
            </a>
          </div>
        </div>

        <div class="cc-panel__body">
          <ul class="cc-media-list cc-media-list--bordered cc-media-list--stack-mobile reviews-list">
            {% for review in reviews %}
              <li class="review-list-item">
                <div class="review-coaster-info">
                  <h6 class="cc-media__heading text-semibold">
                    <a href="{{ path('show_coaster', {'id': review.coaster.id, 'slug': review.coaster.slug}) }}">
                      {{ review.coaster.name }}
                    </a>
                    -
                    <a href="{{ path('park_show', {'id': review.coaster.park.id, 'slug': review.coaster.park.slug}) }}">
                      {{ review.coaster.park.name }}
                    </a>
                  </h6>
                </div>
                {% include 'Includes/_review_item.html.twig' with {'review': review, 'preferredReviewLanguages': preferredReviewLanguages, 'stackOnMobile': true} %}
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
      <!-- /latest reviews -->
    </div>
  </div>
{% endblock %}

{% block javascripts %}
  <script>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js', {scope: '/'}).then(function() {
        console.log('Service Worker Registered');
      }).catch(function(e) {
        console.log('Error during Service Worker registration : ', e);
      });
    }
  </script>
{% endblock %}
