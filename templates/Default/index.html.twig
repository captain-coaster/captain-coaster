{% extends "base.html.twig" %}

{% import "helper.html.twig" as helper %}

{% set hideTitle = true %}

{% set title = 'index.header.title'|trans %}
{% block title %}{{ 'index.header.title'|trans }}{% endblock %}

{% block header %}
  <meta name="description" content="{{ 'index.description'|trans }}"/>
  <meta property="og:title" content="{{ 'app.name'|trans }}"/>
  <meta property="og:type" content="website"/>
  <meta property="og:url" content="{{ app.request.uri }}"/>
  <meta property="og:image" content="{{ absolute_url(asset('build/images/logo_big.png')) }}"/>
{% endblock %}

{% block body %}
  {# Below lg Home is the one page carrying the logo (Nav:Header shows it from lg). #}
  <twig:Nav:Brand class="mt-6 mb-6 lg:hidden"/>
  <!-- info alert -->
  {% if not is_granted('IS_AUTHENTICATED_REMEMBERED') %}
    <div class="cc-alert cc-alert--info cc-alert--styled-left cc-alert--arrow-left cc-alert--component" data-controller="alert">
      <button type="button" class="cc-close" data-action="click->alert#close"><span>&times;</span><span
            class="sr-only">Close</span>
      </button>
      <h6 class="cc-alert--heading text-semibold">
        {{ 'index.header.title'|trans }}
      </h6>
      {{ 'index.header.info'|trans({'%link_path%': path('login')})|raw }}
    </div>
  {% endif %}
  <!-- /info alert -->
  <div class="cc-panel cc-panel__body">
    <div class="grid grid-cols-12 gap-5 text-center">
      <div class="col-span-3">
        <p>{{ ux_icon('lucide:star', {'class': 'size-5 text-action'}) }}</p>
        <h5 class="text-semibold m-0">
          {{ stats.nb_ratings|format_number }}
          {% if stats.nb_new_ratings > 0 %}
            <span class="cc-badge cc-badge--primary">+{{ stats.nb_new_ratings }}</span>
          {% endif %}
        </h5>
        <span class="text-muted text-size-small">{{ 'index.stats.ratings'|trans }}</span>
      </div>
      <div class="col-span-3">
        <p>{{ ux_icon('lucide:message-square-text', {'class': 'size-5 text-action'}) }}</p>
        <h5 class="text-semibold m-0">
          <a href="{{ path('review_list') }}">{{ stats.nb_reviews|format_number }}</a>
        </h5>
        <span class="text-muted text-size-small">{{ 'index.stats.reviews'|trans }}</span>
      </div>
      <div class="col-span-3">
        <p>{{ ux_icon('lucide:users', {'class': 'size-5 text-action'}) }}</p>
        <h5 class="text-semibold m-0">
          <a href="{{ path('user_list') }}">{{ stats.nb_users|format_number }}</a>
        </h5>
        <span class="text-muted text-size-small">{{ 'index.stats.users'|trans }}</span>
      </div>
      <div class="col-span-3">
        <p>{{ ux_icon('lucide:image', {'class': 'size-5 text-info'}) }}</p>
        <h5 class="text-semibold m-0">{{ stats.nb_images|format_number }}</h5>
        <span class="text-muted text-size-small">{{ 'index.stats.images'|trans }}</span>
      </div>
    </div>
  </div>
  <div class="grid grid-cols-12 gap-5 items-start">
    <div class="col-span-12 md:col-span-6">
      {% if hero %}
        {# One badge line, just the plain status -- no opening date shown here (#392 tracks a
           proper partial-date precision fix; showing one from a possibly-fake Jan-1
           placeholder isn't worth patching around with another heuristic in the meantime). #}
        {% set heroBadgeClass = 'absolute top-3 left-3 inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-caption font-bold text-white shadow-raised' %}
        <a href="{{ path('show_coaster', {'id': hero.coasterId, 'slug': hero.coasterSlug}) }}" class="block relative mb-5 overflow-hidden rounded-xl">
          <div class="relative aspect-[16/10] overflow-hidden">
            {# The card the browser sees first above the fold -- eager/high-priority, not the
               loading="lazy" default a below-the-fold image would get. 480x300 is the real
               display size at this card's largest (desktop) breakpoint; helper.picture()
               requests the 2x (960x600) variant too and lets the browser pick via srcset. #}
            {{ helper.picture(hero.imageFilename, 480, 300, hero.coasterName, 'block h-full w-full object-cover', 'eager', '', 'high') }}
            {# Concentrated on the bottom third so the photo itself stays visible. Darker at the very
               bottom (0.9, up from 0.85) than the fade reach alone needs -- text contrast against an
               arbitrary user photo (e.g. snow, bright sky) isn't otherwise guaranteed. #}
            <div class="absolute inset-0 bg-linear-to-t from-ink/90 to-transparent to-45%"></div>
          </div>
          {% if hero.type == 'upcoming' %}
            {# Real status (construction or announced) drives both label and color -- see colors.css's [data-status] rules. #}
            <span class="{{ heroBadgeClass }} bg-[var(--status-color)]" data-status="{{ hero.statusName }}">
              {{ ux_icon(hero.statusName == 'status.announced' ? 'lucide:megaphone' : 'lucide:construction', {'class': 'w-3.5 h-3.5'}) }}
              {{ hero.statusName|trans([], 'database') }}
            </span>
          {% elseif hero.type == 'new' %}
            <span class="{{ heroBadgeClass }} bg-success">
              {{ ux_icon('lucide:sparkles', {'class': 'w-3.5 h-3.5'}) }}
              {{ 'index.hero.badge.new'|trans }}
            </span>
          {% elseif hero.type == 'trending' %}
            <span class="{{ heroBadgeClass }} bg-info">
              {{ ux_icon('lucide:flame', {'class': 'w-3.5 h-3.5'}) }}
              {{ 'index.hero.badge.trending'|trans }}
            </span>
          {% elseif hero.type == 'photo' %}
            <span class="{{ heroBadgeClass }} bg-cc-teal-400">
              {{ ux_icon('lucide:heart', {'class': 'w-3.5 h-3.5'}) }}
              {{ 'index.hero.badge.photo'|trans }}
            </span>
          {% endif %}
          <div class="absolute inset-x-0 bottom-0 p-4 pt-3.5 text-white">
            <p class="line-clamp-2 text-lead leading-tight font-bold text-shadow-sm text-shadow-ink/35">{{ hero.coasterName }}</p>
            <div class="mt-0.5 flex items-baseline gap-2">
              <span class="min-w-0 flex-1 truncate text-caption text-white/80">{{ hero.parkName }}</span>
              {% if hero.imageCredit %}
                <span class="inline-flex min-w-0 max-w-[45%] flex-none items-center gap-1 text-caption text-white/60">
                  {{ ux_icon('lucide:camera', {'class': 'w-2.5 h-2.5 shrink-0'}) }}
                  <span class="truncate">{{ hero.imageCredit }}</span>
                </span>
              {% endif %}
            </div>
          </div>
        </a>
      {% endif %}
      <!-- latest ratings -->
      <div class="cc-panel cc-panel--flat border-top-cc-teal">
        <div class="cc-panel__heading">
          <h6 class="cc-panel__title">{{ 'rating.last'|trans }}</h6>
        </div>
        <div class="cc-panel__body">
          <ul class="list-feed">
            {% for ratingItem in ratingFeed %}
              <li>
                <a class="text-bold" href="{{ path('user_show', {'slug': ratingItem.user.slug}) }}">
                  {{ ratingItem.user.displayName }}
                </a>
                {{ 'rating.action'|trans({'%value%': ratingItem.value}) }}
                  <a href="{{ path('show_coaster', {'id': ratingItem.coaster.id, 'slug': ratingItem.coaster.slug}) }}">
                  {{ ratingItem.coaster.name }}
                </a>
                <div class="text-muted">
                  {{ ratingItem.updatedAt|ago }}
                </div>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
      <!-- /latests ratings -->
    </div>
    <div class="col-span-12 md:col-span-6">
      <!-- latest reviews -->
      <div class="cc-panel cc-panel--flat">
        <div class="cc-panel__heading">
          <h6 class="cc-panel__title text-semibold">
            {{ ux_icon('lucide:message-square-text', {'class': 'w-4 h-4 position-left'}) }}
            {{ 'review.last'|trans }}
          </h6>
          <div class="heading-elements">
            <a href="{{ path('review_list') }}" class="heading-text">
              {{ 'review.all'|trans }}
              {{ ux_icon('lucide:arrow-right', {'class': 'size-4 ms-1'}) }}
            </a>
          </div>
        </div>

        <div class="cc-panel__body">
          <ul class="cc-media-list cc-media-list--bordered cc-media-list--stack-mobile reviews-list">
            {% for review in reviews %}
              <li class="review-list-item">
                <div class="review-coaster-info">
                  <h6 class="cc-media__heading text-semibold">
                    <a href="{{ path('show_coaster', {'id': review.coaster.id, 'slug': review.coaster.slug}) }}">
                      {{ review.coaster.name }}
                    </a>
                    -
                    <a href="{{ path('park_show', {'id': review.coaster.park.id, 'slug': review.coaster.park.slug}) }}">
                      {{ review.coaster.park.name }}
                    </a>
                  </h6>
                </div>
                {% include 'Includes/_review_item.html.twig' with {'review': review, 'preferredReviewLanguages': preferredReviewLanguages, 'stackOnMobile': true} %}
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
      <!-- /latest reviews -->
    </div>
  </div>
{% endblock %}
