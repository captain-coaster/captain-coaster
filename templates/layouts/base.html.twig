<!DOCTYPE html>
<html lang="{{ app.request.get('_locale') }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="csrf-token" content="{{ csrf_token('rating') }}">
  {# Apply theme before first paint to avoid a flash of the wrong color scheme #}
  <script>
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      } catch (e) {}
    })();
  </script>
  <title>{% block title %}{{ 'app.title.default'|trans }}{% endblock %} • {{ 'app.name'|trans }}</title>
  
  <!-- Favicon and app icons -->
  <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('apple-touch-icon.png') }}">
  <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('favicon-32x32.png') }}">
  <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('favicon-16x16.png') }}">
  <link rel="mask-icon" href="{{ asset('safari-pinned-tab.svg') }}" color="#0c8ce9">
  <link rel="shortcut icon" href="{{ asset('favicon.ico') }}">
  <meta name="apple-mobile-web-app-title" content="{{ 'app.name'|trans }}">
  <meta name="application-name" content="{{ 'app.name'|trans }}">
  <meta name="msapplication-TileColor" content="#0c8ce9">
  <meta name="theme-color" content="#0c8ce9">
  <link rel="manifest" href="{{ asset('manifest.json') }}">
  
  <!-- SEO and social meta -->
  {% block header %}{% endblock %}
  
  <!-- Stylesheets (includes self-hosted Geist variable font) -->
  {{ vite_entry_link_tags('app') }}
  {% block stylesheets %}{% endblock %}
</head>
<body class="bg-neutral-50 dark:bg-neutral-900 font-sans antialiased"
      style="--sidebar-width: 16rem"
      data-controller="keyboard-shortcuts global"
      data-pictures-cdn="{{ pictures_cdn }}">
  <!-- Skip to main content link for accessibility -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-cc-blue-500 text-white px-4 py-2 rounded-lg z-50">
    {{ 'nav.skip.main'|trans({}, 'navigation') }}
  </a>

  {# Subtle brand ambient — a faint diagonal wash spanning the full viewport, so the margin
     space on wide screens reads as designed rather than flat dead gray. Kept extremely low
     opacity: the goal is "this was chosen," not a visible background. #}
  <div class="pointer-events-none fixed inset-0 -z-10 bg-gradient-to-br from-cc-blue-500/[0.06] via-transparent to-cc-warm-500/[0.05]" aria-hidden="true"></div>

  <!-- Main application container -->
  <div class="min-h-screen flex flex-col">
    <!-- Navigation header -->
    <header role="banner" aria-label="{{ 'nav.main.label'|trans({}, 'navigation') }}">
      {% include 'partials/_navbar.html.twig' %}
    </header>

    <!-- Main application layout -->
    <div class="flex flex-1">
      <!-- Desktop sidebar navigation -->
      {% include 'partials/_sidebar.html.twig' %}

      <!-- Main content area -->
      <main id="main-content" class="flex-1 md:ml-(--sidebar-width) pt-16 min-w-0" role="main" aria-label="{{ 'main.content.label'|trans({}, 'navigation') }}">
        {% block wide_body %}
          {# Hero slot: spans the full width of the main area (no max-width cap) #}
          {% block hero %}{% endblock %}

          {# Reserve space for the fixed filter sidebar on desktop when the page has filters #}
          <div class="{% if pageHasFilters|default(false) %}lg:pr-72{% endif %}">
            <!-- Content container -->
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
              <!-- Messages and notifications -->
              {% include 'partials/_messages.html.twig' %}

              <!-- Page content -->
              {% block body %}{% endblock %}
            </div>
          </div>
        {% endblock %}
      </main>

      <!-- Secondary sidebar (filters) -->
      {% block secondary_sidebar %}{% endblock %}
    </div>

    <!-- Footer -->
    <footer role="contentinfo" aria-label="{{ 'nav.footer.label'|trans({}, 'navigation') }}">
      {% include 'partials/_footer.html.twig' %}
    </footer>
  </div>

  <!-- JavaScript -->
  {{ vite_entry_script_tags('app') }}

  <!-- Routing (defer: downloads in parallel, executes after DOM is ready) -->
  <script defer src="{{ asset('bundles/fosjsrouting/js/router.js') }}"></script>
  <script defer src="{{ path('fos_js_routing_js', { callback: 'fos.Router.setData' }) }}"></script>

  <!-- Page-specific JavaScript -->
  {% block javascripts %}{% endblock %}
  
  <!-- Analytics (production only) -->
  {% if app.environment != 'dev' %}
  <script defer src="https://umami.captaincoaster.com/script.js" data-website-id="b5fd8d78-2d4e-4319-b75c-f71c6bb1485f"></script>
  {% endif %}
</body>
</html>
