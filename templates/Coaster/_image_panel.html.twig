{% set image_count = coaster.images|length %}
<div class="cc-panel cc-panel--flat">
    <div class="cc-panel__heading">
        <h6 class="cc-panel__title">
            <span class="text-semibold">
                {{ ux_icon('heroicons:photo', {'class': 'w-4 h-4 position-left'}) }} {{ 'coaster.photos.title'|trans }}
                {% if image_count > 0 %}
                    <span class="cc-badge cc-badge--primary">{{ image_count }}</span>
                {% endif %}
            </span>
        </h6>
        <div class="pull-right text-muted">
          <a href="{{ path('coaster_images_upload', {'slug': coaster.slug}) }}">
            {{ 'coaster.photos.button'|trans }}
          </a>
          </div>
    </div>
    
    {% if image_count > 0 %}
        <div class="cc-panel__body grid grid-cols-12 gap-5"
             data-controller="gallery"
             data-gallery-name-value="coaster-images"
             data-gallery="coaster-images">
            {% for image in images %}
                <div class="col-span-12 tablet:col-span-3">
                    <a class="m-2.5" href="{{ pictures_cdn }}/1440x1440/{{ image.filename }}" data-gallery-target="link">
                        <div class="cc-card__media">
                            <img src="{{ pictures_cdn }}/280x210/{{ image.filename }}"
                                 alt="{{ coaster.name }}">
                        </div>
                    </a>
                    <div class="text-size-small text-muted"
                         data-controller="image-like"
                         data-image-like-image-id-value="{{ image.id }}"
                         data-image-like-locale-value="{{ app.request.locale }}"
                         data-image-like-liked-value="{% if image.id in userLikes %}true{% else %}false{% endif %}"
                         style="display: flex; align-items: center; gap: 2px;">
                        <button type="button"
                                data-action="click->image-like#toggle"
                                data-image-like-target="icon"
                                class="cc-button--link text-muted p-0 border-0 bg-transparent"
                                style="cursor: pointer; display: inline-flex; align-items: center;"
                                aria-label="{{ 'coaster.photos.like'|trans }}"
                                aria-pressed="{% if image.id in userLikes %}true{% else %}false{% endif %}">
                        </button><span data-image-like-target="counter">{{ image.likeCounter }}</span>
                        {% if image.credit %}&nbsp;{{ image.credit }}{% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
        {% if number < image_count %}
            <div class="cc-panel__footer text-center">
                <a id="show-all" class="cc-button cc-button--link">{{ 'coaster.photos.all'|trans }}</a>
            </div>
        {% endif %}
    {% else %}
        <div class="cc-panel__body text-center text-muted">
            {{ ux_icon('heroicons:photo', {'class': 'w-5 h-5'}) }}
            <p class="mt-2.5">{{ 'coaster.photos.empty'|trans }}</p>
            <a href="{{ path('coaster_images_upload', {'slug': coaster.slug}) }}" class="cc-button cc-button--primary cc-button--sm">
                {{ 'coaster.photos.button'|trans }}
            </a>
        </div>
    {% endif %}
</div>
