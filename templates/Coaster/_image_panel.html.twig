{# Each coaster.images|length is a COUNT query: the page passes the one it made. #}
{% set image_count = image_count ?? coaster.images|length %}
<div class="cc-panel cc-panel--flat">
    <div class="cc-panel__heading flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
        <h6 class="cc-panel__title">
            <span class="text-semibold">
                {{ ux_icon('lucide:image', {'class': 'w-4 h-4 position-left'}) }} {{ 'coaster.photos.title'|trans }}
                {% if image_count > 0 %}
                    <span class="cc-badge cc-badge--primary">{{ image_count }}</span>
                {% endif %}
            </span>
        </h6>
        <a href="{{ path('coaster_images_upload', {'slug': coaster.slug}) }}">
            {{ 'coaster.photos.button'|trans }}
        </a>
    </div>
    
    {% if image_count > 0 %}
        <div class="cc-panel__body grid grid-cols-12 gap-5"
             data-controller="gallery"
             data-gallery-name-value="coaster-images"
             data-gallery="coaster-images"
             data-coaster-images-target="grid">
            {% include 'Coaster/_image_tiles.html.twig' with {offset: 0, phone_shown: 2} %}
        </div>
        {# A phone shows 2 of the photos rendered, a wider screen all of them: "show all"
           reveals the hidden ones, then fetches those the page doesn't have. #}
        {% if image_count > 2 %}
            <div class="cc-panel__footer text-center{{ images|length >= image_count ? ' md:hidden' }}" data-coaster-images-target="more">
                <button type="button" class="cc-button cc-button--link" data-action="coaster-images#showAll">{{ 'coaster.photos.all'|trans }}</button>
            </div>
        {% endif %}
    {% else %}
        <div class="cc-panel__body text-center text-muted">
            {{ ux_icon('lucide:image', {'class': 'w-5 h-5'}) }}
            <p class="mt-2.5">{{ 'coaster.photos.empty'|trans }}</p>
            <a href="{{ path('coaster_images_upload', {'slug': coaster.slug}) }}" class="cc-button cc-button--primary cc-button--sm">
                {{ 'coaster.photos.button'|trans }}
            </a>
        </div>
    {% endif %}
</div>
