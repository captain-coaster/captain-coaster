{% if coasterSummary %}
    <div class="bg-surface rounded-2xl border border-line p-4 space-y-3">
        <p class="text-xs text-content-muted">
            {{ 'ai_summary.info.based_on'|trans({'count': coasterSummary.reviewsAnalyzed}, 'ai_summary') }}
        </p>

        {# Summary text #}
        <p class="text-sm text-content-secondary leading-relaxed">{{ coasterSummary.summary }}</p>

        {# Pros/Cons pills #}
        {% if coasterSummary.dynamicPros|length > 0 or coasterSummary.dynamicCons|length > 0 %}
            <div class="flex flex-wrap gap-1.5">
            {% for pro in coasterSummary.dynamicPros %}
                <span class="inline-flex items-center gap-0.5 px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 dark:bg-green-900/20 text-green-700 dark:text-green-400">
                    {{ ux_icon('tabler:thumb-up', {'class': 'w-3 h-3', 'aria-hidden': 'true'}) }}
                    {{ pro }}
                </span>
            {% endfor %}
            {% for con in coasterSummary.dynamicCons %}
                <span class="inline-flex items-center gap-0.5 px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 dark:bg-red-900/20 text-red-700 dark:text-red-400">
                    {{ ux_icon('tabler:thumb-down', {'class': 'w-3 h-3', 'aria-hidden': 'true'}) }}
                    {{ con }}
                </span>
            {% endfor %}
            </div>
        {% endif %}

        {# Feedback — compact footer like review card #}
        <div class="flex items-center gap-2 text-xs text-content-subtle pt-1"
            data-controller="ai-feedback"
            data-ai-feedback-summary-id-value="{{ coasterSummary.id }}"
            data-ai-feedback-feedback-url-value="{{ path('summary_feedback', {'id': coasterSummary.id}) }}"
            data-ai-feedback-csrf-token-value="{{ csrf_token('summary_feedback') }}"
            data-ai-feedback-success-message-value="{{ 'ai_summary.feedback.success'|trans({}, 'ai_summary') }}"
            data-ai-feedback-error-message-value="{{ 'ai_summary.feedback.error'|trans({}, 'ai_summary') }}"
            data-ai-feedback-helpful-title-value="{{ 'ai_summary.feedback.button.helpful'|trans({}, 'ai_summary') }}"
            data-ai-feedback-not-helpful-title-value="{{ 'ai_summary.feedback.button.not_helpful'|trans({}, 'ai_summary') }}"
            data-ai-feedback-voted-helpful-title-value="{{ 'ai_summary.feedback.button.voted_helpful'|trans({}, 'ai_summary') }}"
            data-ai-feedback-voted-not-helpful-title-value="{{ 'ai_summary.feedback.button.voted_not_helpful'|trans({}, 'ai_summary') }}"
            {% if userFeedbackState %}
                data-ai-feedback-user-vote-value="{% if userFeedbackState['hasVoted'] %}{{ userFeedbackState['isPositive'] ? 'positive' : 'negative' }}{% endif %}"
                data-ai-feedback-has-voted-value="{{ userFeedbackState['hasVoted'] ? 'true' : 'false' }}"
            {% else %}
                data-ai-feedback-user-vote-value=""
                data-ai-feedback-has-voted-value="false"
            {% endif %}
        >
            <span>{{ 'ai_summary.feedback.prompt'|trans({}, 'ai_summary') }}</span>
            <button
                type="button"
                class="p-1 rounded text-green-600 hover:bg-green-50 dark:text-green-400 dark:hover:bg-green-900/20 transition-colors"
                data-ai-feedback-target="thumbsUpButton"
                data-action="click->ai-feedback#thumbsUp"
                title="{{ 'ai_summary.feedback.button.helpful'|trans({}, 'ai_summary') }}"
            >
                <span data-ai-feedback-target="thumbsUpIcon">{{ ux_icon('tabler:thumb-up', {'class': 'w-3.5 h-3.5', 'aria-hidden': 'true'}) }}</span>
            </button>
            <button
                type="button"
                class="p-1 rounded text-red-600 hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-900/20 transition-colors"
                data-ai-feedback-target="thumbsDownButton"
                data-action="click->ai-feedback#thumbsDown"
                title="{{ 'ai_summary.feedback.button.not_helpful'|trans({}, 'ai_summary') }}"
            >
                <span data-ai-feedback-target="thumbsDownIcon">{{ ux_icon('tabler:thumb-down', {'class': 'w-3.5 h-3.5', 'aria-hidden': 'true'}) }}</span>
            </button>
            <span class="hidden">
                <span data-ai-feedback-target="positiveCount">{{ coasterSummary.positiveVotes }}</span>
                <span data-ai-feedback-target="negativeCount">{{ coasterSummary.negativeVotes }}</span>
            </span>
            <span data-ai-feedback-target="loadingIndicator" class="hidden">
                {{ ux_icon('tabler:refresh', {'class': 'w-3.5 h-3.5 animate-spin text-content-subtle', 'aria-hidden': 'true'}) }}
            </span>
        </div>
    </div>
{% endif %}
