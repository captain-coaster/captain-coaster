{% extends "base.html.twig" %}

{% set title = 'image_upload.title'|trans({'%coaster%': coaster.name}) %}
{% set parentUrl = path('show_coaster', {'id': coaster.id, 'slug': coaster.slug}) %}
{% block title %}{{ title }}{% endblock %}

{% block body %}
  {% set flash_tones = {success: 'border-success bg-success-bg', warning: 'border-warning bg-warning-bg'} %}
  {% for label, messages in app.flashes %}
    {% for message in messages %}
      <p class="mb-6 max-w-text rounded-card border px-4 py-3 text-ink {{ flash_tones[label] ?? 'border-danger bg-danger-bg' }}" role="status">{{ message }}</p>
    {% endfor %}
  {% endfor %}

  {{ form_start(form, {attr: {class: 'grid max-w-text gap-6', 'data-form-submit-loading-text-value': 'image_upload.form.submitting'|trans}}) }}
    {{ form_errors(form) }}
    {{ form_row(form.file) }}
    {{ form_row(form.credit) }}
    {{ form_row(form.watermarked) }}
    {{ form_row(form.copyrightAgreement) }}
    {{ form_rest(form) }}
    <div class="flex flex-col gap-2 md:flex-row md:items-center">
      <twig:Button block>{{ 'image_upload.form.submit'|trans }}</twig:Button>
      <twig:Button variant="text" href="{{ parentUrl }}">{{ 'form.cancel'|trans }}</twig:Button>
    </div>
  {{ form_end(form) }}
{% endblock %}
