{% extends "layouts/base.html.twig" %}

{% set title = 'user_profile.title'|trans({'%name%': user.displayName}) %}
{% block title %}{{ title }}{% endblock %}

{% block body %}
    <twig:ProfileHero :user="user" :rank="stats.rank ?? null" :isOwnProfile="false" />

    <twig:ProfileLinks :user="user" :images_counter="images_counter" :isOwnProfile="false" />

    {% if stats|length > 0 %}
      <twig:ProfileScore :score="stats.score" />
      <twig:ProfileProgress :progress="stats.progress" :rank="stats.rank" :milestone="stats.milestone" />
      <twig:ProfileRecords :records="stats.records" />
      <twig:ProfileTaste :taste="stats.taste" />
      <twig:ProfileMostRidden :taste="stats.taste" />
      <twig:ProfileThisYear :thisYear="stats.this_year" />
    {% else %}
      <twig:EmptyState
        icon="tabler:roller-coaster"
        :title="'user_profile.empty.title'|trans({'name': user.displayName})"
        :description="'user_profile.empty.description'|trans" />
    {% endif %}

    {% if recentActivity|default([])|length > 0 %}
      <section class="mb-6">
        <twig:SectionHeading
          icon="tabler:history"
          iconColor="text-cc-blue-500"
          title="{{ 'profile.activity.title'|trans }}"
          seeAllUrl="{{ path('user_ratings', {'id': user.id}) }}"
          seeAllLabel="{{ 'profile.activity.see_all'|trans }}" />
        <twig:ProfileActivity :activity="recentActivity" />
      </section>
    {% endif %}
{% endblock %}
