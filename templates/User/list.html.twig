{% extends "base.html.twig" %}

{% set title = 'user_list.title'|trans %}
{% block title %}{{ title }}{% endblock %}

{% block body %}
    {# info alert #}
    <div class="cc-alert cc-alert--info cc-alert--styled-left cc-alert--arrow-left cc-alert--component" data-controller="alert">
        <button type="button" class="cc-close" data-action="click->alert#close"><span>&times;</span><span class="sr-only">Close</span>
        </button>
        <h6 class="cc-alert--heading text-semibold">{{ 'user_list.info.title'|trans }}</h6>
        <p>{{ 'user_list.info.text'|trans }}</p>
    </div>
    {# /info alert #}
    {% include 'Includes/list_users.html.twig' with {'users': users, 'border': true} %}
    {{ knp_pagination_render(users) }}
{% endblock %}
