{% extends "base.html.twig" %}

{% set title = 'users.reviews.title'|trans({'%name%': user.displayName}) %}
{% block title %}{{ title }}{% endblock %}

{% block body %}
  <div class="grid grid-cols-12 gap-5">
    <div class="cc-panel cc-cc-panel--flat col-span-full">
      <div class="cc-panel__heading">
        <h6 class="cc-panel__title text-semibold">
          {{ ux_icon('heroicons:chat-bubble-left', {'class': 'w-4 h-4 position-left'}) }}
          {{ 'review.title'|trans }}
        </h6>
      </div>

      {% if reviews.getTotalItemCount() > 0 %}
        <div class="cc-panel__body">
          <ul class="cc-media-list cc-media-list--bordered">
            {% for review in reviews %}
              <li>
                <div class="cc-media__heading">
                  <h6 class="text-semibold">
                    <a href="{{ path('show_coaster', {'id': review.coaster.id, 'slug': review.coaster.slug}) }}">
                      {{ review.coaster.name }}
                    </a>
                    -
                    <a href="{{ path('park_show', {'id': review.coaster.park.id, 'slug': review.coaster.park.slug}) }}">
                      {{ review.coaster.park.name }}
                    </a>
                  </h6>
                </div>
                {% include 'Includes/_review_item.html.twig' with {'review': review, 'preferredReviewLanguages': preferredReviewLanguages} %}
              </li>
            {% endfor %}
          </ul>
          {{ knp_pagination_render(reviews) }}
        </div>
      {% else %}
        <div class="cc-panel__body text-center text-muted">
          {{ ux_icon('heroicons:chat-bubble-left-right', {'class': 'w-5 h-5'}) }}
          <p class="mt-10">{{ 'review_list.no_review'|trans }}</p>
        </div>
      {% endif %}
    </div>
  </div>
{% endblock %}
