{% extends "layouts/base.html.twig" %}

{% set title = 'users.reviews.title'|trans({'%name%': user.displayName}) %}
{% block title %}{{ title }}{% endblock %}

{% block body %}
    <twig:PageHeader
      title="{{ user.displayName }}"
      subtitle="{{ reviews.getTotalItemCount() }} {{ 'review.title'|trans|lower }}"
      backUrl="{{ path('user_show', {'slug': user.slug}) }}"
      backLabel="{{ 'nav.back'|trans({}, 'navigation') }}"
    />

    {% if reviews.getTotalItemCount() > 0 %}
      <div class="space-y-4">
        {% for review in reviews %}
          <twig:ReviewCard
            :review="review"
            variant="full"
            :displayReviewsInAllLanguages="true"
            :showCoaster="true"
            :showActions="true"
            :maxReviewLength="300"
          />
        {% endfor %}
      </div>

      <div class="mt-6">
        {{ knp_pagination_render(reviews) }}
      </div>
    {% else %}
      <twig:EmptyState icon="tabler:message-circle" :title="'review.title'|trans" :description="'review.share'|trans" />
    {% endif %}
{% endblock %}
