{% extends 'base.html.twig' %}


{% set title = 'users.tops.title'|trans({'%name%': user.displayName}) %}
{% set parentUrl = path('user_show', {'slug': user.slug}) %}
{% block title %}{{ title }}{% endblock %}

{% block body %}
  <div class="cc-panel cc-panel__body cc-media cc-media--stack-mobile">
    <div class="cc-media__start">
      <a href="#" class="cc-button cc-button--link cc-button--icon text-cc-teal">
        {{ ux_icon('lucide:clipboard-list', {'class': 'w-5 h-5 no-edge-top'}) }}
      </a>
    </div>
    <div class="cc-media__body cc-media__middle">
      <h6 class="cc-media__heading text-semibold">{{ 'list.infotitle'|trans({}, 'top') }}</h6>
      {{ 'list.info'|trans({}, 'top') }}
    </div>
    <div class="cc-media__end cc-media__middle">
      <a href="{{ path('top_new') }}" class="cc-button bg-cc-teal-400 cc-button--lg">{{ ux_icon('lucide:plus', {'class': 'w-4 h-4 position-left'}) }}
        {% if tops|length == 0 %}{{ 'list.create_first'|trans({}, 'top') }}{% else %}{{ 'list.create'|trans({}, 'top') }}{% endif %}
      </a>
    </div>
  </div>

  <div class="grid grid-cols-12 gap-5">
    {% for top in tops %}
      <div class="col-span-12 md:col-span-6 xl:col-span-4">
        <div class="cc-card">
          <div class="cc-card__caption">
            <div class="content-group-sm cc-media">
              <div class="cc-media__start">
                <twig:Avatar :user="top.user" decorative/>
              </div>
              <div class="cc-media__body">
                <h6 class="text-semibold m-0">
                  {% if top.main %}{{ ux_icon('lucide:check', {'class': 'w-4 h-4 text-size-mini position-left'}) }}{% endif %}
                  <a href="{{ path('top_show', {'id': top.id}) }}" class="text-default">
                    {{ top.name }}
                  </a>
                </h6>
              </div>
            </div>
            <ul class="list-feed">
              {% for i in 0..2 %}
                {% if top.topCoasters[i] is defined %}
                  <li>
                    {{ i + 1 }} -
                    <a href="{{ path('show_coaster', {'id': top.topCoasters[i].coaster.id, 'slug': top.topCoasters[i].coaster.slug}) }}"
                       class="text-default">
                      {{ top.topCoasters[i].coaster.name }}
                    </a>
                  </li>
                {% else %}
                  <li>&nbsp;</li>
                {% endif %}
              {% endfor %}
            </ul>
            <div class="mt-[5px]">
              <a href="{{ path('top_show', {'id': top.id}) }}">
                {{ ux_icon('lucide:circle-arrow-right', {'class': 'w-4 h-4'}) }} {{ 'list.more'|trans({}, 'top') }}
              </a>
            </div>
            <ul class="list-inline mt-[5px]">
              <li>{{ ux_icon('lucide:layers', {'class': 'w-4 h-4 position-left'}) }} {{ top.topCoasters|length }}</li>
              <li>
                {{ ux_icon('lucide:clock', {'class': 'w-4 h-4 position-left'}) }} {{ 'list.updated'|trans({}, 'top') }} {{ top.updatedAt|ago }}
              </li>
            </ul>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
{% endblock %}
