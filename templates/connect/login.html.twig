{% extends "connect/_layout.html.twig" %}

{% set title = 'login.title'|trans %}
{% set heading = 'login.heading'|trans %}

{% block form %}
  <p class="m-0 text-lead font-semibold text-muted-strong">{{ 'login.subtitle'|trans }}</p>

  {% if error %}
    <p class="m-0 rounded-card border border-danger bg-danger-bg px-4 py-3 text-ink" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
  {% endif %}

  {{ form_start(loginForm, {attr: {class: 'grid gap-6', 'data-form-submit-loading-text-value': 'login.form.submitting'|trans}}) }}
    {{ form_errors(loginForm) }}
    {{ form_row(loginForm.email, {disabled: rateLimitExceeded}) }}
    {{ form_rest(loginForm) }}
    <twig:Button class="w-full" :disabled="rateLimitExceeded">{{ 'login.form.submit'|trans }}</twig:Button>
  {{ form_end(loginForm) }}

  <p class="m-0 flex items-center gap-3 text-caption text-muted before:h-px before:flex-1 before:bg-line after:h-px after:flex-1 after:bg-line">{{ 'login.or'|trans }}</p>

  <twig:Button variant="secondary" href="{{ path('connect_google_start') }}" class="gap-3">
    {{ ux_icon('fe:google', {class: 'size-5', 'aria-hidden': 'true'}) }}
    {{ 'login.connect_with_google'|trans }}
  </twig:Button>

  <p class="m-0 [&_a]:font-semibold">{{ 'login.redirect_to_register'|trans({'%link_path%': path('app_register')})|raw }}</p>
  <p class="m-0 text-caption text-muted">{{ 'account.terms'|trans({'%link_path%': path('app_terms_conditions')})|raw }}</p>
{% endblock %}
