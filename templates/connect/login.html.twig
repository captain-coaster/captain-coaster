{% extends "base.html.twig" %}

{% set title = 'login.title'|trans %}
{% set subTitle = 'login.subtitle'|trans %}
{% set parentUrl = path('profile') %}
{% set narrowHeader = true %}
{% block title %}{{ title }}{% endblock %}

{% block header %}
  <meta name="robots" content="noindex">
{% endblock %}

{% block body %}
  <div class="mx-auto grid max-w-md gap-6">
    <section class="grid gap-5 rounded-card bg-surface p-6 shadow-raised">
      {% if error %}
        <p class="m-0 rounded-card border border-danger bg-danger-bg px-4 py-3 text-ink" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
      {% endif %}

      {{ form_start(loginForm, {attr: {class: 'grid gap-6', 'data-controller': 'form-submit', 'data-form-submit-loading-text-value': 'login.sending'|trans, 'data-action': 'submit->form-submit#submit'}}) }}
        {{ form_errors(loginForm) }}
        {{ form_row(loginForm.email, {disabled: rateLimitExceeded}) }}
        {{ form_rest(loginForm) }}
        <twig:Button class="w-full" :disabled="rateLimitExceeded">{{ 'login.send_link'|trans }}</twig:Button>
      {{ form_end(loginForm) }}

      <p class="m-0 flex items-center gap-3 text-caption text-muted before:h-px before:flex-1 before:bg-line after:h-px after:flex-1 after:bg-line">{{ 'login.or_sign_in_with'|trans }}</p>

      <twig:Button variant="secondary" href="{{ path('connect_google_start') }}" class="gap-3">
        {{ ux_icon('fe:google', {class: 'size-5', 'aria-hidden': 'true'}) }}
        {{ 'login.connect_with_google'|trans }}
      </twig:Button>
    </section>

    <p class="m-0 text-center [&_a]:font-semibold">{{ 'login.redirect_to_register'|trans({'%link_path%': path('app_register')})|raw }}</p>
    <p class="m-0 text-center text-caption text-muted">{{ 'login.terms'|trans({'%link_path%': path('app_terms_conditions')})|raw }}</p>
  </div>
{% endblock %}
