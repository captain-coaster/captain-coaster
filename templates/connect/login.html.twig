{% extends "base_login.html.twig" %}

{% block title %}{{ 'login.title'|trans }} • {{ 'app.name'|trans }}{% endblock %}

{% block body %}
    <div class="login-form-container">
        <!-- Form with validation -->
        <div class="cc-panel cc-panel__body login-form">
        <div class="text-center mb-3">
            <div class="icon-object border-warning-400 text-warning-400">{{ ux_icon('heroicons:key', {'class': 'w-4 h-4'}) }}</div>
            <h5 class="content-group-lg">{{ 'login.title'|trans }}
                <small
                    class="display-block">{{ 'login.subtitle'|trans }}</small>
            </h5>
        </div>
        {% if error %}
            <div class="cc-alert cc-alert--danger cc-alert--bordered">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="cc-alert alert-{{ label }} cc-alert--bordered">
                    {{ message | raw }}
                </div>
            {% endfor %}
        {% endfor %}
        {{ form_start(loginForm, {'attr': {'data-controller': 'form-submit', 'data-form-submit-loading-text-value': 'login.sending'|trans, 'data-action': 'submit->form-submit#submit'}}) }}
            <div class="cc-field has-feedback has-feedback-left">
                {% set emailAttr = {'class': 'cc-field__control', 'placeholder': 'Email'} %}
                {% if rateLimitExceeded %}{% set emailAttr = emailAttr|merge({'disabled': 'disabled'}) %}{% endif %}
                {{ form_widget(loginForm.email, {'attr': emailAttr}) }}
                <div class="cc-field__feedback">
                    {{ ux_icon('heroicons:envelope', {'class': 'w-4 h-4 text-muted'}) }}
                </div>
            </div>
            {% if not loginForm.email.vars.valid %}
                <div class="cc-alert cc-alert--danger cc-alert--bordered">
                    {{ form_errors(loginForm.email) }}
                </div>
            {% endif %}
            {{ form_errors(loginForm) }}
            <div class="cc-field">
                {{ form_widget(loginForm.recaptcha) }}
                {% if not loginForm.recaptcha.vars.valid %}
                    <div class="cc-alert cc-alert--danger cc-alert--bordered">
                        {{ form_errors(loginForm.recaptcha) }}
                    </div>
                {% endif %}
            </div>
            <div class="cc-field">
                <button type="submit"
                        class="cc-button bg-cc-blue cc-button--block"{% if rateLimitExceeded %} disabled{% endif %}>{{ 'login.send_link'|trans }}</button>
            </div>
            <div
                class="cc-field text-muted">{{ 'login.redirect_to_register'|trans({'%link_path%': path('app_register')})|raw }}</div>
        {{ form_end(loginForm) }}
        <div class="content-divider text-muted cc-field">
            <span>{{ 'login.or_sign_in_with'|trans }}</span>
        </div>
        <ul class="list-inline cc-field list-inline-condensed text-center">
            <li>
                <a href="{{ path('connect_google_start') }}"
                   class="cc-button border-danger-800 text-danger-800 cc-button--flat cc-button--icon cc-button--rounded">
                    {{ ux_icon('fe:google', {'class': 'w-4 h-4'}) }}
                    {{ 'login.connect_with_google'|trans }}
                </a>
            </li>
        </ul>

        <span class="help-block text-center">
            {{ 'login.terms'|trans({'%link_path%': path('app_terms_conditions')})|raw }}
        </span>
        </div>
        <!-- /form with validation -->
    </div>
{% endblock %}
