<div class="cc-panel__body">
  <ul class="cc-media-list">
    {% for recipient in recipients %}
      {% set notification = recipient.notification %}
      <li class="cc-media notif-item{% if not recipient.isRead %} unread{% endif %}">
        <div class="cc-media__start">
          <a href="{{ path('notification_read', {'id': recipient.id}) }}"
             class="cc-button {{ notification.type.iconColorClass }} cc-button--rounded cc-button--icon cc-button--xs"
             {% if not recipient.isRead %}data-action="click->notification-list#markRead" data-mark-read-url="{{ path('notification_mark_read', {'id': recipient.id}) }}"{% endif %}>
            {{ ux_icon(notification.type.icon, {'class': 'w-3.5 h-3.5'}) }}
          </a>
        </div>

        <div class="cc-media__body">
          <a href="{{ path('notification_read', {'id': recipient.id}) }}"
             {% if not recipient.isRead %}data-action="click->notification-list#markRead" data-mark-read-url="{{ path('notification_mark_read', {'id': recipient.id}) }}"{% endif %}>
            {% if notification.parameter is not null %}
              {{ notification.message|trans({'%name%': notification.type.parameterIsTranslationKey ? notification.parameter|trans : notification.parameter}, 'notification') }}
            {% else %}
              {{ notification.message|trans({}, 'notification') }}
            {% endif %}
          </a>
          <div class="cc-media__annotation">{{ recipient.createdAt|ago }}</div>
        </div>
      </li>
    {% else %}
      <li>{{ 'notif.empty'|trans({}, 'notification') }}</li>
    {% endfor %}
  </ul>
</div>
{% if hasMore %}
  <div class="cc-panel__footer text-center">
    <a href="{{ path('notification_index', {'count': nextCount}) }}"
       class="cc-button cc-button--link"
       data-action="click->notification-list#loadMore">
      {{ 'notif.loadOlder'|trans({}, 'notification') }}
    </a>
  </div>
{% endif %}
