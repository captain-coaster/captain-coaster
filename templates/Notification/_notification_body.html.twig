{# The list and its "load older" link: also the XHR response that replaces them (notification_list_controller.js). #}
{% trans_default_domain 'notification' %}
{% if recipients %}
  <ul class="m-0 list-none p-0 max-sm:-mx-gutter">
    {% for recipient in recipients %}
      <twig:Notification:Row :recipient="recipient"/>
    {% endfor %}
  </ul>
{% else %}
  <p class="m-0 py-6 text-muted lg:pt-1">{{ 'notif.empty'|trans }}</p>
{% endif %}
{% if hasMore %}
  <div class="pt-6">
    <twig:Button variant="secondary" block href="{{ path('notification_index', {count: nextCount}) }}"
                 data-action="click->notification-list#loadMore">
      {{ 'notif.loadOlder'|trans({}, 'notification') }}
    </twig:Button>
  </div>
{% endif %}
