{% extends "base.html.twig" %}

{% set title = 'notif.title'|trans %}
{% block title %}{{ title }}{% endblock %}

{% block body %}
  <div class="row">
    <div class="col-sm-12">
      <div class="panel panel-flat" data-controller="notification-list">
        <div class="panel-heading">
          <h6 class="panel-title">{{ 'notif.title'|trans }}</h6>
          {% if unreadCount > 0 %}
            <div class="heading-elements visible-elements">
              <form action="{{ path('notification_mark_all_read') }}" method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('notification_mark_all_read') }}">
                <button type="submit" class="btn btn-primary btn-sm">{{ 'notif.markAllRead'|trans }}</button>
              </form>
            </div>
          {% endif %}
        </div>
        <div class="panel-body">
          <ul class="media-list" data-notification-list-target="list">
            {% include 'Notification/_notification_list.html.twig' %}
          </ul>
        </div>
        {% if hasMore %}
          <div class="panel-footer text-center">
            <a href="{{ path('notification_index', {'before': nextBefore, 'beforeId': nextBeforeId}) }}"
               class="btn btn-link"
               data-notification-list-target="trigger"
               data-action="notification-list#loadMore">
              {{ 'notif.loadOlder'|trans }}
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
{% endblock %}
