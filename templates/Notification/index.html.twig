{% extends "base.html.twig" %}
{# Legacy panels (.cc-*) need the canvas behind them; goes with the page's migration. #}
{% set pageCanvas = true %}

{% set title = 'notif.title'|trans({}, 'notification') %}
{% set parentUrl = path('profile') %}
{% block title %}{{ title }}{% endblock %}

{% block body %}
      <div class="cc-panel cc-panel--flat" data-controller="notification-list" data-notification-list-mark-read-token-value="{{ csrf_token('notification_mark_read') }}">
        <div class="cc-panel__heading">
          <h6 class="cc-panel__title">
            {{ 'notif.title'|trans({}, 'notification') }}
            {% if unreadCount > 0 %}
              <span class="cc-badge cc-badge--primary">{{ unreadCount }}</span>
            {% endif %}
          </h6>
          {% if unreadCount > 0 %}
            <div class="heading-elements visible-elements">
              <form action="{{ path('notification_mark_all_read') }}" method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('notification_mark_all_read') }}">
                <twig:Button variant="secondary" class="min-h-11 px-3 py-1.5 text-caption">{{ 'notif.markAllRead'|trans({}, 'notification') }}</twig:Button>
              </form>
            </div>
          {% endif %}
        </div>
        <div data-notification-list-target="container">
          {% include 'Notification/_notification_body.html.twig' %}
        </div>
      </div>
{% endblock %}
