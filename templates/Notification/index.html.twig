{% extends "base.html.twig" %}

{% set title = 'notif.title'|trans %}
{% block title %}{{ title }}{% endblock %}

{% block body %}
  <div class="row">
    <div class="col-sm-12">
      <div class="panel panel-flat">
        <div class="panel-heading">
          <h6 class="panel-title">{{ 'notif.title'|trans }}</h6>
          {% if unreadCount > 0 %}
            <div class="heading-elements visible-elements">
              <form action="{{ path('notification_mark_all_read') }}" method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('notification_mark_all_read') }}">
                <button type="submit" class="btn btn-link btn-float">{{ 'notif.markAllRead'|trans }}</button>
              </form>
            </div>
          {% endif %}
        </div>
        <div class="panel-body">
          <ul class="media-list">
            {% for recipient in recipients %}
              {% set notification = recipient.notification %}
              <li class="media{% if not recipient.isRead %} bg-light{% endif %}">
                <div class="media-left">
                  {% set iconClass = {
                    'ranking': 'bg-primary',
                    'badge': 'bg-success-400',
                    'announcement': 'bg-warning-400',
                  }[notification.type.value] %}
                  <a href="{{ path('notification_read', {'id': recipient.id}) }}" class="btn {{ iconClass }} btn-rounded btn-icon btn-xs">
                    {% if notification.type.value == 'ranking' %}
                      {{ ux_icon('heroicons:chart-bar', {'class': 'w-5 h-5'}) }}
                    {% elseif notification.type.value == 'announcement' %}
                      {{ ux_icon('heroicons:information-circle', {'class': 'w-5 h-5'}) }}
                    {% else %}
                      {{ ux_icon('heroicons-solid:star', {'class': 'w-5 h-5'}) }}
                    {% endif %}
                  </a>
                </div>

                <div class="media-body">
                  <a href="{{ path('notification_read', {'id': recipient.id}) }}">
                    {% if notification.parameter is not null %}
                      {{ notification.message|trans({'%name%': notification.type.parameterIsTranslationKey ? notification.parameter|trans : notification.parameter}) }}
                    {% else %}
                      {{ notification.message|trans }}
                    {% endif %}
                  </a>
                  <div class="media-annotation">{{ recipient.createdAt|ago }}</div>
                </div>
              </li>
            {% else %}
              <li>{{ 'notif.empty'|trans }}</li>
            {% endfor %}
          </ul>

          {% if hasMore %}
            <div class="text-center">
              <a href="{{ path('notification_index', {'before': nextBefore, 'beforeId': nextBeforeId}) }}" class="btn btn-link">
                {{ 'notif.loadOlder'|trans }}
              </a>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
{% endblock %}
