{% extends "base.html.twig" %}

{% set title = 'coaster_search.title'|trans %}
{% set pageActions %}<twig:FilterToggle/>{% endset %}
{% block title %}{{ title }}{% endblock %}

{% block secondary_sidebar %}
  <twig:FilterPanel :form="filterForm" :config="{endpoint: path('coaster_search_api'), container_id: 'search-result', update_url: true}"/>
{% endblock %}

{% block body %}
  <div id="search-result"></div>
{% endblock %}
