{% extends "base.html.twig" %}

{% set title = 'profile.settings.title'|trans %}
{% set parentUrl = path('profile') %}
{% block title %}{{ title }}{% endblock %}

{% block body %}
  {% set section_class = 'm-0 grid min-w-0 gap-6 border-0 p-0' %}
  {% set legend_class = 'mb-4 p-0 text-lead font-semibold' %}
  <div class="grid grid-cols-12 gap-5 items-start">
    <div class="col-span-12 md:col-span-3">
        {% include 'Profile/_menu.html.twig' with {'user': user, 'images_counter': images_counter} only %}
    </div>
    <div class="col-span-12 grid max-w-160 gap-10 md:col-span-9">
      {{ form_start(form, {attr: {class: 'grid gap-10'}}) }}
        {{ form_errors(form) }}

        <fieldset class="{{ section_class }}">
          <legend class="{{ legend_class }}">{{ 'profile.settings.sections.name'|trans }}</legend>
          {{ form_row(form.firstName) }}
          {{ form_row(form.lastName) }}
          {{ form_row(form.displayNameFormat) }}
          {{ form_row(form.profilePicture) }}
        </fieldset>

        <fieldset class="{{ section_class }}">
          <legend class="{{ legend_class }}">{{ 'profile.settings.sections.preferences'|trans }}</legend>
          {{ form_row(form.preferredLocale) }}
          {{ form_row(form.preferredUnits) }}
          {{ form_row(form.homePark) }}
          {{ form_row(form.preferredReviewLanguages) }}
          {{ form_row(form.addTodayDateWhenRating) }}
          {{ form_row(form.emailNotification) }}
        </fieldset>

        {% if form.apiKey is defined %}
          <fieldset class="{{ section_class }}">
            <legend class="{{ legend_class }}">{{ 'profile.settings.sections.advanced'|trans }}</legend>
            {{ form_row(form.apiKey) }}
          </fieldset>
        {% endif %}

        {{ form_rest(form) }}
        <div>
          <twig:Button block>{{ 'profile.settings.save'|trans }}</twig:Button>
        </div>
      {{ form_end(form) }}

      <section class="grid gap-3 rounded-card border border-line bg-surface p-4" aria-labelledby="delete-account-title">
        <h2 id="delete-account-title" class="m-0 text-lead font-semibold">{{ 'profile.delete_account.title'|trans }}</h2>
        <p class="m-0">{{ 'profile.delete_account.warning'|trans }}</p>
        <ul class="m-0 list-disc pl-5 text-muted-strong">
          <li>{{ 'profile.delete_account.immediate_logout'|trans }}</li>
          <li>{{ 'profile.delete_account.permanent_after_month'|trans }}</li>
        </ul>
        <form method="post" action="{{ path('profile_delete_account') }}" onsubmit="return confirm('{{ 'profile.delete_account.confirm'|trans|e('js') }}');">
          <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_account') }}">
          <twig:Button variant="danger" block>{{ 'profile.delete_account.button'|trans }}</twig:Button>
        </form>
      </section>
    </div>
  </div>
{% endblock %}
