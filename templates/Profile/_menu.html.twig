{% import "helper.html.twig" as helper %}

<div class="cc-panel">
    <div class="cc-panel__body text-center">
    <div class="display-inline-block">
        {{ helper.profilePicture(user) }}
    </div>
    <h6 class="text-semibold no-margin-bottom">
        {{ user.displayName }}
    </h6>
    </div>

    <div class="cc-list-group no-border no-padding-top">
    <a href="{{ path('profile') }}" class="cc-list-group__item">
        {{ ux_icon('heroicons:user', {'class': 'w-4 h-4'}) }}
        {{ 'profile.title'|trans }}
    </a>
    <a href="{{ path('profile_settings') }}" class="cc-list-group__item">
        {{ ux_icon('heroicons:cog-6-tooth', {'class': 'w-4 h-4'}) }}
        {{ 'profile.settings.title'|trans }}
    </a>
    <a href="{{ path('profile_ratings') }}" class="cc-list-group__item">
        {{ ux_icon('heroicons:star', {'class': 'w-4 h-4'}) }}
        {{ 'profile.menu.ratings'|trans }}
        <span class="badge bg-cc-teal-400 pull-right">{{ user.ratings|length }}</span>
    </a>
    <a href="{{ path('user_reviews', {'id': user.id}) }}" class="cc-list-group__item">
        {{ ux_icon('heroicons:megaphone', {'class': 'w-4 h-4'}) }}
        {{ 'profile.menu.reviews'|trans }}
    </a>
    <a href="{{ path('user_tops', {'id': user.id}) }}" class="cc-list-group__item">
        {{ ux_icon('heroicons:clipboard', {'class': 'w-4 h-4'}) }}
        {{ 'profile.menu.tops'|trans }}
    </a>
    {% if images_counter > 0 %}
        <a href="{{ path('user_pictures', {'id': user.id}) }}" class="cc-list-group__item">
        {{ ux_icon('heroicons:camera', {'class': 'w-4 h-4'}) }}
            {{ 'profile.menu.photos'|trans }}
            <span class="badge bg-cc-teal-400 pull-right">{{ images_counter }}</span>
        </a>
    {% endif %}
    <a href="{{ path('map_user', {'id': user.id}) }}" class="cc-list-group__item">
        {{ ux_icon('heroicons:map-pin', {'class': 'w-4 h-4'}) }}
        {{ 'profile.menu.map'|trans }}
    </a>
    </div>
</div>