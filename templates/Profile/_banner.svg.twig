<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="500" height="100" viewBox="0 0 500 100">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#1a2228"/>
      <stop offset="100%" stop-color="#2a363d"/>
    </linearGradient>
    <linearGradient id="accent-bar" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#5d87d5"/>
      <stop offset="40%" stop-color="#ffcd61"/>
      <stop offset="100%" stop-color="#5d87d5"/>
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="500" height="100" rx="5" fill="url(#bg)"/>
  <rect width="3" height="100" rx="1.5" fill="url(#accent-bar)"/>

  <!-- Logo head mark (33.6×32 at 2.15×) -->
  <twig:Logo mark x="14" y="15" width="72.24" height="68.8"/>

  <!-- Stats -->
  <text x="96" y="38" font-family="'Segoe UI', 'Helvetica Neue', Arial, sans-serif" font-size="26" font-weight="700" fill="#ffffff">{{ coasters }}</text>
  <text x="96" y="52" font-family="'Segoe UI', 'Helvetica Neue', Arial, sans-serif" font-size="10" fill="#8899a6" letter-spacing="0.5">COASTERS</text>

  <text x="96" y="76" font-family="'Segoe UI', 'Helvetica Neue', Arial, sans-serif" font-size="17" font-weight="600" fill="#b0bec5">{{ parks }}</text>
  <text x="96" y="90" font-family="'Segoe UI', 'Helvetica Neue', Arial, sans-serif" font-size="9" fill="#667788" letter-spacing="0.3">PARKS</text>

  <text x="148" y="76" font-family="'Segoe UI', 'Helvetica Neue', Arial, sans-serif" font-size="17" font-weight="600" fill="#b0bec5">{{ countries }}</text>
  <text x="148" y="90" font-family="'Segoe UI', 'Helvetica Neue', Arial, sans-serif" font-size="9" fill="#667788" letter-spacing="0.3">COUNTRIES</text>

  <!-- Divider -->
  <line x1="205" y1="12" x2="205" y2="88" stroke="#5d87d5" stroke-width="0.5" opacity="0.2"/>

  <!-- Top 3 -->
  <text x="222" y="22" font-family="'Segoe UI', 'Helvetica Neue', Arial, sans-serif" font-size="11" font-weight="600" fill="#ffcd61" letter-spacing="1.2">MY TOP 3</text>

  <!-- #1 Gold -->
  <circle cx="231" cy="40" r="6" fill="#ffcd61"/>
  <text x="231" y="43" font-family="'Segoe UI', 'Helvetica Neue', Arial, sans-serif" font-size="9" font-weight="700" fill="#1a2228" text-anchor="middle">1</text>
  <text x="244" y="44" font-family="'Segoe UI', 'Helvetica Neue', Arial, sans-serif" font-size="15" font-weight="600" fill="#ffffff">{{ top1 }}</text>

  <!-- Connector -->
  <line x1="231" y1="46" x2="231" y2="55" stroke="#667788" stroke-width="0.5" opacity="0.3"/>

  <!-- #2 Silver -->
  <circle cx="231" cy="61" r="5" fill="#b0bec5"/>
  <text x="231" y="64" font-family="'Segoe UI', 'Helvetica Neue', Arial, sans-serif" font-size="8" font-weight="700" fill="#1a2228" text-anchor="middle">2</text>
  <text x="244" y="65" font-family="'Segoe UI', 'Helvetica Neue', Arial, sans-serif" font-size="13" fill="#c0cdd5">{{ top2 }}</text>

  <!-- Connector -->
  <line x1="231" y1="66" x2="231" y2="75" stroke="#667788" stroke-width="0.5" opacity="0.3"/>

  <!-- #3 Bronze -->
  <circle cx="231" cy="81" r="5" fill="#cd7f32"/>
  <text x="231" y="84" font-family="'Segoe UI', 'Helvetica Neue', Arial, sans-serif" font-size="8" font-weight="700" fill="#1a2228" text-anchor="middle">3</text>
  <text x="244" y="84" font-family="'Segoe UI', 'Helvetica Neue', Arial, sans-serif" font-size="13" fill="#9aabb5">{{ top3 }}</text>

  <!-- Branding -->
  <text x="492" y="95" font-family="'Segoe UI', 'Helvetica Neue', Arial, sans-serif" font-size="8" fill="#4767a3" text-anchor="end" opacity="0.5">captaincoaster.com</text>
</svg>
