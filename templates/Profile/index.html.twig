{% extends "layouts/base.html.twig" %}

{% set title = 'profile.title'|trans %}
{% block title %}{{ title }}{% endblock %}

{% block body %}
    <twig:ProfileHero :user="user" :rank="stats.rank ?? null" :isOwnProfile="true" />

    <twig:ProfileLinks :user="user" :images_counter="images_counter" :isOwnProfile="true" />

    {% if stats|length > 0 %}
      <twig:ProfileScore :score="stats.score" />
      <twig:ProfileProgress :progress="stats.progress" :rank="stats.rank" :milestone="stats.milestone" />
      <twig:ProfileRecords :records="stats.records" />
      <twig:ProfileTaste :taste="stats.taste" />
      <twig:ProfileMostRidden :taste="stats.taste" />
      <twig:ProfileThisYear :thisYear="stats.this_year" />
    {% else %}
      <twig:EmptyState
        icon="tabler:roller-coaster"
        :title="'profile.empty.title'|trans"
        :description="'profile.empty.description'|trans"
        :action="{ url: path('profile_my_coasters', {'tab': 'all'}), text: 'profile.empty.action'|trans }" />
    {% endif %}

    {% if recentActivity|default([])|length > 0 %}
      <section class="mb-6">
        <twig:SectionHeading
          icon="tabler:history"
          iconColor="text-cc-blue-500"
          title="{{ 'profile.activity.title'|trans }}"
          seeAllUrl="{{ path('profile_my_coasters', {'tab': 'rated'}) }}"
          seeAllLabel="{{ 'profile.activity.see_all'|trans }}" />
        <twig:ProfileActivity :activity="recentActivity" />
      </section>
    {% endif %}
{% endblock %}
