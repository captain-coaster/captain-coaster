{% extends "base.html.twig" %}

{% set title = 'profile.title'|trans %}
{% block title %}{{ title }}{% endblock %}

{% block body %}
  <div class="grid grid-cols-12 gap-5 items-start">
    <div class="col-span-12 tablet:col-span-3">
        {% include 'Profile/_menu.html.twig' with {'user': user, 'images_counter': images_counter} only %}
    </div>
    <div class="col-span-12 tablet:col-span-9">
          <!-- stats -->
          {% include 'Profile/user_stats.html.twig' with {'stats': stats} only %}
          <!-- stats -->
          <!-- banner -->
          <div class="cc-panel">
            <div class="cc-panel__body">
              <h4 class="content-group-lg">
                {{ 'profile.banner.title'|trans }}
              </h4>
              <div id="my-banner" class="text-center content-group">
                  {% include 'Profile/banner.html.twig' with {'user': user} only %}
              </div>
            </div>
          </div>
          <!-- banner -->
          <!-- badges -->
          <div class="cc-panel cc-cc-panel--flat">
            <div class="cc-panel__heading">
              <h3 class="cc-panel__title">{{ 'profile.badge'|trans }}</h3>
            </div>
            <div class="cc-panel__body">
              <div class="grid grid-cols-12 gap-5">
                <div class="col-span-12 tablet:col-span-6 desktop:col-span-3 text-center" style="margin-bottom: 40px;">
                  <img src="{{ asset('images/badges/bienvenue-'~app.request.locale~'.png') }}"/>
                </div>
                {% for badge in user.badges %}
                  <div class="col-span-12 tablet:col-span-6 desktop:col-span-3 text-center" style="margin-bottom: 40px;">
                    <img src="{{ asset('images/badges/'~badge.filename(app.request.locale)) }}"/>
                  </div>
                {% endfor %}
              </div>
            </div>
          </div>
          <!-- /badges -->
    </div>
  </div>
{% endblock %}
