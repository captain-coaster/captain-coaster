{% extends "layouts/base.html.twig" %}

{% set title = park.name %}
{% set subTitle = park.country.name|trans([], 'database') %}
{% block title %}{{ title }} • {{ subTitle }}{% endblock %}

{% block hero %}
  <twig:ParkHero :park="park" :country="subTitle" :bestCoaster="stats.bestRanked" />
{% endblock %}

{% block body %}

  {# ── Personal progress ───────────────────────────────────────────────── #}
  {% if is_granted('ROLE_USER') and parkStats and parkStats.operatingTotal > 0 %}
    <twig:ParkProgressBar :stats="parkStats" />
  {% elseif not is_granted('ROLE_USER') and stats.operating > 0 %}
    {# Anonymous: show 0/X progress with login nudge #}
    <section class="bg-surface rounded-2xl border border-line p-4 mb-6">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-sm font-semibold text-content inline-flex items-center gap-1.5">
          {{ ux_icon('tabler:target-arrow', {'class': 'w-4 h-4 text-cc-blue-500', 'aria-hidden': 'true'}) }}
          {{ 'park.progress.title'|trans }}
        </h2>
        <div class="text-sm font-bold text-content tabular-nums">
          0<span class="text-content-muted font-normal">/{{ stats.operating }}</span>
          <span class="ml-1 text-xs font-medium text-content-muted">(0%)</span>
        </div>
      </div>
      <div class="h-3 rounded-full bg-surface-strong" role="img" aria-label="{{ 'park.progress.aria'|trans({'rated': 0, 'ridden': 0, 'total': stats.operating}) }}"></div>
      <a href="{{ path('login') }}"
         class="mt-3 inline-flex items-center gap-1.5 text-xs text-cc-blue-600 dark:text-cc-blue-400 hover:underline font-medium">
        {{ ux_icon('tabler:user-plus', {'class': 'w-3.5 h-3.5', 'aria-hidden': 'true'}) }}
        {{ 'park.login_to_rate'|trans }}
      </a>
    </section>
  {% endif %}

  {# ── Coasters — grouped sections ─────────────────────────────────────── #}

  {# Soon: rumored / announced / in construction #}
  {% if groupedCoasters.soon|length > 0 %}
    <section class="mb-8">
      <twig:SectionHeading
        icon="tabler:clock-hour-4"
        iconColor="text-cc-blue-500"
        :title="'park.coasters.soon'|trans"
        :count="groupedCoasters.soon|length"
      />
      <div class="space-y-2">
        {% for coaster in groupedCoasters.soon %}
          <twig:ProfileCoasterRow
            :coaster="coaster"
            :riddenCoaster="riddenCoasters[coaster.id] ?? null"
            :wishlist="wishlists[coaster.id] ?? null"
            :showManufacturer="true"
          />
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {# New: soft opening + operating opened this year #}
  {% if groupedCoasters.new|length > 0 %}
    <section class="mb-8">
      <twig:SectionHeading
        icon="tabler:sparkles"
        iconColor="text-cc-warm-500"
        :title="'park.coasters.new'|trans"
        :count="groupedCoasters.new|length"
      />
      <div class="space-y-2">
        {% for coaster in groupedCoasters.new %}
          <twig:ProfileCoasterRow
            :coaster="coaster"
            :riddenCoaster="riddenCoasters[coaster.id] ?? null"
            :wishlist="wishlists[coaster.id] ?? null"
            :showManufacturer="true"
          />
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {# Main: operating + closed temporarily #}
  {% if groupedCoasters.main|length > 0 %}
    <section class="mb-8">
      <twig:SectionHeading
        icon="tabler:roller-coaster"
        iconColor="text-cc-blue-500"
        :title="'park.coasters.title'|trans"
        :count="groupedCoasters.main|length"
      />
      <div class="space-y-2">
        {% for coaster in groupedCoasters.main %}
          <twig:ProfileCoasterRow
            :coaster="coaster"
            :riddenCoaster="riddenCoasters[coaster.id] ?? null"
            :wishlist="wishlists[coaster.id] ?? null"
            :showManufacturer="true"
          />
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {# Legacy: retracked / relocated / closed definitely #}
  {% if groupedCoasters.legacy|length > 0 %}
    <section class="mb-8">
      <twig:SectionHeading
        icon="tabler:history"
        iconColor="text-cc-blue-500"
        :title="'park.coasters.legacy'|trans"
        :count="groupedCoasters.legacy|length"
      />
      <div class="space-y-2">
        {% for coaster in groupedCoasters.legacy %}
          <twig:ProfileCoasterRow
            :coaster="coaster"
            :riddenCoaster="riddenCoasters[coaster.id] ?? null"
            :wishlist="wishlists[coaster.id] ?? null"
            :showManufacturer="true"
          />
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {# Empty state when no coasters at all #}
  {% if coasters|length == 0 %}
    <section class="mb-8">
      <twig:SectionHeading
        icon="tabler:roller-coaster"
        iconColor="text-cc-blue-500"
        :title="'park.coasters.title'|trans"
      />
      <twig:EmptyState
        icon="tabler:roller-coaster"
        :title="'park.no_coasters'|trans"
        :description="'park.no_coasters_desc'|trans"
      />
    </section>
  {% endif %}

  {# ── Nearby parks ───────────────────────────────────────────────────── #}
  {% if closestParks|length > 0 %}
    <section class="mb-8">
      <twig:SectionHeading
        icon="tabler:map-pin"
        iconColor="text-cc-blue-500"
        :title="'park.nearby'|trans"
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {% for nearbyPark in closestParks %}
          <a href="{{ path('park_show', {'id': nearbyPark.id, 'slug': nearbyPark.slug}) }}"
             class="relative flex items-center gap-3 bg-surface rounded-2xl border border-line hover:border-cc-blue-300 dark:hover:border-cc-blue-700 transition-all group overflow-hidden">
            {# Best coaster thumbnail #}
            <div class="shrink-0 w-16 h-16 bg-surface-muted">
              {% if nearbyPark.bestCoasterImage %}
                <img src="{{ pictures_cdn }}/280x210/{{ nearbyPark.bestCoasterImage }}"
                     alt="{{ nearbyPark.name }}"
                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                     loading="lazy">
              {% else %}
                <div class="w-full h-full flex items-center justify-center">
                  {{ ux_icon('tabler:map-pin', {'class': 'w-6 h-6 text-neutral-400', 'aria-hidden': 'true'}) }}
                </div>
              {% endif %}
            </div>
            {# Park info #}
            <div class="flex-1 min-w-0 py-3 pr-3">
              <p class="font-medium text-sm text-content truncate group-hover:text-cc-blue-600 dark:group-hover:text-cc-blue-400 transition-colors">{{ nearbyPark.name }}</p>
              <p class="text-xs text-content-muted">{{ units.km_or_mi(nearbyPark.distance) }}</p>
            </div>
          </a>
        {% endfor %}
      </div>
    </section>
  {% endif %}

{% endblock %}
