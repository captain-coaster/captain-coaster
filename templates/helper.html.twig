{# Display profile picture, or an initials avatar for users without one #}
{% macro profilePicture(user, className) %}
    {% if user.profilePicture %}
        <img src="{{ pictures_cdn ~ '/profile-pictures/' ~ user.profilePicture }}"
             class="{{ className|default('img-circle img-lg') }}"
             alt="{{ user.displayName }}">
    {% else %}
        <img src="{{ avatar_placeholder(user.displayName, user.id) }}"
             class="{{ className|default('img-circle img-lg') }}"
             alt="{{ user.displayName }}">
    {% endif %}
{% endmacro %}

{# Display a coaster related date #}
{% macro displayDate(date) %}
    {% if date|date("dm") == "0101" %}
        {{ date|date("Y") }}
    {% else %}
        {{ date|format_datetime('short', 'none') }}
    {% endif %}
{% endmacro %}

{# A full <picture> element: avif -> jpg fallback, each with a 1x/2x density pair off the
   same source filename (signed_picture_url(), backed by PictureUrlSigner) -- the browser
   picks whichever format it supports and whichever density its screen needs, so a
   standard-density screen isn't stuck downloading 4x the pixels a retina screen actually
   needs. No webp source: real cache data across every size on the site showed avif+jpg
   already cover ~98.5% of requests (avif for anything modern, jpg fallback for the rest --
   old Safari, in-app WebViews, preview bots), webp never topped 5% on any single size and
   was 0% on several -- not worth a third encode/cache/request path for that. width/height
   are the real CSS display size (1x), not pre-doubled. Only for a plain drop-in image; a
   component needing its own classes/attributes on <img> (hover states, object-fit, a fixed
   aspect box) calls signed_picture_url() directly instead of going through this macro. #}
{% macro picture(filename, width, height, alt, imgClass = '', loading = 'lazy', imgStyle = '', fetchpriority = '') %}
    <picture>
        <source srcset="{{ signed_picture_url(filename, width, height, 'avif') }} 1x, {{ signed_picture_url(filename, width * 2, height * 2, 'avif') }} 2x" type="image/avif">
        <img src="{{ signed_picture_url(filename, width, height, 'jpg') }}" srcset="{{ signed_picture_url(filename, width, height, 'jpg') }} 1x, {{ signed_picture_url(filename, width * 2, height * 2, 'jpg') }} 2x" alt="{{ alt }}" class="{{ imgClass }}" loading="{{ loading }}"{% if imgStyle %} style="{{ imgStyle }}"{% endif %}{% if fetchpriority %} fetchpriority="{{ fetchpriority }}"{% endif %}>
    </picture>
{% endmacro %}

{# Color magic for ratings - Legacy support #}
{% macro ratingColor(score) %}
    hsl({{ score * 1.2 }}, 50%, 50%)
{% endmacro %}

{# Display coaster rank variation #}
{% macro variation(coaster) %}
    {% if coaster.previousRank is empty %}
        <span class="cc-badge cc-badge--flat border-warning-600 text-warning-600">new</span>
    {% elseif coaster.previousRank < coaster.rank %}
        <span class="cc-badge cc-badge--flat border-danger-600 text-danger-600">
      {{ ux_icon('bxs:down-arrow', {'class': 'w-4 h-4'}) }} {{ (coaster.rank - coaster.previousRank)|abs }}
    </span>
    {% elseif coaster.previousRank > coaster.rank %}
        <span class="cc-badge cc-badge--flat border-success-600 text-success-600">
      {{ ux_icon('bxs:up-arrow', {'class': 'w-4 h-4'}) }} {{ (coaster.rank - coaster.previousRank)|abs }}
    </span>
    {% elseif coaster.previousRank == coaster.rank %}
        <span class="cc-badge cc-badge--flat border-primary-600 text-primary-600">{{ ux_icon('bxs:right-arrow', {'class': 'w-4 h-4'}) }}</span>
    {% endif %}
{% endmacro %}

