<!DOCTYPE html>
<html lang="{{ app.request.get('_locale') }}" class="has-[dialog:modal]:overflow-hidden" data-symfony-ux-translator-locale="{{ app.request.locale }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ 'app.title.default'|trans }}{% endblock %} • {{ 'app.name'|trans }}</title>
  {# Fixed URLs in public/, built from assets/images/logo_head.svg. sizes="32x32" keeps Chrome from preferring the .ico over the SVG. #}
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.json">
  <meta name="apple-mobile-web-app-title" content="{{ 'app.name'|trans }}">
  {# The canvas token (--bg), so the browser chrome runs into the page. #}
  <meta name="theme-color" content="#F3F6FB">
  {% block header %}{% endblock %}
  {# Hashed URL comes from the build manifest; the Vite dev server serves fonts itself. #}
  {% if app.environment != 'dev' %}
    <link rel="preload" href="{{ asset('build/assets/fonts/source-sans-3-latin.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ asset('build/assets/fonts/barlow-condensed-600-latin.woff2') }}" as="font" type="font/woff2" crossorigin>
  {% endif %}
  {{ reprise_entry_link_tags('app') }}
  {% if app.environment != 'dev' %}
  <script defer src="https://umami.captaincoaster.com/script.js" data-website-id="f4b63258-75c9-45d8-a774-40e0a228aa50"></script>
  {% endif %}
  {% block stylesheets %}{% endblock %}
</head>
{# Active nav section, shared by Nav:Header and Nav:TabBar. #}
{% set nav_route = app.request.attributes.get('_route')|default('') %}
{% set nav_section =
  nav_route == 'default_index' ? 'home' :
  (nav_route starts with 'ranking' ? 'ranking' :
  (nav_route in ['search_index', 'coaster_search_index'] ? 'search' :
  (nav_route == 'map_index' ? 'map' :
  (nav_route starts with 'profile' or nav_route starts with 'notification' or nav_route in ['login', 'app_register'] ? 'profile' : null))))
%}
{# Below lg, room for the floating tab bar (h-16 + 3 spacing + safe area) plus air. #}
<body class="max-lg:pb-[calc(var(--spacing)*24+env(safe-area-inset-bottom))]" data-controller="filter-sheet search-dialog">
<a href="#content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[10000] focus:rounded-control focus:bg-surface focus:px-4 focus:py-3 focus:text-action focus:shadow-overlay">{{ 'app.skip_to_content'|trans }}</a>
<twig:Nav:Header :section="nav_section"/>
<!-- page container -->
<div class="page-container">
  <!-- page content -->
  <div class="page-content">
    {% block secondary_sidebar %}{% endblock %}
    <!-- main content -->
    <div class="content-wrapper">
      {% block wide_body %}
        {# Pages set title/subTitle(+Url)/secondaryTitle, parentUrl (detail pages: back button) and pageActions (captured HTML). #}
        <twig:Page:Header
          title="{{ title|default('app.title.default'|trans) }}"
          :subtitle="subTitle|default(null)"
          :subtitleUrl="subTitleUrl|default(null)"
          :secondary="secondaryTitle|default(null)"
          :parent="parentUrl|default(null)"
          :actions="pageActions|default(null)"
          :hideTitle="hideTitle|default(false)"
          :narrow="narrowHeader|default(false)"/>
        <!-- Content area -->
        <main id="content" tabindex="-1" class="content mx-auto outline-none flow-root w-full max-w-content px-gutter">
          {{ include('flashes.html.twig') }}
          <div id="toasts" data-controller="toast" data-toast-target="container"></div>

          {% block body %}{% endblock %}
        </main>
        <!-- /content area -->
        <twig:Nav:Footer/>
      {% endblock %}
    </div>
    <!-- /main content -->
  </div>
  <!-- /page content -->
</div>
<!-- /page container -->
<twig:Nav:TabBar :section="nav_section"/>
<twig:Nav:SearchDialog/>
<twig:JsIcons/>

<!-- Core JS files -->
{{ reprise_entry_script_tags('app') }}

<script src="{{ asset('bundles/fosjsrouting/js/router.js') }}"></script>
<script src="{{ path('fos_js_routing_js', { callback: 'fos.Router.setData' }) }}"></script>

<!-- Page-specific entries -->
{% block javascripts %}{% endblock %}
</body>
</html>
