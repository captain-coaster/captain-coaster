<!DOCTYPE html>
<html lang="{{ app.request.get('_locale') }}" class="has-[dialog:modal]:overflow-hidden" data-symfony-ux-translator-locale="{{ app.request.locale }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ 'app.title.default'|trans }}{% endblock %} • {{ 'app.name'|trans }}</title>
  {# Fixed URLs in public/, drawn from the head mark in components/Logo.html.twig. sizes="32x32" keeps Chrome from preferring the .ico over the SVG. #}
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="apple-mobile-web-app-title" content="{{ 'app.name'|trans }}">
  {# The browser chrome runs into the top of the page: the brand token (--brand) where it opens on the brand surface
     (Nav:Header from lg, a band page below), the canvas token (--bg) elsewhere. Dark mode adds prefers-color-scheme to these media. #}
  <meta name="theme-color" media="(min-width: 64rem)" content="#1A2C57">
  <meta name="theme-color" media="(max-width: 63.99rem)" content="{{ headerBand|default(false) ? '#1A2C57' : '#F3F6FB' }}">
  {# An indexable page sets `canonical` ({route, params}): its canonical URL and its language versions (every locale and
     x-default), the same as its sitemap.xml entry (SitemapEntries). Built from the entity, so a query string or a wrong
     slug in the address points back to the one URL. #}
  {% if canonical is defined %}
    {% set canonicalParams = canonical.params|default({}) %}
    <link rel="canonical" href="{{ url(canonical.route, canonicalParams|merge({_locale: app.request.locale})) }}">
    {% for locale in locales %}
      <link rel="alternate" hreflang="{{ locale }}" href="{{ url(canonical.route, canonicalParams|merge({_locale: locale})) }}">
    {% endfor %}
    <link rel="alternate" hreflang="x-default" href="{{ url(canonical.route, canonicalParams|merge({_locale: locales|first})) }}">
  {% endif %}
  {% block header %}{% endblock %}
  {# Hashed URL comes from the build manifest; the Vite dev server serves fonts itself. #}
  {% if app.environment != 'dev' %}
    <link rel="preload" href="{{ asset('build/assets/fonts/source-sans-3-latin.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ asset('build/assets/fonts/barlow-condensed-600-latin.woff2') }}" as="font" type="font/woff2" crossorigin>
  {% endif %}
  {{ reprise_entry_link_tags('app') }}
  {% block stylesheets %}{% endblock %}
</head>
{# Active nav section, shared by Nav:Header and Nav:TabBar. #}
{% set nav_route = app.request.attributes.get('_route')|default('') %}
{% set nav_section =
  nav_route == 'default_index' ? 'home' :
  (nav_route starts with 'ranking' ? 'ranking' :
  (nav_route in ['search_index', 'coaster_search_index'] ? 'search' :
  (nav_route == 'map_index' ? 'map' :
  (nav_route starts with 'profile' or nav_route starts with 'notification' or nav_route in ['login', 'app_register'] ? 'profile' : null))))
%}
{# pageSurface: an edge-to-edge page (ledger, photos) sits on white instead of the canvas. #}
<body {% if pageSurface|default(false) %}class="bg-surface"{% endif %} data-controller="filter-sheet search-dialog">
<a href="#content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[10000] focus:rounded-control focus:bg-surface focus:px-4 focus:py-3 focus:text-action focus:shadow-overlay">{{ 'app.skip_to_content'|trans }}</a>
<twig:Nav:Header :section="nav_section"/>
{# Full width, above the side column: the band and the footer run edge to edge. #}
{% block page_header %}
  {# Pages set title/subTitle(+Url)/secondaryTitle, parentUrl (detail pages: back button), pageActions and pageMeta (captured HTML), headerBand (the brand band). #}
  <twig:Page:Header
    title="{{ title|default('app.title.default'|trans) }}"
    :shortTitle="shortTitle|default(null)"
    :subtitle="subTitle|default(null)"
    :subtitleUrl="subTitleUrl|default(null)"
    :secondary="secondaryTitle|default(null)"
    :parent="parentUrl|default(null)"
    :actions="pageActions|default(null)"
    :meta="pageMeta|default(null)"
    :band="headerBand|default(false)"
    :tagline="headerTagline|default(null)"
    :hideTitle="hideTitle|default(false)"
    :narrow="narrowHeader|default(false)"/>
{% endblock %}
{# The page container: one content width and gutter (DESIGN.md, Layout) shared with Nav:Header, the band and the footer,
   so everything starts on the same left edge. A page's side column (secondary_sidebar: <twig:FilterPanel>) sits inside it. #}
{% block shell %}
  <div class="mx-auto flex w-full max-w-content grow px-gutter md:gap-8 lg:gap-10 {{ headerBand|default(false) ? 'pt-4 md:pt-6' }}">
    {% block secondary_sidebar %}{% endblock %}
    <main id="content" tabindex="-1" class="flow-root min-w-0 flex-1 outline-none">
      {# Flashes keep to the text column, or the centered narrow column of narrowHeader pages. #}
      <div class="{{ narrowHeader|default(false) ? 'mx-auto max-w-narrow' : 'max-w-text' }}">{{ include('flashes.html.twig') }}</div>
      <div id="toasts" data-controller="toast" data-toast-target="container"></div>

      {% block body %}{% endblock %}
    </main>
  </div>
{% endblock %}
{% block page_footer %}<twig:Nav:Footer/>{% endblock %}
<twig:Nav:TabBar :section="nav_section"/>
<twig:Nav:SearchDialog/>
<twig:JsIcons/>

<!-- Core JS files -->
{{ reprise_entry_script_tags('app') }}

<script src="{{ asset('bundles/fosjsrouting/js/router.js') }}"></script>
<script src="{{ path('fos_js_routing_js', { callback: 'fos.Router.setData' }) }}"></script>

<!-- Page-specific entries -->
{% block javascripts %}{% endblock %}
</body>
</html>
