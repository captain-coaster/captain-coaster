{% set currentRoute = app.request.attributes.get('_route') %}
{% set routeParams = app.request.attributes.get('_route_params')|default({}) %}

<div class="md:ml-(--sidebar-width)">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      {# Locale switcher #}
      {% if currentRoute %}
        <div class="flex items-center gap-1 text-xs">
          {% for locale in locales %}
            <a href="{{ path(currentRoute, routeParams|merge({_locale: locale})) }}"
               class="px-2 py-1 rounded-md uppercase font-medium transition-colors
                      {{ locale == app.request.locale
                         ? 'bg-cc-blue-100 dark:bg-cc-blue-900/40 text-cc-blue-700 dark:text-cc-blue-300'
                         : 'text-content-muted hover:bg-surface-muted hover:text-content' }}"
               aria-label="{{ locale }}">
              {{ locale }}
            </a>
          {% endfor %}
        </div>
      {% else %}
        <div></div>
      {% endif %}

      {# Legal + copyright #}
      <div class="flex items-center gap-3 text-xs text-content-muted flex-wrap justify-center sm:justify-end">
        <a href="{{ path('app_terms_conditions') }}" class="hover:text-cc-blue-600 dark:hover:text-cc-blue-400 transition-colors">{{ 'footer.terms'|trans }}</a>
        <span>·</span>
        <a href="{{ path('ranking_learn_more') }}" class="hover:text-cc-blue-600 dark:hover:text-cc-blue-400 transition-colors">{{ 'footer.legal.about_ranking'|trans }}</a>
        <span>·</span>
        <a href="{{ path('default_contact') }}" class="hover:text-cc-blue-600 dark:hover:text-cc-blue-400 transition-colors">{{ 'sidebar.contact'|trans({}, 'navigation') }}</a>
        <span class="hidden sm:inline">·</span>
        <span class="inline-flex items-center gap-1">
          <span>© 2017–{{ 'now'|date('Y') }} {{ 'app.name'|trans }}</span>
        </span>
      </div>
    </div>
  </div>
</div>
