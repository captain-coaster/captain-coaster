          <span data-drawer-target="openIcon">
            {{ ux_icon('tabler:menu-2', {'class': 'w-6 h-6', 'aria-hidden': 'true'}) }}
          </span>
          <span class="hidden" data-drawer-target="closeIcon">
            {{ ux_icon('tabler:x', {'class': 'w-6 h-6', 'aria-hidden': 'true'}) }}
          </span>
        </twig:IconButton>

