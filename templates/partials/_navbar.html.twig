      </div>

      {# Center section: Search (desktop) #}
      <div class="hidden md:flex flex-1 max-w-lg mx-8">
        <twig:SearchInput />
      </div>

      {# Right section: Actions #}
      <div class="flex items-center -mr-1">
        {# Mobile search button - dispatches modal:open event #}
        <twig:IconButton
          icon="tabler:search"
          class="md:hidden"
          data-action="global#openModal"
          data-global-modal-id-param="searchModal"
          :label="'nav.search.label'|trans({}, 'navigation')"
        />

        {# Editor saved indicator #}
        <span id="editor-saved" class="hidden px-2 py-1 text-xs font-medium text-green-800 bg-green-100 dark:text-green-200 dark:bg-green-900/30 rounded-full"></span>

        {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
          {# Notifications bell icon with badge count #}
          <div class="relative" data-controller="dropdown">
            <twig:IconButton
              data-action="click->dropdown#toggle"
              data-dropdown-target="button"
              aria-expanded="false"
              :label="'nav.notifications.label'|trans({}, 'navigation')"
            >
              <span class="relative inline-flex">
                {{ ux_icon('tabler:bell', {'class': 'w-5 h-5', 'aria-hidden': 'true'}) }}
                {% if app.user.unreadNotifications|length > 0 %}
                  <span class="absolute -top-1.5 -right-1.5 inline-flex items-center justify-center min-w-4 h-4 px-1 text-[0.625rem] font-bold leading-none text-white bg-cc-blue-600 rounded-full">{{ app.user.unreadNotifications|length }}</span>
                {% endif %}
              </span>
            </twig:IconButton>
            <div class="absolute right-0 z-50 mt-2 w-80 bg-surface-sunken rounded-xl shadow-lg border border-line-strong hidden" data-dropdown-target="menu">
              <div class="px-4 py-3 border-b border-line-strong">
                <h3 class="text-sm font-semibold text-content">{{ 'notif.title'|trans }}</h3>
              </div>
              <div class="max-h-64 overflow-y-auto">
                {% for notif in app.user.unreadNotifications %}
                  <a class="flex items-start space-x-3 px-4 py-3 hover:bg-surface-muted transition-colors duration-200" href="{{ path('notification_read', {'id': notif.id}) }}">
                    <div class="shrink-0 w-8 h-8 bg-cc-blue-100 dark:bg-cc-blue-900/30 rounded-full flex items-center justify-center">
                      {{ ux_icon('tabler:star-filled', {'class': 'w-4 h-4 text-cc-blue-600 dark:text-cc-blue-400', 'aria-hidden': 'true'}) }}
                    </div>
                    <div class="flex-1 min-w-0">
                      <p class="text-sm text-content">{{ notif.message|trans({'%name%': notif.parameter|trans}) }}</p>
                      <p class="text-xs text-content-muted mt-1">{{ notif.createdAt|ago }}</p>
                    </div>
                  </a>
                {% else %}
                  <div class="px-4 py-8 text-center text-content-muted">
                    <p class="text-sm">{{ 'notif.empty'|trans }}</p>
                  </div>
                {% endfor %}
              </div>
            </div>
          </div>

          {# User avatar — opens the personal menu (account links + logout) #}
          <twig:ProfileMenu />
        {% else %}
          {# Login button #}
          <a class="hidden lg:inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-cc-blue-600 hover:bg-cc-blue-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-cc-blue-500/50 transition-colors duration-200" href="{{ path('login') }}">{{ 'navbar.login'|trans({}, 'navigation') }}</a>
          <twig:IconButton
            href="{{ path('login') }}"
            icon="tabler:user"
            class="lg:hidden"
            :label="'navbar.login'|trans({}, 'navigation')"
          />
        {% endif %}
      </div>
    </div>
  </div>
</nav>

{# Mobile Drawer - Must be outside nav for proper z-index stacking #}
{% include 'partials/_drawer.html.twig' %}
</div>

{# Mobile search modal - Full screen search experience #}
<div class="fixed inset-0 z-50 hidden" data-controller="modal" data-modal-id-value="searchModal" aria-labelledby="searchModalLabel" aria-hidden="true">
  <div class="fixed inset-0 bg-neutral-50 dark:bg-neutral-900">
    <div class="flex flex-col h-full">
      {# Search header #}
      <div class="flex items-center gap-3 px-4 py-3 border-b border-line-strong">
        <twig:SearchInput variant="mobile" />
        <twig:IconButton
          icon="tabler:x"
          data-action="click->modal#close"
          :label="'nav.close'|trans({}, 'navigation')"
        />
      </div>
    </div>
  </div>
</div>
