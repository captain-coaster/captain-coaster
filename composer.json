{
    "name": "captain-coaster/captain-coaster",
    "license": "MIT",
    "type": "project",
    "description": "Participative guide to discover, rate and review roller coasters",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "api-platform/core": "^4.0",
        "aws/aws-sdk-php": "^3.0",
        "beberlei/doctrineextensions": "^1.3",
        "doctrine/doctrine-bundle": "^2.0",
        "doctrine/doctrine-migrations-bundle": "^3.0",
        "doctrine/orm": "^3.3",
        "easycorp/easyadmin-bundle": "^4",
        "friendsofsymfony/jsrouting-bundle": "^3.0",
        "knplabs/knp-paginator-bundle": "^6",
        "knplabs/knp-time-bundle": "^2",
        "knpuniversity/oauth2-client-bundle": "^2.15",
        "league/flysystem-aws-s3-v3": "^3",
        "league/oauth2-google": "^4",
        "oneup/flysystem-bundle": "^4",
        "pixelopen/cloudflare-turnstile-bundle": "^0.5.0",
        "stof/doctrine-extensions-bundle": "^1.14",
        "symfony/amazon-mailer": "8.*",
        "symfony/asset": "8.*",
        "symfony/cache": "7.*",
        "symfony/discord-notifier": "8.*",
        "symfony/dotenv": "8.*",
        "symfony/expression-language": "8.*",
        "symfony/flex": "^2.0",
        "symfony/form": "8.*",
        "symfony/http-client": "8.*",
        "symfony/lock": "8.*",
        "symfony/mailer": "8.*",
        "symfony/monolog-bundle": "^4.0",
        "symfony/notifier": "8.*",
        "symfony/rate-limiter": "8.*",
        "symfony/runtime": "8.*",
        "symfony/security-bundle": "8.*",
        "symfony/stimulus-bundle": "^3.3",
        "symfony/stopwatch": "8.*",
        "symfony/translation": "8.*",
        "symfony/twig-bundle": "8.*",
        "symfony/ux-icons": "^2.31",
        "symfony/ux-translator": "^3.3",
        "symfony/validator": "8.*",
        "symfony/webpack-encore-bundle": "^2.0",
        "twig/cssinliner-extra": "^3.8",
        "twig/extra-bundle": "^3.8",
        "twig/inky-extra": "^3.8",
        "twig/intl-extra": "^3.8"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "3.95.18",
        "giorgiosironi/eris": "^1.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "8.*",
        "symfony/css-selector": "8.*",
        "symfony/debug-bundle": "8.*",
        "symfony/maker-bundle": "^1.0",
        "symfony/web-profiler-bundle": "8.*"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.5.4"
        },
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install --symlink --relative %PUBLIC_DIR%": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "phpstan": "vendor/bin/phpstan"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "8.*"
        }
    }
}
