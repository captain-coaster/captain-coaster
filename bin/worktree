#!/bin/sh
# Worktree lifecycle: provision, inspect, clean up.
set -eu

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SELF_DIR/lib/worktree-lib.sh"

die() { printf '%s\n' "$*" >&2; exit 1; }

cmd_setup() {
    root=$(git rev-parse --show-toplevel)
    main=$(wt_main_checkout)

    if [ "$root" = "$main" ]; then
        printf 'Main checkout, nothing to provision.\n'
        return 0
    fi

    name=$(basename "$root")
    db=$(wt_db_name "$name")
    idx=$(wt_redis_index "$name")

    [ -f "$main/.env.local" ] || die "No .env.local in the main checkout ($main). Create it first."

    # .env.local must be a symlink so secrets live in exactly one place and cannot drift.
    if [ -L "$root/.env.local" ]; then
        :
    elif [ -f "$root/.env.local" ]; then
        if cmp -s "$root/.env.local" "$main/.env.local"; then
            :
        else
            backup="$root/.env.local.orphan-$(date +%Y%m%d%H%M%S)"
            mv "$root/.env.local" "$backup"
            printf 'NOTE: this worktree had a diverged .env.local. Kept it at %s\n' "$backup"
        fi
    fi
    [ -L "$root/.env.local" ] || ln -sf "$main/.env.local" "$root/.env.local"

    # Per-worktree overrides. Symfony loads .env.dev.local after .env.local, so these win.
    base_dsn=$(sed -n 's/^DATABASE_URL=//p' "$main/.env.local" | tail -1 | tr -d '"')
    base_redis=$(sed -n 's/^REDIS_URL=//p' "$main/.env.local" | tail -1 | tr -d '"')
    [ -n "$base_dsn" ] || die "No DATABASE_URL in $main/.env.local"
    [ -n "$base_redis" ] || base_redis="redis://localhost:6379/0"

    tmp="$root/.env.dev.local.tmp"
    {
        printf '# Generated by bin/worktree setup. Do not edit; re-run setup instead.\n'
        printf '# Secrets stay in .env.local, which is a symlink to the main checkout.\n'
        printf 'DATABASE_URL=%s\n' "$(wt_dsn_with_db "$base_dsn" "$db")"
        printf 'REDIS_URL=%s\n' "$(wt_redis_url_with_index "$base_redis" "$idx")"
    } > "$tmp"

    if [ -f "$root/.env.dev.local" ] && cmp -s "$tmp" "$root/.env.dev.local"; then
        rm "$tmp"
    else
        mv "$tmp" "$root/.env.dev.local"
        printf 'Wrote .env.dev.local (db=%s, redis=%s)\n' "$db" "$idx"
    fi

    # Shared containers, pinned project name, so this is safe from any worktree.
    docker compose --project-directory "$main" up -d >/dev/null 2>&1 || true

    # Tests set this to exercise env provisioning without a minute-long clone.
    [ "${WT_SKIP_DB_CLONE:-}" = 1 ] && return 0

    "$SELF_DIR/db" clone "$db"
}

# A worktree is stale when git can no longer reach it, or its PR is finished.
wt_pr_state() {
    [ -n "$1" ] || { printf 'none'; return; }
    state=$(gh pr list --state all --head "$1" --json state -q '.[0].state' 2>/dev/null || true)
    [ -n "$state" ] || state=none
    printf '%s' "$state"
}

wt_db_size_mb() {
    # </dev/null: bin/db list shells out to `docker exec -i`, which otherwise
    # inherits our caller's stdin — the worktree-list pipe in cmd_status — and
    # drains the remaining rows out from under its `while read` loop.
    "$SELF_DIR/db" list < /dev/null 2>/dev/null | awk -F'\t' -v d="$1" '$1 == d {print $2; found=1} END {if (!found) print "-"}'
}

cmd_status() {
    stale_only=false
    [ "${1:-}" = "--stale-only" ] && stale_only=true
    main=$(wt_main_checkout)

    # OFS is a single non-whitespace unit separator, not a tab: POSIX treats
    # tab as "IFS whitespace" and collapses empty fields sitting between two
    # of them (e.g. a detached-HEAD row's empty branch field), silently
    # shifting prunable into branch. \037 is never collapsed.
    git worktree list --porcelain | awk -v OFS="$(printf '\037')" '
        /^worktree /  { path = substr($0, 10); branch = ""; prunable = "no" }
        /^branch /    { branch = substr($0, 8); sub("refs/heads/", "", branch) }
        /^prunable /  { prunable = "yes" }
        /^$/          { if (path != "") print path, branch, prunable; path = "" }
        END           { if (path != "") print path, branch, prunable }
    ' | while IFS="$(printf '\037')" read -r path branch prunable; do
        if [ "$path" = "$main" ]; then
            pr=local; db="captain"; stale=no
        else
            pr=$(wt_pr_state "$branch")
            db=$(wt_db_name "$(basename "$path")")
            stale=no
            case "$pr" in MERGED|CLOSED) stale=yes ;; esac
            [ "$prunable" = "yes" ] && stale=yes
        fi
        size=$(wt_db_size_mb "$db")
        idx=$([ "$path" = "$main" ] && printf '0' || wt_redis_index "$(basename "$path")")
        if [ "$stale_only" = true ] && [ "$stale" != yes ]; then
            continue
        fi
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$path" "${branch:-detached}" "$pr" "$db" "$size" "$idx" "$stale"
    done
}

cmd_gc() {
    confirm=${1:-}
    main=$(wt_main_checkout)

    # The loop body runs in a subshell, so it must not set variables the
    # caller needs afterwards. It only prints and removes.
    cmd_status --stale-only | while IFS="$(printf '\t')" read -r path branch pr db size idx stale; do
        [ "$path" != "$main" ] || continue
        if [ "$confirm" != "--yes" ]; then
            printf 'Would remove %s (branch %s, PR %s, database %s, %s MB)\n' \
                "$path" "$branch" "$pr" "$db" "$size"
            continue
        fi
        printf 'Removing %s...\n' "$path"
        git worktree remove --force "$path" 2>/dev/null || true
        if [ "$branch" != detached ] && [ -n "$branch" ]; then
            git branch -D "$branch" 2>/dev/null || true
        fi
        "$SELF_DIR/db" drop "$db" --yes >/dev/null 2>&1 || true
    done

    git worktree prune

    if [ "$confirm" != "--yes" ]; then
        printf '\nRe-run with --yes to apply.\n'
    fi
}

case "${1:-}" in
    setup)  shift; cmd_setup "$@" ;;
    status) shift; cmd_status "$@" ;;
    gc)     shift; cmd_gc "$@" ;;
    *) die "usage: bin/worktree {setup|status [--stale-only]|gc [--yes]}" ;;
esac
