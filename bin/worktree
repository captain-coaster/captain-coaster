#!/bin/sh
# Worktree lifecycle: provision, inspect, clean up.
set -eu

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SELF_DIR/lib/worktree-lib.sh"

die() { printf '%s\n' "$*" >&2; exit 1; }

cmd_setup() {
    root=$(git rev-parse --show-toplevel)
    main=$(wt_main_checkout)

    if [ "$root" = "$main" ]; then
        printf 'Main checkout, nothing to provision.\n'
        return 0
    fi

    name=$(basename "$root")
    db=$(wt_db_name "$name")
    idx=$(wt_redis_index "$name")

    [ -f "$main/.env.local" ] || die "No .env.local in the main checkout ($main). Create it first."

    # .env.local must be a symlink so secrets live in exactly one place and cannot drift.
    if [ -L "$root/.env.local" ]; then
        :
    elif [ -f "$root/.env.local" ]; then
        if cmp -s "$root/.env.local" "$main/.env.local"; then
            :
        else
            backup="$root/.env.local.orphan-$(date +%Y%m%d%H%M%S)"
            mv "$root/.env.local" "$backup"
            printf 'NOTE: this worktree had a diverged .env.local. Kept it at %s\n' "$backup"
        fi
    fi
    [ -L "$root/.env.local" ] || ln -sf "$main/.env.local" "$root/.env.local"

    # Per-worktree overrides. Symfony loads .env.dev.local after .env.local, so these win.
    base_dsn=$(sed -n 's/^DATABASE_URL=//p' "$main/.env.local" | tail -1 | tr -d '"')
    base_redis=$(sed -n 's/^REDIS_URL=//p' "$main/.env.local" | tail -1 | tr -d '"')
    [ -n "$base_dsn" ] || die "No DATABASE_URL in $main/.env.local"
    [ -n "$base_redis" ] || base_redis="redis://localhost:6379/0"

    tmp="$root/.env.dev.local.tmp"
    {
        printf '# Generated by bin/worktree setup. Do not edit; re-run setup instead.\n'
        printf '# Secrets stay in .env.local, which is a symlink to the main checkout.\n'
        printf 'DATABASE_URL=%s\n' "$(wt_dsn_with_db "$base_dsn" "$db")"
        printf 'REDIS_URL=%s\n' "$(wt_redis_url_with_index "$base_redis" "$idx")"
    } > "$tmp"

    if [ -f "$root/.env.dev.local" ] && cmp -s "$tmp" "$root/.env.dev.local"; then
        rm "$tmp"
    else
        mv "$tmp" "$root/.env.dev.local"
        printf 'Wrote .env.dev.local (db=%s, redis=%s)\n' "$db" "$idx"
    fi

    # Shared containers, pinned project name, so this is safe from any worktree.
    docker compose --project-directory "$main" up -d >/dev/null 2>&1 || true

    # Tests set this to exercise env provisioning without a minute-long clone.
    [ "${WT_SKIP_DB_CLONE:-}" = 1 ] && return 0

    "$SELF_DIR/db" clone "$db"
}

case "${1:-}" in
    setup) shift; cmd_setup "$@" ;;
    *) die "usage: bin/worktree {setup}" ;;
esac
