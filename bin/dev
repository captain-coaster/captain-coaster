#!/usr/bin/env bash
# Local dev server: Symfony, plus Vite as a worker (.symfony.local.yaml), on
# fixed ports per checkout. The main checkout gets 8000/5173; a worktree keeps
# the slot it was first given (var/dev-slot): 8001/5174, 8002/5175, ...
#
#   bin/dev          start, or restart (picks up a new LAN IP)
#   bin/dev stop
#   bin/dev status
set -euo pipefail
cd "$(dirname "$0")/.."

slot_file=var/dev-slot
if [[ "$(git rev-parse --show-toplevel)" == "$(git worktree list --porcelain | awk 'NR==1{print $2}')" ]]; then
    slot=0
elif [[ -f $slot_file ]]; then
    slot=$(<"$slot_file")
else
    taken=$(git worktree list --porcelain | awk '/^worktree /{print $2"/var/dev-slot"}' | xargs cat 2>/dev/null || true)
    slot=1
    while grep -qx "$slot" <<<"$taken"; do slot=$((slot + 1)); done
    mkdir -p var
    echo "$slot" >"$slot_file"
fi

symfony_port=$((8000 + slot))
vite_port=$((5173 + slot))

lan_ip() {
    if command -v ipconfig >/dev/null; then
        ipconfig getifaddr "$(route -n get default 2>/dev/null | awk '/interface:/{print $2}')" 2>/dev/null || true
    else
        hostname -I 2>/dev/null | awk '{print $1}'
    fi
}

# Symfony CLI's own TLS certificate (symfony server:ca:install); Vite serves
# its assets with it too. Valid for localhost only: a phone accepts the
# browser warning once per port.
tls_cert() {
    local f
    for f in "$HOME/Library/Application Support/symfony-cli/certs/default.p12" "$HOME/.symfony5/certs/default.p12"; do
        [[ -f $f ]] && echo "$f" && return
    done
    return 0
}

port_owner() {
    local pid
    pid=$(lsof -nP -iTCP:"$1" -sTCP:LISTEN -t 2>/dev/null | head -1)
    [[ -n $pid ]] && lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | awk '/^n/{print substr($0, 2)}'
}

case "${1:-start}" in
start)
    symfony server:stop >/dev/null 2>&1 || true
    for port in "$symfony_port" "$vite_port"; do
        if owner=$(port_owner "$port"); then
            echo "Port $port is already used by a process in ${owner:-?}. Stop it first." >&2
            exit 1
        fi
    done

    ip=$(lan_ip)
    cert=$(tls_cert)
    scheme=$([[ -n $cert ]] && echo https || echo http)
    export SYMFONY_PORT=$symfony_port VITE_PORT=$vite_port VITE_TLS_P12=$cert
    export VITE_DEV_ORIGIN="$scheme://${ip:-localhost}:$vite_port"
    symfony server:start -d --port="$symfony_port" --allow-all-ip >/dev/null

    echo "Desktop: $scheme://localhost:$symfony_port"
    if [[ -n $ip ]]; then
        echo "Phone:   $scheme://$ip:$symfony_port (same Wi-Fi)"
        [[ $scheme == https ]] && echo "         first time: accept the certificate warning there and on $scheme://$ip:$vite_port"
    fi
    echo "Logs:    symfony server:log"
    ;;
stop)
    symfony server:stop
    ;;
status)
    symfony server:status
    ;;
*)
    echo "Usage: bin/dev [start|stop|status]" >&2
    exit 1
    ;;
esac
